    "reviews": [
      {
        "evaluation": 4.0,
        "frequencyCode": "1201",
        "useCode": "1001",
        "regTime": "2024-01-18T18:25:35.000+09:00",
        "objectCode": "1101",
        "nickName": "テディ丸さん",
        "review": "温かく柔らかいので着心地は良いです。後ろ前がなく、どちらで着ても問題ないデザインです。生地も伸びが有るので窮屈さもなく使い勝手がいいです。普段からLサイズ使用ですが、問題なく丁度いいです。裏起毛で温かいのに薄地なので重ね着も問題ありません。重宝しそうです。",
        "sex": 1,
        "isReadMore": false,
        "age": 62
      },
      {
        "evaluation": 4.0,
        "frequencyCode": "0",
        "useCode": "0",
        "regTime": "2024-01-08T11:00:43.000+09:00",
        "objectCode": "0",
        "nickName": "のえ1054さん",
        "review": "薄いかなと思いましたが、触り心地も良く、着るとわりと暖かいです。",
        "sex": 1,
        "isReadMore": false,
        "age": 53
      },
      {
        "evaluation": 4.0,
        "frequencyCode": "0",
        "useCode": "0",
        "regTime": "2024-01-04T10:45:52.000+09:00",
        "objectCode": "0",
        "nickName": "庶民1517さん",
        "review": "25日にホワイトを注文、27日に発送しましたとのメールをいただきましたが、1/4未着です。追跡番号無しメール便でお調べいただけるのでしょうか？→4日夜に確認するとポストインされていました。到着まで日数がかりますが、しっとり柔らかい生地です。黄色みのないホワイトで、楽しみに着てみたいと思います。",
        "sex": 0,
        "isReadMore": false,
        "age": 47
      }
    ]
  },
