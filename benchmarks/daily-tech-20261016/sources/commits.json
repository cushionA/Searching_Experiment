[{"sha":"36755d461be079737860a5f03ae0c803501269e9","node_id":"C_kwDOU1Zs-NoAKDM2NzU1ZDQ2MWJlMDc5NzM3ODYwYTVmMDNhZTBjODAzNTAxMjY5ZTk","commit":{"author":{"name":"Baptiste Aubertin","email":"bapt120@hotmail.fr","date":"2026-10-05T14:02:02Z"},"committer":{"name":"Baptiste Aubertin","email":"bapt120@hotmail.fr","date":"2026-10-08T15:58:47Z"},"message":"LightOnOCR: inference client, viewer and benchmark reproduction\n\nlightonocr/ is the client, CLI and viewer for the LightOnOCR models\n(versions 1, 2 and 3) served with vLLM. Grounding is a LightOnOCR-3 mode;\nthe client, CLI and viewer refuse it for LightOnOCR-1 and -2. The `vllm`\nextra pins vLLM 0.30.0 with transformers 5.16.1, which the 1B models need.\nlightonocr/postprocess/ repairs escaped math delimiters in every output,\nand holds PP3, the markdown post-processing used for olmOCR-bench.\n\nbenchmarks/ is ocr-bench, a separate uv project that reproduces the scores\non ParseBench, olmOCR-bench and fr-bench-pdf2md.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"896533ec95396d3ab4178355b7e63d1bbf8f8642","url":"https://api.github.com/repos/lightonai/LightOnOCR/git/trees/896533ec95396d3ab4178355b7e63d1bbf8f8642"},"url":"https://api.github.com/repos/lightonai/LightOnOCR/git/commits/36755d461be079737860a5f03ae0c803501269e9","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/lightonai/LightOnOCR/commits/36755d461be079737860a5f03ae0c803501269e9","html_url":"https://github.com/lightonai/LightOnOCR/commit/36755d461be079737860a5f03ae0c803501269e9","comments_url":"https://api.github.com/repos/lightonai/LightOnOCR/commits/36755d461be079737860a5f03ae0c803501269e9/comments","author":{"login":"baptiste-aubertin","id":47100525,"node_id":"MDQ6VXNlcjQ3MTAwNTI1","avatar_url":"https://avatars.githubusercontent.com/u/47100525?v=4","gravatar_id":"","url":"https://api.github.com/users/bapti