"received_events_url":"https://api.github.com/users/znsoftm/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"znsoftm","id":15354249,"node_id":"MDQ6VXNlcjE1MzU0MjQ5","avatar_url":"https://avatars.githubusercontent.com/u/15354249?v=4","gravatar_id":"","url":"https://api.github.com/users/znsoftm","html_url":"https://github.com/znsoftm","followers_url":"https://api.github.com/users/znsoftm/followers","following_url":"https://api.github.com/users/znsoftm/following{/other_user}","gists_url":"https://api.github.com/users/znsoftm/gists{/gist_id}","starred_url":"https://api.github.com/users/znsoftm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/znsoftm/subscriptions","organizations_url":"https://api.github.com/users/znsoftm/orgs","repos_url":"https://api.github.com/users/znsoftm/repos","events_url":"https://api.github.com/users/znsoftm/events{/privacy}","received_events_url":"https://api.github.com/users/znsoftm/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e4f03a2c6824d8b7b31d3f4a25583fbf76cc8e2f","url":"https://api.github.com/repos/RapidAI/RapidOCRLite/commits/e4f03a2c6824d8b7b31d3f4a25583fbf76cc8e2f","html_url":"https://github.com/RapidAI/RapidOCRLite/commit/e4f03a2c6824d8b7b31d3f4a25583fbf76cc8e2f"}],"stats":{"total":5,"additions":5,"deletions":0},"files":[{"sha":"f3ed409275790e2cc6516ddd5140131bbc27eecb","filename":"src/indra/imgproc_warp.inc","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/RapidAI/RapidOCRLite/blob/d720b197ddc30e9db343ac102e95fb6953f0438e/src%2Findra%2Fimgproc_warp.inc","raw_url":"https://github.com/RapidAI/RapidOCRLite/raw/d720b197ddc30e9db343ac102e95fb6953f0438e/src%2Findra%2Fimgproc_warp.inc","contents_url":"https://api.github.com/repos/RapidAI/RapidOCRLite/contents/src%2Findra%2Fimgproc_warp.inc?ref=d720b197ddc30e9db343ac102e95fb6953f0438e","patch":"@@ -1,5 +1,10 @@\n // warpAffine linear kernel (included by imgproc.cpp, and by imgproc_avx2.cpp for an AVX2+FMA build).\n // Requires -ffp-contract=off: all FMAs are explicit, so every build gives the same bits.\n+// A toolchain whose default -march already has AVX2+FMA (e.g. GCC 15 on Ubuntu 26.04) takes the\n+// SIMD path in imgproc.cpp too, so pull in the intrinsics here instead of relying on the includer.\n+#if defined(__AVX2__) && defined(__FMA__)\n+#include <immintrin.h>\n+#endif\n namespace IMG_NS {\n inline int rne_w(float v) { return (int)std::nearbyint(v); }\n inline uint8_t sat_u8f_w(float v) { int i = rne_w(v); return (uint8_t)(i < 0 ? 0 : i > 255 ? 255 : i); }"}]}
