{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sku_gate_a_output.schema.json",
  "title": "Method A output for one selected SKU",
  "type": "object",
  "required": [
    "schema_version",
    "task_version",
    "method",
    "source_config",
    "case_id",
    "dossier_id",
    "au_product_id",
    "decision",
    "top_row_key",
    "reason",
    "candidate_row_keys",
    "row_status_counts",
    "requirements",
    "rakuten_provenance",
    "au_provenance",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "sku-gate-a-output-v1"
    },
    "method": {
      "const": "A"
    },
    "decision": {
      "enum": [
        "matched",
        "unmatched",
        "review"
      ]
    },
    "top_row_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^au:\\d+:\\d+:\\d+:\\d+$"
    },
    "reason": {
      "enum": [
        "single_row_satisfies_all_requirements",
        "multiple_rows_satisfy_all_requirements",
        "every_au_row_has_explicit_conflict",
        "page_specification_conflict_on_candidate_row",
        "ambiguous_or_conflicting_sources",
        "unresolved_requirement"
      ]
    },
    "candidate_row_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "type",
          "value",
          "quote",
          "span",
          "scope",
          "axis_index",
          "axis_key",
          "axis_label",
          "axis_label_quote",
          "axis_value_quote",
          "decomposition",
          "axis_provenance"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^r\\d+\\.\\d+$"
          },
          "type": {
            "enum": [
              "dimension",
              "named_size",
              "piece_total",
              "component_count",
              "component_presence",
              "tier_count",
              "transparency",
              "fabric",
              "seat_width",
              "qualifier",
              "color",
              "variant"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "span": {
            "anyOf": [
              {
                "$ref": "#/$defs/span"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "const": "rakuten_selected_sku_row"
          },
          "decomposition": {
            "enum": [
              "complete",
              "partial"
            ]
          }
        }
      }
    },
    "rakuten_provenance": {
      "type": "object",
      "required": [
        "url",
        "raw_file",
        "sha256",
        "variant_id",
        "source_row_key",
        "source_sku_key",
        "sku_record_key",
        "source_row_index"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "au_provenance": {
      "type": "object",
      "required": [
        "product_id",
        "raw_file",
        "sha256",
        "row_count"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_key",
          "status",
          "supported",
          "requirements",
          "first_blocker"
        ],
        "properties": {
          "row_key": {
            "type": "string",
            "pattern": "^au:\\d+:\\d+:\\d+:\\d+$"
          },
          "status": {
            "enum": [
              "full",
              "conflict",
              "partial",
              "ambiguous",
              "derived_conflict"
            ]
          },
          "atom_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "status",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "support",
                    "conflict",
                    "unknown",
                    "ambiguous"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "source",
                      "relation"
                    ],
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "relation": {
                        "enum": [
                          "support",
                          "conflict",
                          "unknown"
                        ]
                      },
                      "quote": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "span": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/span"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "spans": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/span"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "scope": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "au_only_atoms": {
            "type": "array"
          },
          "derived_conflicts": {
            "type": "array"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "matched"
          }
        }
      },
      "then": {
        "properties": {
          "top_row_key": {
            "type": "string"
          },
          "candidate_row_keys": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "top_row_key": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "raw_file",
        "sha256",
        "locator",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "raw_file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "html_text",
                "json_leaf",
                "jsonl_leaf"
              ]
            },
            "encoding": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "json_path": {
              "type": "string",
              "pattern": "^\\$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "identical_copies": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
