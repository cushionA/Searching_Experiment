{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sku_gate_b_output.schema.json",
  "title": "Method B output for one selected SKU",
  "type": "object",
  "required": [
    "schema_version",
    "task_version",
    "method",
    "source_config",
    "case_id",
    "dossier_id",
    "au_product_id",
    "decision",
    "top_row_key",
    "reason",
    "candidate_row_keys",
    "row_status_counts",
    "requirements",
    "rakuten_provenance",
    "au_provenance",
    "rows",
    "binary"
  ],
  "properties": {
    "schema_version": {
      "const": "sku-gate-b-output-v1"
    },
    "method": {
      "const": "B"
    },
    "decision": {
      "enum": [
        "matched",
        "unmatched",
        "review"
      ]
    },
    "top_row_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^au:\\d+:\\d+:\\d+:\\d+$"
    },
    "reason": {
      "enum": [
        "all_cards_supported_on_one_row_and_other_rows_excluded",
        "partial_decomposition",
        "competing_row_not_excluded",
        "multiple_rows_satisfy_all_cards",
        "every_au_row_has_verified_contradiction",
        "page_specification_conflict_on_candidate_row",
        "ambiguous_or_conflicting_sources",
        "unresolved_requirement",
        "unquoted_requirement",
        "au_only_condition_not_corroborated"
      ]
    },
    "candidate_row_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "type",
          "value",
          "quote",
          "span",
          "scope",
          "axis_index",
          "axis_key",
          "axis_label",
          "axis_label_quote",
          "axis_value_quote",
          "decomposition",
          "axis_provenance"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^r\\d+\\.\\d+$"
          },
          "type": {
            "enum": [
              "dimension",
              "named_size",
              "piece_total",
              "unit_count",
              "measure",
              "component_count",
              "component_presence",
              "tier_count",
              "transparency",
              "fabric",
              "seat_width",
              "qualifier",
              "color",
              "variant"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "span": {
            "anyOf": [
              {
                "$ref": "#/$defs/span"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "const": "rakuten_selected_sku_row"
          },
          "decomposition": {
            "enum": [
              "complete",
              "partial"
            ]
          }
        }
      }
    },
    "rakuten_provenance": {
      "type": "object",
      "required": [
        "url",
        "raw_file",
        "sha256",
        "variant_id",
        "source_row_key",
        "source_sku_key",
        "sku_record_key",
        "source_row_index"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "au_provenance": {
      "type": "object",
      "required": [
        "product_id",
        "raw_file",
        "sha256",
        "row_count"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_key",
          "status",
          "supported",
          "requirements",
          "first_blocker"
        ],
        "properties": {
          "row_key": {
            "type": "string",
            "pattern": "^au:\\d+:\\d+:\\d+:\\d+$"
          },
          "status": {
            "enum": [
              "full",
              "conflict",
              "partial",
              "ambiguous",
              "derived_conflict",
              "au_only_unproven"
            ]
          },
          "atom_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "status",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "support",
                    "conflict",
                    "unknown",
                    "ambiguous"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "source",
                      "relation"
                    ],
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "relation": {
                        "enum": [
                          "support",
                          "conflict",
                          "unknown"
                        ]
                      },
                      "quote": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "span": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/span"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "spans": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "$ref": "#/$defs/span"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "scope": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "au_only_atoms": {
            "type": "array"
          },
          "derived_conflicts": {
            "type": "array"
          }
        }
      }
    },
    "binary": {
      "type": "object",
      "required": [
        "decision",
        "top_row_key",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "matched",
            "unmatched"
          ]
        },
        "top_row_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^au:\\d+:\\d+:\\d+:\\d+$"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "family",
              "au",
              "rakuten"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "matched"
              }
            }
          },
          "then": {
            "properties": {
              "top_row_key": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "top_row_key": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "matched"
          }
        }
      },
      "then": {
        "properties": {
          "top_row_key": {
            "type": "string"
          },
          "candidate_row_keys": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "top_row_key": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "matched",
              "unmatched"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "items": {
              "properties": {
                "span": {
                  "$ref": "#/$defs/span"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "raw_file",
        "sha256",
        "locator",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "raw_file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "html_text",
                "json_leaf",
                "jsonl_leaf"
              ]
            },
            "encoding": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "json_path": {
              "type": "string",
              "pattern": "^\\$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "identical_copies": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
