    "S17": {
      "kind": "description",
      "text": "収納しやすい三つ折りタイプ！",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S18": {
      "kind": "description",
      "text": "腰をやさしく支える高反発マットレスです。",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S19": {
      "kind": "description",
      "text": "厚みたっぷり10cmで、１枚でも底付き感のない寝心地。",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S20": {
      "kind": "description",
      "text": "高反発マットレスは下からの跳ね返りの力により、沈み込みが少ないのが特徴です。",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S21": {
      "kind": "description",
      "text": "その為、寝返りがうちやすく就寝時の身体の一部分（首・肩・腰・足）にかかる体圧も分散。",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S22": {
      "kind": "description",
      "text": "寝返りが多い方や仰向けに寝ることが多い方にオススメです。",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S23": {
      "kind": "description",
      "text": "三つ折りタイプは、押入れなどに収納しやすく、立て掛けておいても場所をとりません。",
      "scope": "fixed_product",
      "context_ids": [
        "C13"
      ]
    },
    "S24": {
      "kind": "description",
      "text": "カバーは1枚タイプの高反発マットレス同様に、取り外して洗濯することができます。",
