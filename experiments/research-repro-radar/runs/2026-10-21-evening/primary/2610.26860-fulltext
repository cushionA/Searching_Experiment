import numpy as np
<br class="ltx_break">
<span id="A6.p1404.pic1.1.1.1.1" class="ltx_text"></span>
<br class="ltx_break">
# Extract reference image index (image1) and target image index (image3)
<br class="ltx_break">
ref_idx = 0 # 'input_image_1'
<br class="ltx_break">
target_idx = 2 # 'input_image_3'
<br class="ltx_break">
<span id="A6.p1404.pic1.1.1.1.2" class="ltx_text"></span>
<br class="ltx_break">
# Get depth at pixel (x=1110, y=923) in image3 (note: depth is in meters)
<br class="ltx_break">
depth_at_pixel = depth_result["depth_meters"][923, 1110] # y, x indexing
<br class="ltx_break">
<span id="A6.p1404.pic1.1.1.1.3" class="ltx_text"></span>
<br class="ltx_break">
# Compute local median depth around the pixel for robustness (3x3 neighborhood)
<br class="ltx_break">
y_center, x_center = 923, 1110
<br class="ltx_break">
y_start, y_end = max(0, y_center - 1), min(depth_result["depth_shape"][0], y_center + 2)
<br class="ltx_break">
x_start, x_end = max(0, x_center - 1), min(depth_result["depth_shape"][1], x_center + 2)
<br class="ltx_break">
local_depth = depth_result["depth_meters"][y_start:y_end, x_start:x_end]
<br class="ltx_break">
median_depth = np.median(local_depth)
<br class="ltx_break">
<span id="A6.p1404.pic1.1.1.1.4" class="ltx_text"></span>
<br class="ltx_break">
# Use median depth for robustness
<br class="ltx_break">
depth = median_depth
<br class="ltx_break">
<span id="A6.p1404.pic1.1.1.1.5" class="ltx_text"></span>
<br class="ltx_break">
# Unproject pixel (x=1110, y=923) in image3 to 3D point in image3 camera coordinates
<br class="ltx_break">
# Using intrinsics and depth
<br class="ltx_break">
intrinsics = camera_trajectory_result["intrinsics"][target_idx] # 3x3
<br class="ltx_break">
