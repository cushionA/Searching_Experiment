<br class="ltx_break">
```python
<br class="ltx_break">
import numpy as np
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.1" class="ltx_text"></span>
<br class="ltx_break">
# Extract depth map and its dimensions
<br class="ltx_break">
depth_map = depth_result["depth_meters"]
<br class="ltx_break">
height, width = depth_result["depth_shape"]
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.2" class="ltx_text"></span>
<br class="ltx_break">
# Extract crosswalk bounding box
<br class="ltx_break">
crosswalk_box = segment_crosswalk["pred_boxes"][0]
<br class="ltx_break">
crosswalk_center_x = (crosswalk_box[0] + crosswalk_box[2]) / 2
<br class="ltx_break">
crosswalk_center_y = (crosswalk_box[1] + crosswalk_box[3]) / 2
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.3" class="ltx_text"></span>
<br class="ltx_break">
# Convert center coordinates to integer (pixel indices)
<br class="ltx_break">
crosswalk_center_x_int = int(crosswalk_center_x)
<br class="ltx_break">
crosswalk_center_y_int = int(crosswalk_center_y)
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.4" class="ltx_text"></span>
<br class="ltx_break">
# Get depth at crosswalk center
<br class="ltx_break">
crosswalk_depth = depth_map[crosswalk_center_y_int, crosswalk_center_x_int]
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.5" class="ltx_text"></span>
<br class="ltx_break">
# Extract car bounding boxes
<br class="ltx_break">
car_boxes = segment_cars["pred_boxes"]
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.6" class="ltx_text"></span>
<br class="ltx_break">
# Compute average depth at center of each car bounding box
<br class="ltx_break">
car_centers_depths = []
<br class="ltx_break">
for box in car_boxes:
<br class="ltx_break">
    center_x = (box[0] + box[2]) / 2
<br class="ltx_break">
    center_y = (box[1] + box[3]) / 2
<br class="ltx_break">
    center_x_int = int(center_x)
<br class="ltx_break">
    center_y_int = int(center_y)
<br class="ltx_break">
    car_depth = depth_map[center_y_int, center_x_int]
<br class="ltx_break">
    car_centers_depths.append(car_depth)
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.7" class="ltx_text"></span>
<br class="ltx_break">
# Compute average depth for all cars
<br class="ltx_break">
avg_car_depth = np.mean(car_centers_depths)
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.8" class="ltx_text"></span>
<br class="ltx_break">
# Compare: any car closer than crosswalk?
<br class="ltx_break">
cars_closer_than_crosswalk = any(car_depth &lt; crosswalk_depth for car_depth in car_centers_depths)
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.9" class="ltx_text"></span>
<br class="ltx_break">
# Output results
<br class="ltx_break">
print(f"Crosswalk center depth: {crosswalk_depth:.2f} meters")
<br class="ltx_break">
print(f"Average car center depth: {avg_car_depth:.2f} meters")
<br class="ltx_break">
print(f"Any car closer to camera than crosswalk? {'Yes' if cars_closer_than_crosswalk else 'No'}")
<br class="ltx_break">
<span id="A6.p874.pic1.1.1.1.10" class="ltx_text"></span>
<br class="ltx_break">
# Assign results to variables for result namespace
<br class="ltx_break">
crosswalk_center_depth = crosswalk_depth
<br class="ltx_break">
average_car_center_depth = avg_car_depth
<br class="ltx_break">
any_car_closer_than_crosswalk = cars_closer_than_crosswalk
<br class="ltx_break">
