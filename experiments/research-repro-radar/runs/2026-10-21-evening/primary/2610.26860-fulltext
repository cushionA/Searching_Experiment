<span id="A6.p55.pic1.1.1.1.1" class="ltx_text"></span>
<br class="ltx_break">
# Extract pred_boxes for original pills and round pills
<br class="ltx_break">
original_boxes = segment_pill["pred_boxes"]
<br class="ltx_break">
round_boxes = segment_round_pill["pred_boxes"]
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.2" class="ltx_text"></span>
<br class="ltx_break">
# Convert to numpy arrays for easier computation
<br class="ltx_break">
original_boxes = np.array(original_boxes)
<br class="ltx_break">
round_boxes = np.array(round_boxes)
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.3" class="ltx_text"></span>
<br class="ltx_break">
# Helper function to compute IoU
<br class="ltx_break">
def iou(box1, box2):
<br class="ltx_break">
    # box format: [x1, y1, x2, y2] (assuming top-left and bottom-right)
<br class="ltx_break">
    x1_1, y1_1, x2_1, y2_1 = box1
<br class="ltx_break">
    x1_2, y1_2, x2_2, y2_2 = box2
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.4" class="ltx_text"></span>
<br class="ltx_break">
    # Compute intersection
<br class="ltx_break">
    x_int = max(0, min(x2_1, x2_2) - max(x1_1, x1_2))
<br class="ltx_break">
    y_int = max(0, min(y2_1, y2_2) - max(y1_1, y1_2))
<br class="ltx_break">
    intersection = x_int * y_int
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.5" class="ltx_text"></span>
<br class="ltx_break">
    # Compute union
<br class="ltx_break">
    area1 = (x2_1 - x1_1) * (y2_1 - y1_1)
<br class="ltx_break">
    area2 = (x2_2 - x1_2) * (y2_2 - y1_2)
<br class="ltx_break">
    union = area1 + area2 - intersection
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.6" class="ltx_text"></span>
<br class="ltx_break">
    if union == 0:
<br class="ltx_break">
        return 0.0
<br class="ltx_break">
    return intersection / union
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.7" class="ltx_text"></span>
<br class="ltx_break">
# Helper function to compute center proximity (Euclidean distance between centers)
<br class="ltx_break">
def center_proximity(box1, box2):
<br class="ltx_break">
    x1_1, y1_1, x2_1, y2_1 = box1
<br class="ltx_break">
    x1_2, y1_2, x2_2, y2_2 = box2
<br class="ltx_break">
    center1_x, center1_y = (x1_1 + x2_1) / 2, (y1_1 + y2_1) / 2
<br class="ltx_break">
    center2_x, center2_y = (x1_2 + x2_2) / 2, (y1_2 + y2_2) / 2
<br class="ltx_break">
    return np.sqrt((center1_x - center2_x)**2 + (center1_y - center2_y)**2)
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.8" class="ltx_text"></span>
<br class="ltx_break">
# Threshold for matching: IoU &gt;= 0.45 OR center proximity &lt;= 10 pixels (arbitrary, but reasonable for visual matching)
<br class="ltx_break">
MATCH_THRESHOLD_IOU = 0.45
<br class="ltx_break">
MATCH_THRESHOLD_CENTER = 10.0
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.9" class="ltx_text"></span>
<br class="ltx_break">
# Initialize lists to track matches and unmatched detections
<br class="ltx_break">
matched_round_indices = set()
<br class="ltx_break">
matched_original_indices = set()
<br class="ltx_break">
unmatched_round_indices = []
<br class="ltx_break">
unmatched_original_indices = []
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.10" class="ltx_text"></span>
<br class="ltx_break">
# For each round pill detection, try to match with original pill detections
<br class="ltx_break">
for round_idx, round_box in enumerate(round_boxes):
<br class="ltx_break">
    matched = False
<br class="ltx_break">
    for orig_idx, orig_box in enumerate(original_boxes):
<br class="ltx_break">
        iou_val = iou(round_box, orig_box)
<br class="ltx_break">
        center_dist = center_proximity(round_box, orig_box)
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.11" class="ltx_text"></span>
<br class="ltx_break">
        if iou_val &gt;= MATCH_THRESHOLD_IOU or center_dist &lt;= MATCH_THRESHOLD_CENTER:
<br class="ltx_break">
            # Found a match
<br class="ltx_break">
            matched = True
<br class="ltx_break">
            matched_round_indices.add(round_idx)
<br class="ltx_break">
            matched_original_indices.add(orig_idx)
<br class="ltx_break">
            break
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.12" class="ltx_text"></span>
<br class="ltx_break">
    if not matched:
<br class="ltx_break">
        unmatched_round_indices.append(round_idx)
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.13" class="ltx_text"></span>
<br class="ltx_break">
# Find original detections that have major overlaps (duplicates) - i.e., matched with multiple round pills
<br class="ltx_break">
duplicate_original_indices = []
<br class="ltx_break">
for orig_idx in matched_original_indices:
<br class="ltx_break">
    count = 0
<br class="ltx_break">
    for round_idx in range(len(round_boxes)):
<br class="ltx_break">
        if round_idx not in matched_round_indices:
<br class="ltx_break">
            continue
<br class="ltx_break">
        iou_val = iou(original_boxes[orig_idx], round_boxes[round_idx])
<br class="ltx_break">
        center_dist = center_proximity(original_boxes[orig_idx], round_boxes[round_idx])
<br class="ltx_break">
        if iou_val &gt;= MATCH_THRESHOLD_IOU or center_dist &lt;= MATCH_THRESHOLD_CENTER:
<br class="ltx_break">
            count += 1
<br class="ltx_break">
    if count &gt; 1:
<br class="ltx_break">
        duplicate_original_indices.append(orig_idx)
<br class="ltx_break">
<span id="A6.p55.pic1.1.1.1.14" class="ltx_text"></span>
<br class="ltx_break">
# Output results
<br class="ltx_break">
print("Round detections missing from original:", unmatched_round_indices)
<br class="ltx_break">
print("Original detections with major overlaps (duplicates):", duplicate_original_indices)
<br class="ltx_break">
