cabinet_center_x = x1_cab + w_cab / 2
<br class="ltx_break">
cabinet_center_y = y1_cab + h_cab / 2
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.24" class="ltx_text"></span>
<br class="ltx_break">
# Clamp to image dimensions
<br class="ltx_break">
cabinet_center_x = np.clip(cabinet_center_x, 0, orig_w - 1)
<br class="ltx_break">
cabinet_center_y = np.clip(cabinet_center_y, 0, orig_h - 1)
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.25" class="ltx_text"></span>
<br class="ltx_break">
# Step 6: Get depth for cabinet center in input_image_3
<br class="ltx_break">
depth_map_3 = depth_result_3["depth_meters"]
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.26" class="ltx_text"></span>
<br class="ltx_break">
# Clamp to depth map dimensions
<br class="ltx_break">
cabinet_center_x_clamped = np.clip(cabinet_center_x, 0, depth_w - 1)
<br class="ltx_break">
cabinet_center_y_clamped = np.clip(cabinet_center_y, 0, depth_h - 1)
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.27" class="ltx_text"></span>
<br class="ltx_break">
# Get depth at cabinet center
<br class="ltx_break">
depth_cabinet = depth_map_3[int(cabinet_center_y_clamped), int(cabinet_center_x_clamped)]
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.28" class="ltx_text"></span>
<br class="ltx_break">
# Step 7: Convert 2D pixel + depth to 3D point in camera coordinate system (input_image_3)
<br class="ltx_break">
# Use intrinsic matrix K3
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.29" class="ltx_text"></span>
<br class="ltx_break">
fx3, fy3 = K3[0, 0], K3[1, 1]
<br class="ltx_break">
cx3, cy3 = K3[0, 2], K3[1, 2]
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.30" class="ltx_text"></span>
<br class="ltx_break">
# Unproject
<br class="ltx_break">
X_cam3 = (cabinet_center_x_clamped - cx3) * depth_cabinet / fx3
<br class="ltx_break">
Y_cam3 = (cabinet_center_y_clamped - cy3) * depth_cabinet / fy3
<br class="ltx_break">
Z_cam3 = depth_cabinet
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.31" class="ltx_text"></span>
<br class="ltx_break">
point_cabinet_cam3 = np.array([X_cam3, Y_cam3, Z_cam3])
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.1.32" class="ltx_text"></span>
<br class="ltx_break">
# Step 8: Convert both 3D points to world coordinates using extrinsics
<br class="ltx_break">
# Extrinsics are world-to-camera: E = [R | t], so to get world point from camera point:
<br class="ltx_break">
# P_world = R</span>ˆ<span id="A6.p1507.pic1.1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">T * (P_cam - t) [since E * P_world = P_cam, so P_world = E</span>ˆ<span id="A6.p1507.pic1.1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">{-1} * P_cam]
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.3.1" class="ltx_text"></span>
<br class="ltx_break">
# For input_image_1: E1 = [R1 | t1], so E1</span>ˆ<span id="A6.p1507.pic1.1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">{-1} = [R1</span>ˆ<span id="A6.p1507.pic1.1.1.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">T | -R1</span>ˆ<span id="A6.p1507.pic1.1.1.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">T * t1]
<br class="ltx_break">
R1 = E1[:, :3] # 3x3 rotation matrix
<br class="ltx_break">
t1 = E1[:, 3] # 3x1 translation vector
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.6.1" class="ltx_text"></span>
<br class="ltx_break">
# Invert E1: E1_inv = [R1</span>ˆ<span id="A6.p1507.pic1.1.1.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">T, -R1</span>ˆ<span id="A6.p1507.pic1.1.1.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">T * t1]
<br class="ltx_break">
R1_T = R1.T
<br class="ltx_break">
t1_inv = -R1_T @ t1
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.1" class="ltx_text"></span>
<br class="ltx_break">
# Convert point_window_cam1 to world coordinates
<br class="ltx_break">
point_window_world = R1_T @ (point_window_cam1 - t1)
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.2" class="ltx_text"></span>
<br class="ltx_break">
# For input_image_3: E3 = [R3 | t3]
<br class="ltx_break">
R3 = E3[:, :3]
<br class="ltx_break">
t3 = E3[:, 3]
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.3" class="ltx_text"></span>
<br class="ltx_break">
R3_T = R3.T
<br class="ltx_break">
t3_inv = -R3_T @ t3
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.4" class="ltx_text"></span>
<br class="ltx_break">
# Convert point_cabinet_cam3 to world coordinates
<br class="ltx_break">
point_cabinet_world = R3_T @ (point_cabinet_cam3 - t3)
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.5" class="ltx_text"></span>
<br class="ltx_break">
# Step 9: Compute Euclidean distance between the two 3D points in world coordinates
<br class="ltx_break">
distance = np.linalg.norm(point_window_world - point_cabinet_world)
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.6" class="ltx_text"></span>
<br class="ltx_break">
# Output results
<br class="ltx_break">
print(f"Window center 3D in world coordinates: {point_window_world}")
<br class="ltx_break">
print(f"Cabinet center 3D in world coordinates: {point_cabinet_world}")
<br class="ltx_break">
print(f"Euclidean distance between them: {distance:.4f} meters")
<br class="ltx_break">
<span id="A6.p1507.pic1.1.1.8.7" class="ltx_text"></span>
<br class="ltx_break">
# Assign to variables for result namespace
<br class="ltx_break">
window_3d_world = point_window_world
<br class="ltx_break">
cabinet_3d_world = point_cabinet_world
<br class="ltx_break">
distance_3d = distance
<br class="ltx_break">
```
