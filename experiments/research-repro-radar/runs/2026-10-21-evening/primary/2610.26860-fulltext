<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.1.12" class="ltx_text"></span>
<br class="ltx_break">
# Convert camera coordinates to world coordinates
<br class="ltx_break">
# Xw = R</span>ˆ<span id="A6.p1338.pic1.1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">T * (Xc - t)
<br class="ltx_break">
Xw1 = np.dot(R1.T, np.array([Xc1, Yc1, Zc1]) - t1)
<br class="ltx_break">
Xw1 = Xw1.flatten() # ensure 1D
<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.2.1" class="ltx_text"></span>
<br class="ltx_break">
# For third image (image index 2)
<br class="ltx_break">
K = intrinsics[2] # 3x3 intrinsic matrix
<br class="ltx_break">
R3, t3 = extrinsics[2][:3, :3], extrinsics[2][:3, 3] # rotation and translation (world to camera)
<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.2.2" class="ltx_text"></span>
<br class="ltx_break">
# Convert pixel to normalized image coordinates
<br class="ltx_break">
u3, v3 = x3, y3
<br class="ltx_break">
x_norm3 = (u3 - K[0, 2]) / K[0, 0]
<br class="ltx_break">
y_norm3 = (v3 - K[1, 2]) / K[1, 1]
<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.2.3" class="ltx_text"></span>
<br class="ltx_break">
# Convert normalized image coordinates to 3D camera coordinates
<br class="ltx_break">
Xc3 = depth_median_3 * x_norm3
<br class="ltx_break">
Yc3 = depth_median_3 * y_norm3
<br class="ltx_break">
Zc3 = depth_median_3
<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.2.4" class="ltx_text"></span>
<br class="ltx_break">
# Convert camera coordinates to world coordinates
<br class="ltx_break">
Xw3 = np.dot(R3.T, np.array([Xc3, Yc3, Zc3]) - t3)
<br class="ltx_break">
Xw3 = Xw3.flatten() # ensure 1D
<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.2.5" class="ltx_text"></span>
<br class="ltx_break">
# Print derived 3D world coordinates
<br class="ltx_break">
print(f"
<br class="ltx_break">
3D world coordinates (first image point): ({Xw1[0]:.4f}, {Xw1[1]:.4f}, {Xw1[2]:.4f})")
<br class="ltx_break">
print(f"3D world coordinates (third image point): ({Xw3[0]:.4f}, {Xw3[1]:.4f}, {Xw3[2]:.4f})")
<br class="ltx_break">
<span id="A6.p1338.pic1.1.1.2.6" class="ltx_text"></span>
<br class="ltx_break">
# Compute Euclidean distance between the two 3D points
<br class="ltx_break">
distance = np.linalg.norm(Xw1 - Xw3)
<br class="ltx_break">
print(f"
<br class="ltx_break">
Euclidean distance between the two points: {distance:.4f} meters")
<br class="ltx_break">
