<span id="A6.p46.pic1.1.1" class="ltx_p ltx_align_left"><span id="A6.p46.pic1.1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">Coding agent generated and executed the following Python code:
<br class="ltx_break">
```python
<br class="ltx_break">
import numpy as np
<br class="ltx_break">
from PIL import Image, ImageDraw
<br class="ltx_break">
import base64
<br class="ltx_break">
import io
<br class="ltx_break">
import json
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.1" class="ltx_text"></span>
<br class="ltx_break">
# Decode masks to numpy arrays for intersection computation
<br class="ltx_break">
def decode_mask(mask_str):
<br class="ltx_break">
    # Each mask is a base64-encoded string representing a segmentation mask
<br class="ltx_break">
    # We'll decode it to a numpy array of shape (H, W) with 0/1 values
<br class="ltx_break">
    # The format is assumed to be a run-length encoded or compressed binary mask
<br class="ltx_break">
    # For simplicity, we'll treat it as a base64-encoded PNG-like mask
<br class="ltx_break">
    try:
<br class="ltx_break">
        # Decode base64 string to bytes
<br class="ltx_break">
        mask_bytes = base64.b64decode(mask_str)
<br class="ltx_break">
        # Create a PIL Image from the bytes
<br class="ltx_break">
        img = Image.open(io.BytesIO(mask_bytes))
<br class="ltx_break">
        # Convert to numpy array
<br class="ltx_break">
        mask_array = np.array(img)
<br class="ltx_break">
        # Ensure binary mask (0 or 1)
<br class="ltx_break">
        mask_array = (mask_array &gt; 0).astype(np.uint8)
<br class="ltx_break">
        return mask_array
<br class="ltx_break">
    except Exception:
<br class="ltx_break">
        # If decoding fails, return None
<br class="ltx_break">
        return None
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.2" class="ltx_text"></span>
<br class="ltx_break">
# Compute IoU (Intersection over Union) between two masks
<br class="ltx_break">
def compute_iou(mask1, mask2):
<br class="ltx_break">
    if mask1 is None or mask2 is None:
<br class="ltx_break">
        return 0.0
<br class="ltx_break">
    # Ensure masks are binary and same shape
<br class="ltx_break">
    mask1 = (mask1 &gt; 0).astype(np.uint8)
<br class="ltx_break">
    mask2 = (mask2 &gt; 0).astype(np.uint8)
<br class="ltx_break">
    # Compute intersection and union
<br class="ltx_break">
    intersection = np.logical_and(mask1, mask2).sum()
<br class="ltx_break">
    union = np.logical_or(mask1, mask2).sum()
<br class="ltx_break">
    if union == 0:
<br class="ltx_break">
        return 0.0
<br class="ltx_break">
    return intersection / union
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.3" class="ltx_text"></span>
<br class="ltx_break">
# Compute IoU between two bounding boxes
<br class="ltx_break">
def compute_bbox_iou(box1, box2):
<br class="ltx_break">
    # box format: [x1, y1, x2, y2] (top-left, bottom-right)
<br class="ltx_break">
    x1_1, y1_1, x2_1, y2_1 = box1
<br class="ltx_break">
    x1_2, y1_2, x2_2, y2_2 = box2
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.4" class="ltx_text"></span>
<br class="ltx_break">
    # Compute intersection
<br class="ltx_break">
    x_left = max(x1_1, x1_2)
<br class="ltx_break">
    y_top = max(y1_1, y1_2)
<br class="ltx_break">
    x_right = min(x2_1, x2_2)
<br class="ltx_break">
    y_bottom = min(y2_1, y2_2)
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.5" class="ltx_text"></span>
<br class="ltx_break">
    if x_right &lt;= x_left or y_bottom &lt;= y_top:
<br class="ltx_break">
        return 0.0
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.6" class="ltx_text"></span>
<br class="ltx_break">
    intersection_area = (x_right - x_left) * (y_bottom - y_top)
<br class="ltx_break">
    # Compute union
<br class="ltx_break">
    area1 = (x2_1 - x1_1) * (y2_1 - y1_1)
<br class="ltx_break">
    area2 = (x2_2 - x1_2) * (y2_2 - y1_2)
<br class="ltx_break">
    union_area = area1 + area2 - intersection_area
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.7" class="ltx_text"></span>
<br class="ltx_break">
    return intersection_area / union_area if union_area &gt; 0 else 0.0
<br class="ltx_break">
<span id="A6.p46.pic1.1.1.1.8" class="ltx_text"></span>
<br class="ltx_break">
# Get mask dimensions from original image
