R_ref = extrinsics_ref[:, :3] # 3x3 rotation matrix
<br class="ltx_break">
t_ref = extrinsics_ref[:, 3] # 3x1 translation vector
<br class="ltx_break">
<span id="A6.p1404.pic1.1.1.2.4" class="ltx_text"></span>
