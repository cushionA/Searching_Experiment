[{"url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/3","repository_url":"https://api.github.com/repos/MemTensor/MemT-1.0","labels_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/3/comments","events_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/3/events","html_url":"https://github.com/MemTensor/MemT-1.0/issues/3","id":5940392032,"node_id":"I_kwDOVPC95c8AAAABYhMwYA","number":3,"title":"Verify evals on Papers with Code","user":{"login":"NielsRogge","id":48327001,"node_id":"MDQ6VXNlcjQ4MzI3MDAx","avatar_url":"https://avatars.githubusercontent.com/u/48327001?v=4","gravatar_id":"","url":"https://api.github.com/users/NielsRogge","html_url":"https://github.com/NielsRogge","followers_url":"https://api.github.com/users/NielsRogge/followers","following_url":"https://api.github.com/users/NielsRogge/following{/other_user}","gists_url":"https://api.github.com/users/NielsRogge/gists{/gist_id}","starred_url":"https://api.github.com/users/NielsRogge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NielsRogge/subscriptions","organizations_url":"https://api.github.com/users/NielsRogge/orgs","repos_url":"https://api.github.com/users/NielsRogge/repos","events_url":"https://api.github.com/users/NielsRogge/events{/privacy}","received_events_url":"https://api.github.com/users/NielsRogge/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-20T10:53:17Z","updated_at":"2026-10-20T10:53:17Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi,\n\nNiels here from the open-source team at Hugging Face. Congratulations on your work!\n\nI've made the [paper](https://paperswithcode.co/paper/2610.26825) and [2 paper-native evaluations](https://paperswithcode.co/paper/2610.26825#results) available on Papers with Code.\n\nThe paper is part of the [Coding Agents](https://paperswithcode.co/tasks/coding-agents) task page.\n\nWould it be possible to verify these results and let me know if any score, model name, benchmark protocol, or openness metadata should be corrected?\n\nYou can also edit the task, methods, project page, and GitHub URL directly from the paper page using your Hugging Face account.\n\nKind regards,\n\nNiels","closed_by":null,"reactions":{"url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/3/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/2","repository_url":"https://api.github.com/repos/MemTensor/MemT-1.0","labels_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/2/comments","events_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/2/events","html_url":"https://github.com/MemTensor/MemT-1.0/issues/2","id":5939622682,"node_id":"I_kwDOVPC95c8AAAABYgdzGg","number":2,"title":"Evaluating MemT-1.0 on GACC-Bench for goal-adaptive memory retention","user":{"login":"weiting24","id":239311668,"node_id":"U_kgDODkObNA","avatar_url":"https://avatars.githubusercontent.com/u/239311668?v=4","gravatar_id":"","url":"https://api.github.com/users/weiting24","html_url":"https://github.com/weiting24","followers_url":"https://api.github.com/users/weiting24/followers","following_url":"https://api.github.com/users/weiting24/following{/other_user}","gists_url":"https://api.github.com/users/weiting24/gists{/gist_id}","starred_url":"https://api.github.com/users/weiting24/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/weiting24/subscriptions","organizations_url":"https://api.github.com/users/weiting24/orgs","repos_url":"https://api.github.com/users/weiting24/repos","events_url":"https://api.github.com/users/weiting24/events{/privacy}","received_events_url":"https://api.github.com/users/weiting24/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-20T09:52:05Z","updated_at":"2026-10-20T09:52:05Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hi MemTensor team,\n\nThanks for open-sourcing MemT-1.0! I’m one of the authors of [GACC-Bench](https://github.com/weiting24/GACC-Bench), and I’d like to suggest it as a complementary evaluation for MemT’s native memory capabilities. GACC-Bench asks: when the goal is known but future questions are not, can a model retain the information needed to answer them? It contains 500 goals and 2,571 questions across documents, code, and agent interaction traces, with expert review. A smaller testmini subset with 124 goals and 651 questions is also available.\n\nFor MemT, a possible setup would be to build memory from each context and its goal before revealing the evaluation questions, then answer each question independently from the same saved memory state, without access to the original context. Your [memory save/restore functionality](https://github.com/MemTensor/MemT-1.0/blob/main/inference/README.md#save-and-restore) looks useful for implementing this setup. Since GACC-Bench currently evaluates textual compression with a fixed reader, this would require a native-memory adaptation. The memory configuration and results should be reported separately from the existing text-token-budget comparisons.\n\nWould your team be interested in trying this evaluation, or sharing suggestions for an appropriate setup?\n- [Code and evaluation instructions](https://github.com/weiting24/GACC-Bench)\n- [Dataset](https://huggingface.co/datasets/Regimes/GACC-Bench)\n- [Paper](https://arxiv.org/abs/2610.21893)\n\nThanks for your consideration!","closed_by":null,"reactions":{"url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/2/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/1","repository_url":"https://api.github.com/repos/MemTensor/MemT-1.0","labels_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/1/comments","events_url":"https://api.github.com/repos/MemTensor/MemT-1.0/issues/1/events","html_url":"https://github.com/MemTensor/MemT-1.0/pull/1","id":5938657459,"node_id":"PR_kwDOVPC95c8AAAABJgtP0w","number":1,"title":"chore: add repository code owners","user":{"login":"yanggthomas","id":45824879,"node_id":"MDQ6VXNlcjQ1ODI0ODc5","avatar_url":"https://avatars.githubusercontent.com/u/45824879?v=4","gravatar_id":"","url":"https://api.github.com/users/yanggthomas","html_url":"https://github.com/yanggthomas","followers_url":"https://api.github.com/users/yanggthomas/followers","following_url":"https://api.github.com/users/yanggthomas/following{/other_user}","gists_url":"https://api.github.com/users/yanggthomas/gists{/gist_id}","starred_url":"https://api.github.com/users/yanggthomas/starred{/own