":"Zhao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3487-5289","authenticated-orcid":false,"given":"Runhua","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.neucom.2026.135039","published":{"date-parts":[[2027,1]]},"created":{"date-parts":[[2026,9,7]],"date-time":"2026-09-07T23:25:49Z","timestamp":1788823549000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0925231226024379?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0925231226024379?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.1109\/isaes70982.2026.11669833","title":["A Three-Tier Large-Small Language Model Collaborative Architecture for Dynamic Task Allocation in Manned-Unmanned Teaming Operations"],"author":[{"given":"Wendi","family":"Qi","sequence":"first","affiliation":[{"name":"Air Force Engineering University","place":["Xi\u2019an, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tiecheng","family":"Xie","sequence":"additional","affiliation":[{"name":"Air Force Engineering University","place":["Xi\u2019an, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/isaes70982.2026.11669833","published":{"date-parts":[[2026,7]]},"created":{"date-parts":[[2026,9,1]],"date-time":"2026-09-01T19:13:47Z","timestamp":1788290027000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11669070\/11669076\/11669833.pdf?arnumber=11669833","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.37702\/2175-957x.cobenge.2026.0525","title":["ROB\u00d4 CONVERSACIONAL COM SMALL LANGUAGE MODEL LOCAL: UMA PROPOSTA DE FERRAMENTA PEDAG\u00d3GICA ACESS\u00cdVEL PARA O ENSINO DE INTELIG\u00caNCIA ARTIFICIAL EM ENGENHARIA"],"author":[{"given":"VITOR AMADEU","family":"SOUZA","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.37702\/2175-957x.cobenge.2026.0525","published":{"date-parts":[[2026,10,4]]},"created":{"date-parts":[[2026,10,13]],"date-time":"2026-10-13T08:59:53Z","timestamp":1791881993000},"link":[{"URL":"https:\/\/abenge.org.br\/publicacao\/2026\/?id=525","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"}]},{"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>\n                    This article is concerned with the interpretation of hyperbolic statements. In the first part, we contend that Kao et al. (Proc Natl Acad Sci 111:12002\u201312007, 2014)\u2014to our knowledge, the first (and only) attempt to derive hyperbolic interpretations using formal methods\u2014is unsuccessful. In the second part, we put forth a conjecture\u2014roughly, a sentence\n                    <jats:italic>S<\/jats:italic>\n                    can be interpreted hyperbolically as meaning\n                    <jats:italic>S<\/jats:italic>\n                    <jats:sup>\u2212<\/jats:sup>\n                    , where\n                    <jats:italic>S<\/jats:italic>\n                    <jats:sup>\u2212<\/jats:sup>\n                    is weaker than\n                    <jats:italic>S<\/jats:italic>\n                    , only if\n                    <jats:italic>S<\/jats:italic>\n                    <jats:sup>\u2212<\/jats:sup>\n                    is a scalar alternative of\n                    <jats:italic>S<\/jats:italic>\n                    . We substantiate this conjecture by a series of novel empirical observations.\n                  <\/jats:p>","DOI":"10.1007\/s10849-026-09469-9","created":{"date-parts":[[2026,9,7]],"date-time":"2026-09-07T06:56:43Z","timestamp":1788764203000},"title":["Is Hyperbole a Scalar Inference?"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-5492-7114","authenticated-orcid":false,"given":"Diego","family":"Feinmann","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s10849-026-09469-9.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/article\/10.1007\/s10849-026-09469-9","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s10849-026-09469-9.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1007\/s10849-026-09469-9","published":{"date-parts":[[2026,9,7]]}}],"items-per-page":100,"query":{"start-index":0,"search-terms":null}}}