ht:0.66em;--ltx-fo-depth:0em;font-size:5pt;" height="4.54" overflow="visible" transform="matrix(1 0 0 -1 0 4.54)" width="8.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F2.pic1.50" class="ltx_text ltx_font_sansserif" style="font-size:50%;--ltx-fg-color:#1F2937;">0.0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#9AA7B8;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#9AA7B8" stroke-width="0.45pt"><path d="M 573.91 23.23 L 549.71 23.23 C 548.57 23.23 547.64 22.3 547.64 21.15 L 547.64 11.92 C 547.64 10.77 548.57 9.84 549.71 9.84 L 573.91 9.84 C 575.06 9.84 575.98 10.77 575.98 11.92 L 575.98 21.15 C 575.98 22.3 575.06 23.23 573.91 23.23 Z M 547.64 9.84"></path></g><g style="--ltx-stroke-color:#1F2937;--ltx-fill-color:#1F2937;" fill="#1F2937" stroke="#1F2937" stroke-width="0.45pt" transform="matrix(1.0 0.0 0.0 1.0 557.39 13.26)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:5pt;" height="4.54" overflow="visible" transform="matrix(1 0 0 -1 0 4.54)" width="8.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F2.pic1.51" class="ltx_text ltx_font_sansserif" style="font-size:50%;--ltx-fg-color:#1F2937;">0.0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#9AA7B8;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#9AA7B8" stroke-width="0.45pt"><path d="M 604.62 23.23 L 580.42 23.23 C 579.28 23.23 578.35 22.3 578.35 21.15 L 578.35 11.92 C 578.35 10.77 579.28 9.84 580.42 9.84 L 604.62 9.84 C 605.76 9.84 606.69 10.77 606.69 11.92 L 606.69 21.15 C 606.69 22.3 605.76 23.23 604.62 23.23 Z M 578.35 9.84"></path></g><g style="--ltx-stroke-color:#1F2937;--ltx-fill-color:#1F2937;" fill="#1F2937" stroke="#1F2937" stroke-width="0.45pt" transform="matrix(1.0 0.0 0.0 1.0 588.1 13.26)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:5pt;" height="4.54" overflow="visible" transform="matrix(1 0 0 -1 0 4.54)" width="8.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F2.pic1.52" class="ltx_text ltx_font_sansserif" style="font-size:50%;--ltx-fg-color:#1F2937;">0.0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#9AA7B8;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#9AA7B8" stroke-width="0.45pt"><path d="M 635.33 23.23 L 611.13 23.23 C 609.98 23.23 609.06 22.3 609.06 21.15 L 609.06 11.92 C 609.06 10.77 609.98 9.84 611.13 9.84 L 635.33 9.84 C 636.47 9.84 637.4 10.77 637.4 11.92 L 637.4 21.15 C 637.4 22.3 636.47 23.23 635.33 23.23 Z M 609.06 9.84"></path></g><g style="--ltx-stroke-color:#1F2937;--ltx-fill-color:#1F2937;" fill="#1F2937" stroke="#1F2937" stroke-width="0.45pt" transform="matrix(1.0 0.0 0.0 1.0 618.81 13.26)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:5pt;" height="4.54" overflow="visible" transform="matrix(1 0 0 -1 0 4.54)" width="8.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F2.pic1.53" class="ltx_text ltx_font_sansserif" style="font-size:50%;--ltx-fg-color:#1F2937;">0.0</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S1.F2.5" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S1.F2.6" class="ltx_text ltx_font_bold" style="font-size:90%;">Comparing text generation paradigms.<span id="S1.F2.6.1" class="ltx_text ltx_font_medium"> Next-token prediction
generates one token per step, and masked diffusion (discrete diffusion) refines all <math id="S1.F2.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> positions
at every step. </span>NCM<span id="S1.F2.6.2" class="ltx_text ltx_font_medium"> instead generates discrete codes <math id="S1.F2.m9" class="ltx_Math" alttext="r_{k}^{i}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mi>k</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">r_{k}^{i}</annotation></semantics></math>, the <math id="S1.F2.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th code of level <math id="S1.F2.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,
from coarse to fine in <math id="S1.F2.m12" class="ltx_Math" alttext="K\ll L" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≪</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">K\ll L</annotation></semantics></math> steps: each step predicts the <math id="S1.F2.m13" class="ltx_Math" alttext="\ell_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\ell_{k}</annotation></semantics></math> codes
of one level in parallel, conditioned on the reconstruction <math id="S1.F2.m14" class="ltx_Math" alttext="\hat{z}^{(k-1)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>z</mi><mo mathsize="1.110em">^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{z}^{(k-1)}</annotation></semantics></math>
of the earlier levels, and after the final level, the cumulative reconstruction is decoded into tokens.</span></span></figcaption>
</figure>
<div id="S1.p2" class="ltx_para ltx_noindent">
<p id="S1.p2.1" class="ltx_p">The promise of DLMs is parallel sampling: generating a sequence in far
fewer sequential steps than it has tokens. In practice however:</p>
<ul id="S1.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="S1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S1.I1.i1.p1.1" class="ltx_p"><span id="S1.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">(i) Many sampling steps.</span> Diffusion models predict tokens in parallel
but still perform successive denoising passes. Reducing these passes can substantially
degrade generation quality (Figure <a href="#S4.F5" title="Figure 5 ‣ 4.2 Unconditional Generation ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), limiting the speed gains from parallelism.</p>
</div></li>
<li id="S1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S1.I1.i2.p1.1" class="ltx_p"><span id="S1.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">(ii) Expensive sampling steps.</span> Processing the full sequence at every
step limits speedups, and bidirectional attention prevents direct reuse of AR-style
KV caching <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib37" title="" class="ltx_ref">10</a>, <a href="#bib.bib39" title="" class="ltx_ref">11</a>]</cite>.</p>
</div></li>
<li id="S1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I1.i3.p1" class="ltx_para">
<p id="S1.I1.i3.p1.1" class="ltx_p"><span id="S1.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">(iii) Large training budgets.</span> DLM training often involves many passes
over the same data. For example, strong diffusion baselines such as
DUO and MDLM are trained on OpenWebText for <math id="S1.I1.i3.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>M steps, processing over <math id="S1.I1.i3.p1.m2" class="ltx_Math" alttext="500" display="inline" intent=":literal"><semantics><mn>500</mn><annotation encoding="application/x-tex">500</annotation></semantics></math>B
tokens <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib24" title="" class="ltx_ref">12</a>, <a href="#bib.bib11" title="" class="ltx_ref">3</a>, <a href="#bib.bib1" title="" class="ltx_ref">13</a>]</cite>.</p>
</div></li>
</ul>
</div>
<div id="S1.p3" class="ltx_para ltx_noindent">
<p id="S1.p3.1" class="ltx_p">Prior work reduces the number of sampling steps mainly through few-step samplers and
distillation, either by distilling a many-step teacher into a few-step student
<cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib24" title="" class="ltx_ref">12</a>, <a href="#bib.bib41" title="" class="ltx_ref">14</a>]</cite> or by learning a direct map between noise
levels <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib31" title="" class="ltx_ref">15</a>]</cite>.
These approaches come at the cost of additional training stages on top of an already
expensive model. Few-step sampling also comes at a price: distilled models tend to be less diverse
than the models they are distilled from. On standard benchmarks such as OpenWebText
<cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib23" title="" class="ltx_ref">16</a>]</cite> and LM1B <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib34" title="" class="ltx_ref">17</a>]</cite>, they reach a lower
generative perplexity at the expense of sample diversity, as measured by mean
per-sample unigram entropy <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib31" title="" class="ltx_ref">15</a>]</cite>. Moreover, these approaches leave the per-step cost unchanged.
Block-autoregressive diffusion enables KV caching at the cost of parallelism:
tokens within each block can be denoised in parallel, but blocks must be generated
sequentially, with each waiting for the previous block to finish
<cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib19" title="" class="ltx_ref">18</a>, <a href="#bib.bib38" title="" class="ltx_ref">19</a>]</cite>.</p>
</div>
<div id="S1.p4" class="ltx_para ltx_noindent">
<p id="S1.p4.1" class="ltx_p">We introduce <span id="S1.p4.1.1" class="ltx_text ltx_font_bold">Next-Concept Modeling (NCM)</span>, a two-stage language modeling
framework. A multiscale residual VQ-VAE <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib14" title="" class="ltx_ref">20</a>]</cite> encodes text into
<math id="S1.p4.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> levels of discrete codes, from short coarse representations to longer fine ones.
A transformer generates these levels sequentially, predicting all codes within each
level in parallel, following next-scale prediction for images
<cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib7" title="" class="ltx_ref">21</a>, <a href="#bib.bib9" title="" class="ltx_ref">22</a>]</cite>. <span id="S1.p4.1.2" class="ltx_text ltx_font_bold">NCM</span> achieves <span id="S1.p4.1.3" class="ltx_text ltx_font_bold">(i)</span> high generation
quality and diversity in <math id="S1.p4.m2" class="ltx_Math" alttext="K\ll L" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≪</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">K\ll L</annotation></semantics></math> steps without distillation (Figure <a href="#S4.F5" title="Figure 5 ‣ 4.2 Unconditional Generation ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>);
<span id="S1.p4.1.4" class="ltx_text ltx_font_bold">(ii)</span> lower sampling cost by processing short code sequences at early levels
(Figure <a href="#S0.F1" title="Figure 1 ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>);
and <span id="S1.p4.1.5" class="ltx_text ltx_font_bold">(iii)</span> strong performance with fewer training passes over the data
(Figure <a href="#S4.F7" title="Figure 7 ‣ Inference Efficiency. ‣ 4.6 Efficiency ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>).</p>
</div>
<div id="S1.p5" class="ltx_para ltx_noindent">
<p id="S1.p5.1" class="ltx_p">We evaluate <span id="S1.p5.1.1" class="ltx_text ltx_font_bold">NCM</span> models at approximately <math id="S1.p5.m1" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math>M parameters against discrete-diffusion,
flow-based, and hybrid baselines, following standard evaluation protocols
<cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib11" title="" class="ltx_ref">3</a>, <a href="#bib.bib24" title="" class="ltx_ref">12</a>]</cite>. Across unconditional generation, conditional
generation (translation and summarization), and reasoning tasks (Sudoku), we find:</p>
<ul id="S1.I2" class="ltx_itemize">
<li id="S1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S1.I2.i1.p1.1" class="ltx_p"><span id="S1.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">(i) High quality in few steps.</span> Across three unconditional generation
datasets (TinyStories, LM1B, and OpenWebText), <span id="S1.I2.i1.p1.1.2" class="ltx_text ltx_font_bold">NCM</span> matches or outperforms strong
diffusion baselines with approximately <math id="S1.I2.i1.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>–<math id="S1.I2.i1.p1.m2" class="ltx_math_unparsed" alttext="11\times" display="inline" intent=":literal"><semantics><mrow><mn>11</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">11\times</annotation></semantics></math> fewer function evaluations
(NFE), while maintaining sample entropy close to the data (Figure <a href="#S4.F5" title="Figure 5 ‣ 4.2 Unconditional Generation ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>).
On conditional generation (XSum summarization and WMT14 translation), it uses
approximately <math id="S1.I2.i1.p1.m3" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>–<math id="S1.I2.i1.p1.m4" class="ltx_math_unparsed" alttext="16\times" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">16\times</annotation></semantics></math> fewer NFE than unguided baselines, achieving the best
summarization scores and outperforming all but one non-AR translation baseline
(Table <a href="#S4.T2" title="Table 2 ‣ 4.3 Conditional Generation ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). On Sudoku, <span id="S1.I2.i1.p1.1.3" class="ltx_text ltx_font_bold">NCM</span> outperforms AR and diffusion baselines across
difficulty levels while using fewer NFE than any of them (Table <a href="#S4.T3" title="Table 3 ‣ 4.4 Reasoning ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>).</p>
</div></li>
<li id="S1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S1.I2.i2.p1.1" class="ltx_p"><span id="S1.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">(ii) Fast inference and effective test-time scaling.</span> Fewer sampling
steps and lower per-step cost from shorter coarse levels yield <math id="S1.I2.i2.p1.m1" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math>–<math id="S1.I2.i2.p1.m2" class="ltx_math_unparsed" alttext="31\times" display="inline" intent=":literal"><semantics><mrow><mn>31</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">31\times</annotation></semantics></math>
faster generation at comparable or better quality (Figures <a href="#S0.F1" title="Figure 1 ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>
and <a href="#S4.F5" title="Figure 5 ‣ 4.2 Unconditional Generation ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>). Using the saved time to generate more candidates and select
among them with MBR decoding yields about <math id="S1.I2.i2.p1.m3" class="ltx_Math" alttext="7\%" display="inline" intent=":literal"><semantics><mrow><mn>7</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">7\%</annotation></semantics></math> higher ROUGE-L than the strongest
summarization baseline within the same sampling-time budget
(Figure <a href="#S4.F6" title="Figure 6 ‣ Test-Time Scaling. ‣ 4.5 Scaling ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>).</p>
</div></li>
<li id="S1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i3.p1" class="ltx_para">
<p id="S1.I2.i3.p1.1" class="ltx_p"><span id="S1.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">(iii) Lower training budgets.</span> <span id="S1.I2.i3.p1.1.2" class="ltx_text ltx_font_bold">NCM</span> achieves competitive generation
quality with approximately <math id="S1.I2.i3.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>–<math id="S1.I2.i3.p1.m2" class="ltx_math_unparsed" alttext="5\times" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">5\times</annotation></semantics></math> fewer training tokens than strong diffusion
baselines on LM1B and OpenWebText, including both tokenizer and generator training
(Figure <a href="#S4.F7" title="Figure 7 ‣ Inference Efficiency. ‣ 4.6 Efficiency ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>; Appendix <a href="#A3" title="Appendix C Architecture Details ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>).</p>
</div></li>
</ul>
<p id="S1.p5.2" class="ltx_p">We also show preliminary scaling results: increasing <span id="S1.p5.2.1" class="ltx_text ltx_font_bold">NCM</span>’s model size improves
generation quality on LM1B at a fixed training-token budget
(Figure <a href="#S4.F6.sf1" title="Figure 6(a) ‣ Figure 6 ‣ Test-Time Scaling. ‣ 4.5 Scaling ‣ 4 Experiments ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6(a)</span></a>).
Qualitative probes suggest that coarse levels capture global structure while finer
levels add detail
(Appendix <a href="#A8" title="Appendix H Probing the Hierarchy ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span></a>, Figures <a href="#A8.F17" title="Figure 17 ‣ Appendix H Probing the Hierarchy ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>–<a href="#A8.F19" title="Figure 19 ‣ Appendix H Probing the Hierarchy ‣ N C M Next-Concept Modeling: Fast, Parallel Coarse-to-Fine Text Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>).</p>
</div>
