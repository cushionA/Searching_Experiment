<td id="S4.T1.2.1.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Size</span></td>
<td id="S4.T1.2.1.1.3" class="ltx_td ltx_align_left ltx_border_tt"><span id="S4.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Type</span></td></tr>
