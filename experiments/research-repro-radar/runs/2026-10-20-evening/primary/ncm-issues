CPU only system. \n\nBelow is a Claude code written patch to `evaluate.py` that allows you to test this tool out on a CPU only system without CUDA. Was able to get it to run fine and did the Sudoku tests in a basic firecracker (microvm). \n\nThanks for sharing the tool and the research you are doing!\n\n```patch\n\ndiff --git a/evaluate.py b/evaluate.py\nindex fb7ae1c..91055c2 100644\n--- a/evaluate.py\n+++ b/evaluate.py\n@@ -19,7 +19,7 @@ def main():\n     cfg = OmegaConf.load(args.config)\n     gpus = args.gpus.split(\",\") if args.gpus else [str(i) for i in range(torch.cuda.device_count())]\n     if not gpus:\n-        sys.exit(\"no GPU visible; pass --gpus\")\n+        gpus = [\"\"]  # no GPU: one CPU shard using every core\n     out = args.out or os.path.join(\"eval\", cfg.task)\n     os.makedirs(out, exist_ok=True)\n\n@@ -33,7 +33,8 @@ def main():\n             [sys.executable, os.path.join(ROOT, \"scripts\", \"eval_shard.py\"), *common,\n              \"--shard\", str(k), \"--out\", os.path.join(out, f\"shard_{k}.pkl\")],\n             env=env, stdout=log, stderr=subprocess.STDOUT, cwd=ROOT))\n-    print(f\"[evaluate] {len(gpus)} shard(s) on GPU(s) {','.join(gpus)} -> {out}/\", flush=True)\n+    where = f\"GPU(s) {','.join(gpus)}\" if gpus != [\"\"] else \"CPU\"\n+    print(f\"[evaluate] {len(gpus)} shard(s) on {where} -> {out}/\", flush=True)\n     failed = [k for k, p in enumerate(procs) if p.wait() != 0]\n     if failed:\n         sys.exit(f\"shard(s) {failed} failed; see {out}/shard_*.log\")\ndiff --git a/scripts/eval_merge.py b/scripts/eval_merge.py\nindex ddee0bc..b922910 100644\n--- a/scripts/eval_merge.py\n+++ b/scripts/eval_merge.py\n@@ -3,6 +3,11 @@ import numpy as np\n from omegaconf import OmegaConf\n sys.path.insert(0, os.environ.get(\"NCM_ROOT\", os.getcwd()))\n\n+\n+def dev():\n+    import torch\n+    return \"cuda\" if torch.cuda.is_available() else \"cpu\"\n+\n ap = argparse.ArgumentParser()\n ap.add_argument(\"--config\", required=True)\n ap.add_argument(\"--glob\", required=True)\n@@ -40,7 +45,7 @@ def rouge():\n\n     sc = rouge_scorer.RougeScorer([\"rouge1\", \"rouge2\", \"rougeL\"], use_stemmer=True)\n     g2 = AutoTokenizer.from_pretrained(\"gpt2\")\n-    lm = AutoModelForCausalLM.from_pretrained(\"gpt2\").cuda().eval()\n+    lm = AutoModelForCausalLM.from_pretrained(\"gpt2\").to(dev()).eval()\n\n     R = {k: [] for k in (\"rouge1\", \"rouge2\", \"rougeL\")}\n     for h, r in zip(hyps, refs):\n@@ -48,7 +53,7 @@ def rouge():\n         for k in R:\n             R[k].append(v[k].fmeasure)\n     with torch.no_grad():\n-        gp = generation_perplexity(lm, g2, [\"\"] * len(hyps), hyps, device=\"cuda\",\n+        gp = generation_perplexity(lm, g2, [\"\"] * len(hyps), hyps, device=dev(),\n                                    score_only_generated=True, batch_size=32).mean_ppl\n     print(f\"{'R-1':>7} {'R-2':>7} {'R-L':>7} {'genPPL':>8} {'words':>7}\")\n     print(f\"{100 * np.mean(R['rouge1']):7.2f} {100 * np.mean(R['rouge2']):7.2f} {100 * np.mean(R['rougeL']):7.2f} \"\n@@ -85,7 +90,7 @@ def genppl():\n\n     ref = str(CFG.eval.ref_model)\n     rtok = AutoTokenizer.from_pretrained(ref)\n-    rlm = AutoModelForCausalLM.from_pretrained(ref).cuda().eval()\n+    rlm = AutoModelForCausalLM.from_pretrained(ref).to(dev()).eval()\n\n     def entropy(ids):\n         c, m = Counter(ids), len(ids)\n@@ -118,11 +123,11 @@ def genppl_flm():\n     rtok = AutoTokenizer.from_pretrained(ref)\n     if rtok.pad_token is None:\n         rtok.pad_token = rtok.eos_token\n-    rlm = AutoModelForCausalLM.from_pretrained(ref).cuda().eval()\n+    rlm = AutoModelForCausalLM.from_pretrained(ref).to(dev()).eval()\n\n     def corpus_ppl(texts):\n         enc = rtok(texts, return_tensors=\"pt\", return_token_type_ids=False, truncation=True, padding=True, max_length=128)\n-        ids, attn = enc[\"input_ids\"].cuda(), enc[\"attention_mask\"].cuda()\n+        ids, attn = enc[\"input_ids\"].to(dev()), enc[\"attention_mask\"].to(dev())\n         nll_sum = tok_sum = 0.0\n         with torch.no_grad():\n             for i in range(0, ids.shape[0], 16):\ndiff --git a/scripts/eval_shard.py b/scripts/eval_shard.py\nindex 2875b0b..73279fd 100644\n--- a/scripts/eval_shard.py\n+++ b/scripts/eval_shard.py\n@@ -1,5 +1,6 @@\n import argparse, os, pickle, sys\n import torch\n+DEV = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n from omegaconf import OmegaConf\n sys.path.insert(0, os.environ.get(\"NCM_ROOT\", os.getcwd()))\n from models.next_concept import NextConceptTransformer\n@@ -47,8 +48,8 @@ for key, name in (('vocab_file_path', 'bpe_vocab'), ('merges_file_path', 'bpe_me\n     if CFG.checkpoints.get(name):\n         CFG.tokenizer.pre_tokenizer[key] = os.path.join(ck, CFG.checkpoints[name])\n tk = VQVAETokenizer.from_config(CFG.tokenizer)\n-tk.vqvae = tk.vqvae.cuda().eval()\n-net = NextConceptTransformer(vqvae_local=tk.vqvae, config=CFG.model).cuda()\n+tk.vqvae = tk.vqvae.to(DEV).eval()\n+net = NextConceptTransformer(vqvae_local=tk.vqvae, config=CFG.model).to(DEV)\n sd = torch.load(os.path.join(ck, CFG.checkpoints.generator), map_location=\"cpu\", weights_only=False)\n net.load_state_dict(sd[\"model\"], strict=True)\n net.eval()\n@@ -59,11 +60,11 @@ EOS, PAD = tk.pre_tokenizer.eos_token_id, tk.pre_tokenizer.pad_token_id\n def load_allowance(spec):\n     if \":\" in spec:\n         path, ref = spec.split(\":\", 1)\n-        obj = torch.load(os.path.join(ck, path), map_location=\"cuda\", weights_only=False)\n+        obj = torch.load(os.path.join(ck, path), map_location=DEV, weights_only=False)\n         for k in ref.split(\".\"):\n             obj = obj[k]\n         return obj.double()\n-    return torch.load(os.path.join(ck, spec), map_location=\"cuda\").double()\n+    return torch.load(os.path.join(ck, spec), map_location=DEV).double()\n\n\n ALLOW = load_allowance(str(G.frequency_allowance)) if G.get(\"frequency_allowance\") else None\n@@ -153,8 +154,8 @@ if UNCOND:\n         torch.manual_seed(seed)\n         for s in range(0, n, bs):\n             B = min(bs, n - s)\n-            l0 = torch.multinomial(L0_P.cpu(), B * L0, replacement=True).view(B, L0).cuda() if L0_P is not None else None\n-            hyps += run(torch.full((B, 1), EOS, device=\"cuda\"), l0)\n+            l0 = torch.multinomial(L0_P.cpu(), B * L0, replacement=True).view(B, L0).to(DEV) if L0_P is not None else None\n+            hyps += run(torch.full((B, 1), EOS, device=DEV), l0)\n             sample_seed += [seed] * B\n         print(f\"  shard{a.shard} seed {seed}: {n} samples\", flush=True)\n     idxs = list(range(len(hyps)))\n@@ -163,7 +164,7 @@ if UNCOND:\n else:\n     for s in range(0, len(idxs), bs):\n         batch = idxs[s:s + bs]\n-        hyps += run(torch.tensor([prefix(items[i]) for i in batch], device=\"cuda\"))\n+        hyps += run(torch.tensor([prefix(items[i]) for i in batch], device=DEV))\n         if a.shard == 0 and (s // bs) % 10 == 0:\n             print(f\"  shard0 {s}/{len(idxs)}\", flush=True)\n     out = {\"idxs\": idxs, \"hyps\": hyps, \"refs\": [r if isinstance(r, str) else dec(r) for r in (refs[i] for i in idxs)]}```","closed_by":null,"reactions":{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/8/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/HazyResearch/ncm/issues/8/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null},{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/7","repository_url":"https://api.github.com/repos/HazyResearch/ncm","labels_url":"https://api.github.com/repos/HazyResearch/ncm/issues/7/labels{/name}","comments_url":"https://api.github.com/repos/HazyResearch/ncm/issues/7/comments","events_url":"https://api.github.com/repos/HazyResearch/ncm/issues/7/events","html_url":"https://github.com/HazyResearch/ncm/pull/7","id":5913533937,"node_id":"PR_kwDOVEYivs8AAAABJMwnQQ","number":7,"title":"feat(arch): introduce NCM tring architecture with FSQ, Jacobi self-correction, and coupled decoding","user":{"login":"dsadawq3","id":222033745,"node_id":"U_kgDODTv3UQ","avatar_url":"https://avatars.githubusercontent.com/u/222033745?v=4","gravatar_id":"","url":"https://api.github.com/users/dsadawq3","html_url":"https://github.com/dsadawq3","followers_url":"https://api.github.com/users/dsadawq3/followers","following_url":"https://api.github.com/users/dsadawq3/following{/other_user}","gists_url":"https://api.github.com/users/dsadawq3/gists{/gist_id}","starred_url":"https://api.github.com/users/dsadawq3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dsadawq3/subscriptions","organizations_url":"https://api.github.com/users/dsadawq3/orgs","repos_url":"https://api.github.com/users/dsadawq3/repos","events_url":"https://api.github.com/users/dsadawq3/events{/privacy}","received_events_url":"https://api.github.com/users/dsadawq3/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-18T19:57:01Z","updated_at":"2026-10-19T16:14:28Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/HazyResearch/ncm/pulls/7","html_url":"https://github.com/HazyResearch/ncm/pull/7","diff_url":"https://github.com/HazyResearch/ncm/pull/7.diff","patch_url":"https://github.com/HazyResearch/ncm/pull/7.patch","merged_at":null},"body":"## Summary\n\nThis PR introduces **NCM tring**, an architectural overhaul of Next-Concept Modeling (NCM) addressing key bottlenecks in the coarse-to-fine text generation framework:\n\n1. **Finite Scalar Quantization (FSQ) Engine (`models/fsq_quant.py`)**:\n   - Replaces vector quantization and straight-through estimator (STE) divergence with analytical scalar quantization.\n   - Eliminates codebook collapse, codebook clustering EMA drift, and dead-code restarts, ensuring 100% codebook utilization by construction.\n   - Drop-in registered as `multiscale_residual_fsq` in `utils/registry.py`.\n\n2. **Adaptive Semantic Gated Resampling (`models/semantic_resampler.py`)**:\n   - Replaces 1D continuous `F.interpolate(mode='area'/'linear')` with linguistically-aware `SemanticDownsampler` and `SemanticUpsampler`.\n   - Dynamic boundary gating preserves subword, word, and phrase boundaries across scale hierarchies.\n\n3. **1-Step Jacobi Residual Polish (`models/ncm_tring.py`)**:\n   - Eliminates unidirectional quantization error drift across levels (0 -> 1 -> ... -> K).\n   - Calculates the residual discrepancy between adjacent levels and injects a backward correction pulse before stepping to the next scale.\n\n4. **Micro-Causal Coupled Speculative Decoder (`models/coupled_decoder.py`)**:\n   - Predicts joint local bigrams in parallel, suppressing non-autoregressive token stuttering.\n   - Completely removes the need for manual heuristic test-time penalties (`frequency_allowance`, `adjacency_penalty`).\n\n5. **Latent Momentum Consistency Guidance (MCG)**:\n   - Tracks latent momentum in feature space, achieving classifier-free guidance quality with O(B) memory and compute without batch-doubling (B -> 2B), delivering a ~1.4-2x inference speedup.\n\n## Verification\n- Comprehensive test suite added in `tests/test_ncm_tring.py` verifying all subsystems.\n- Benchmark demo in `tring_demo.py` confirms faster inference (42.47 ms vs 59.46 ms baseline) and coherent generation.\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/7/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/HazyResearch/ncm/issues/7/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/6","repository_url":"https://api.github.com/repos/HazyResearch/ncm","labels_url":"https://api.github.com/repos/HazyResearch/ncm/issues/6/labels{/name}","comments_url":"https://api.github.com/repos/HazyResearch/ncm/issues/6/comments","events_url":"https://api.github.com/repos/HazyResearch/ncm/issues/6/events","html_url":"https://github.com/HazyResearch/ncm/pull/6","id":5903809591,"node_id":"PR_kwDOVEYivs8AAAABJFTPFQ","number":6,"title":"Run evaluation on Apple silicon (MPS) and CPU","user":{"login":"velaia","id":1515904,"node_id":"MDQ6VXNlcjE1MTU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1515904?v=4","gravatar_id":"","url":"https://api.github.com/users/velaia","html_url":"https://github.com/velaia","followers_url":"https://api.github.com/users/velaia/followers","following_url":"https://api.github.com/users/velaia/following{/other_user}","gists_url":"https://api.github.com/users/velaia/gists{/gist_id}","starred_url":"https://api.github.com/users/velaia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/velaia/subscriptions","organizations_url":"https://api.github.com/users/velaia/orgs","repos_url":"https://api.github.com/users/velaia/repos","events_url":"https://api.github.com/users/velaia/events{/privacy}","received_events_url":"https://api.github.com/users/velaia/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-17T22:35:03Z","updated_at":"2026-10-17T22:35:03Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/HazyResearch/ncm/pulls/6","html_url":"https://github.com/HazyResearch/ncm/pull/6","diff_url":"https://github.com/HazyResearch/ncm/pull/6.diff","patch_url":"https://github.com/HazyResearch/ncm/pull/6.patch","merged_at":null},"body":"Before running on the RTX 4090 and H100 I ran the evaluation on my M1 Max and this is what I needed to make it work (cherry-picked). The runs on the 4090 and H100 were not negatively impacted by these changes.\n\n- Pick the device via NCM_DEVICE, else CUDA, else MPS, else CPU, instead of hardcoded .cuda()\n- evaluate.py runs a single local shard when no CUDA GPU is visible\n- Use float32 for the frequency-penalty step on MPS, which has no float64\n- On MPS, replace area interpolation with the equivalent averaging matmul, since adaptive pooling with non-divisible sizes is not implemented there\n\nOn CUDA every changed line takes the previous path.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/6/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/HazyResearch/ncm/issues/6/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/5","repository_url":"https://api.github.com/repos/HazyResearch/ncm","labels_url":"https://api.github.com/repos/HazyResearch/ncm/issues/5/labels{/name}","comments_url":"https://api.github.com/repos/HazyResearch/ncm/issues/5/comments","events_url":"https://api.github.com/repos/HazyResearch/ncm/issues/5/events","html_url":"https://github.com/HazyResearch/ncm/pull/5","id":5903709005,"node_id":"PR_kwDOVEYivs8AAAABJFOOew","number":5,"title":": Fix the KV-cached generate() path: identical outputs, 2-5x faster","user":{"login":"velaia","id":1515904,"node_id":"MDQ6VXNlcjE1MTU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1515904?v=4","gravatar_id":"","url":"https://api.github.com/users/velaia","html_url":"https://github.com/velaia","followers_url":"https://api.github.com/users/velaia/followers","following_url":"https://api.github.com/users/velaia/following{/other_user}","gists_url":"https://api.github.com/users/velaia/gists{/gist_id}","starred_url":"https://api.github.com/users/velaia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/velaia/subscriptions","organizations_url":"https://api.github.com/users/velaia/orgs","repos_url":"https://api.github.com/users/velaia/repos","events_url":"https://api.github.com/users/velaia/events{/privacy}","received_events_url":"https://api.github.com/users/velaia/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-17T22:22:21Z","updated_at":"2026-10-17T22:22:21Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/HazyResearch/ncm/pulls/5","html_url":"https://github.com/HazyResearch/ncm/pull/5","diff_url":"https://github.com/HazyResearch/ncm/pull/5.diff","patch_url":"https://github.com/HazyResearch/ncm/pull/5.patch","merged_at":null},"body":"Thanks for releasing the code and checkpoints - I really like the research and am curious to see further advances in the direction specified in the \"What's Next\" section.  I've taken some time to reproduce it on my Mac and on a RTX 4090 and H100 as well. This PR is a result of reproduction while paying attention to performance.\n\n`generate(use_kv_cache=True)` is already there, but its outputs don't match the eager path, and it refuses `query_level0` models (XSum, Sudoku, LM1B). This PR fixes it so the cached path gives the same outputs as the eager one, token for token, and makes as many generator passes. On an H100 it's 2.1-2.4x faster on WMT14 and 4.5-5.1x on XSum. It stays off by default; nothing changes unless you ask for it.\n\n## The bug\n\nWith `use_kv_cache=True` the prefix was encoded, and every level attended to it, without the prefix padding bias (`_pbias`) that the eager path adds in `_decode_level_logits` and the level-0 pass. Padded prefix positions took part in attention, so outputs diverged. On WMT14 (first 64 test sentences) none of the cached outputs matched the eager ones before the fix; after adding the bias to the prefix mask and to each level's mask, all of them do.\n\n## Changes\n\n1. **fix KV-cached generate ignoring the prefix padding mask**: add `_pbias` to the prefix and level masks in the cached path.\n2. **allow the KV cache for query_level0 models**: the assert now only rejects `l0_autoregressive`. With `query_level0` the levels after level 0 decode exactly as with `predict_level0`.\n3. **make the KV-cached generation step stateless**: `SelfAttention` and `Block` take `past_kv=(k, v)` and `return_kv=True` instead of storing `cached_k` / `cached_v` on the module. `generate()` runs the cached path through two side-effect-free methods, `_kv_prefix` and `_kv_level`. `kv_caching()` / `_set_kv_caching()` had no other users in the repo, so they're removed together with the `try/finally` that reset them. This also trims memory: each block's concatenated prefix+level K/V is freed as soon as the block is done, and the kept K/V are copied out of the fused qkv projection so that buffer can be freed.\n4. **reuse the level-0 pass's prefix K/V in the KV-cached path**: the level-0 pass (`predict_level0` or `query_level0`) already runs the prefix through every block, and the prefix rows never attend to the level-0 queries, so their K/V are exactly the prefix cache. Keeping them saves a second encoding of the prefix (512 tokens on XSum). When level 0 is passed in (the unconditional tasks), the prefix is encoded once by `_kv_prefix`.\n5. **add --kv-cache to the evaluation scripts**: `eval_shard.py --kv-cache`; `evaluate.py` already forwards unknown arguments to the shards. One sentence in the README.\n6. **add scripts/bench_kv.py**: runs the same test inputs through `eager` and `kv`, and reports wall-clock time, throughput, peak memory, the share of outputs identical to the eager run, and the task metric (BLEU, ROUGE-L or Sudoku solve rate). On CUDA it turns TF32 off (see below).\n\nThe eager path is untouched: on CPU its outputs are bit-identical to `main` for WMT14 (with and without `--cfg 1.0`), XSum, Sudoku and TinyStories.\n\n## Design\n\nBefore (stateful): turn on `kv_caching` in every attention module, encode the prefix (which fills `cached_k`/`cached_v`), and for each level reset the modules' caches to the prefix K/V and run the level's tokens, which append to the cache.\n\nAfter (stateless):\n\n```\nlevel-0 pass over [prefix; level-0 queries]  ->  keep each block's prefix K/V (k[:, :, :P], v[:, :, :P])\nfor each later level:  x = level tokens;  for each block: attend over cat(prefix K/V, x's K/V)\n```\n\nNothing is stored on the modules, so there's no state to reset if a call fails, and `_kv_prefix` / `_kv_level` can be wrapped with `torch.compile` (including `mode=\"reduce-overhead\"`, i.e. CUDA graphs) without touching `generate()`. RoPE is unchanged: the prefix K is rotated once with positions `[0, P)` and each level's tokens with that level's positions, as in the eager path.\n\n## Identity and NFE\n\nMeasured on a Mac (M1 Max, 64 GB, macOS 26.5, PyTorch 2.14.1). `main` can't run on the Mac GPU yet, so the MPS runs below use a local, unpushed test branch: this PR's six commits on top of the Apple silicon / CPU commit (`velaia:mps-cpu`, which I'm sending as a separate PR). Its diff against this branch is exactly that commit. `scripts/bench_kv.py`, fp32, batch 16 unless noted, eager first:\n\n| Task | Inputs | Identical outputs, eager vs kv | Metric (both) |\n|---|---|---|---|\n| WMT14 | 1,024 | 100% | BLEU 20.59 |\n| WMT14 `--cfg 1.0` | 1,024 | 100% | BLEU 22.09 |\n| XSum | 256 | 100% | ROUGE-L 27.85 |\n| XSum `--cfg 0.5` | 256 | 100% | ROUGE-L 28.26 |\n| Sudoku easy, batch 128 | 2,000 | 100% | 99.40% solved |\n\nOn this branch itself, without the MPS commit, on the CPU: WMT14 (8 sentences, with and without `--cfg 1.0`), XSum (4), Sudoku easy (16) and TinyStories (4, level 0 passed in, temperature 1 with a fixed seed, so it covers the `_kv_prefix` path and sampling) are 100% identical too; TinyStories on MPS (32) as well. On `main`, the cached path matched the eager one on 0 of 8 WMT14 sentences on the CPU and 0 of 64 on MPS; XSum and Sudoku hit the `query_level0` assert.\n\nEarlier runs of the same changes (in my fork, before they were split into these commits) were 100% identical on an RTX 4090 and an H100 as well (with cuDNN TF32 off, see Notes), on 1,024 inputs per task and all 2,000 puzzles of each Sudoku split.\n\nGenerator passes per `generate()` call (forward calls of the first block, counted with a hook), eager and cached: **WMT14 11, XSum 9, Sudoku 12**, also with CFG (which doubles the batch, not the passes). Before commit 4 the cached path made one more pass (12/10/13).\n\nFull WMT14 De-En test set (3,003 sentences) through `evaluate.py --kv-cache`: BLEU 21.72, lowercased 22.61, chrF 49.57, length ratio 0.937, in about 90 s on the Mac including model loading and scoring. That's the same as without the cache (21.72 / 22.61 lowercased on this Mac; the paper reports 22.6).\n\n## Speed\n\nTiming covers generation plus VQ decoding to token ids, after a warmup batch, device synchronised; no model loading, detokenisation or scoring. All runs fp32.\n\n**H100 SXM 80GB** (vast.ai host, power-capped at 500 W), the paper's protocol of 1,024 sequences at batch 16, run with the same changes in my fork (commit `b744792`, which also has the leak fix mentioned below):\n\n| Task | Eager (s) | KV cache (s) | Speedup | Identical | NFE |\n|---|---|---|---|---|---|\n| WMT14 | 13.73 | 6.52 | 2.11x | 100% | 11 |\n| WMT14 `--cfg 1.0` | 24.64 | 10.47 | 2.35x | 100% | 11 (batch x2) |\n| XSum | 44.71 | 10.04 | 4.45x | 100% | 9 |\n| XSum `--cfg 0.5` | 86.42 | 16.98 | 5.09x | 100% | 9 (batch x2) |\n| WMT14, batch 64 | 12.55 | 5.21 | 2.41x | 100% | 11 |\n| XSum, batch 64 | 44.16 | 8.69 | 5.08x | 100% | 9 |\n| Sudoku easy / medium / hard, 2,000 at batch 128 | 8.48-8.52 | 3.60-3.63 | 2.35x | 100% | 12 |\n\n**RTX 4090**, 1,024 sequences at batch 16, measured before commit 4 (the cached path still encoded the prefix twice), so the cache column is a little pessimistic. WMT14 and XSum rows are from a run with the stateless step (commit 3); XSum `--cfg 0.5` and Sudoku from an earlier run with the stateful cache plus the mask fix:\n\n| Task | Eager (s) | KV cache (s) | Speedup | Identical |\n|---|---|---|---|---|\n| WMT14 | 9.94 | 7.83 | 1.27x | 100% |\n| WMT14 `--cfg 1.0` | 17.38 | 8.75 | 1.99x | 100% |\n| XSum | 33.21 | 10.99 | 3.02x | 100% |\n| XSum `--cfg 0.5` | 68.44 | 20.57 | 3.33x | 100% |\n| Sudoku easy / medium / hard, 2,000 at batch 128 | 6.48-6.49 | 3.07-3.08 | 2.1x | 100% |\n\n**Mac M1 Max (MPS)**, this branch on top of the Apple silicon commit, same runs as the identity table:\n\n| Task | Eager (s) | KV cache (s) | Speedup |\n|---|---|---|---|\n| WMT14, 1,024 | 69.79 | 29.73 | 2.35x |\n| WMT14 `--cfg 1.0`, 1,024 | 133.25 | 51.46 | 2.59x |\n| XSum, 256 | 60.71 | 11.90 | 5.10x |\n| XSum `--cfg 0.5`, 256 | 121.44 | 22.82 | 5.32x |\n| Sudoku easy, 2,000 at batch 128 | 54.49 | 21.39 | 2.55x |\n\n## Notes\n\n- **cuDNN TF32 must be off for bit-identical outputs on CUDA.** PyTorch enables TF32 for cuDNN convolutions by default, which the VQ model's convolutions use. In one early 4090 run with it on, 1 of 1,024 guided WMT14 translations differed between the paths; with `torch.backends.cudnn.allow_tf32 = False` (as `bench_kv.py` sets) every run on the 4090, the H100 and the Mac was 100% identical. The scores don't move either way.\n- **Independent of #4** (the `generate()` memory leak). The two touch nearby lines in `generate()`, so whichever merges second needs a small rebase. Without #4, memory still grows per `generate()` call until Python's cyclic GC runs, with or without the cache. These benchmarks ran without #4 and completed normally at batch 16; it matters at larger batches: with the cache, XSum at batch 64 ran out of memory on a 24 GB 4090 before that fix.\n- I have `bench_kv.py` modes for TF32, bf16/fp16 autocast and `torch.compile` / CUDA graphs on top of the cache in my fork (velaia/ncm, branch `mac-mps`). On the H100, cache + CUDA graphs keeps outputs identical (XSum 8.85 s, WMT14 5.15 s); cache + bf16 + CUDA graphs reaches 3.45 s on XSum and 2.20 s on WMT14 but changes about half (XSum) to three quarters or more (WMT14) of the outputs, at about the same scores. I left them out to keep this PR small; happy to add them if you want.\n- `bench_kv.py` picks CUDA, else MPS, else CPU. Running the models on MPS needs the Apple silicon changes (`velaia:mps-cpu`, separate PR); on CUDA it works on `main` as is.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/5/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/HazyResearch/ncm/issues/5/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/4","repository_url":"https://api.github.com/repos/HazyResearch/ncm","labels_url":"https://api.github.com/repos/HazyResearch/ncm/issues/4/labels{/name}","comments_url":"https://api.github.com/repos/HazyResearch/ncm/issues/4/comments","events_url":"https://api.github.com/repos/HazyResearch/ncm/issues/4/events","html_url":"https://github.com/HazyResearch/ncm/pull/4","id":5903618232,"node_id":"PR_kwDOVEYivs8AAAABJFJvTg","number":4,"title":" Fix memory leak in generate(): read raw_token_prefix/contextual_prefix once","user":{"login":"velaia","id":1515904,"node_id":"MDQ6VXNlcjE1MTU5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1515904?v=4","gravatar_id":"","url":"https://api.github.com/users/velaia","html_url":"https://github.com/velaia","followers_url":"https://api.github.com/users/velaia/followers","following_url":"https://api.github.com/users/velaia/following{/other_user}","gists_url":"https://api.github.com/users/velaia/gists{/gist_id}","starred_url":"https://api.github.com/users/velaia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/velaia/subscriptions","organizations_url":"https://api.github.com/users/velaia/orgs","repos_url":"https://api.github.com/users/velaia/repos","events_url":"https://api.github.com/users/velaia/events{/privacy}","received_events_url":"https://api.github.com/users/velaia/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":0,"created_at":"2026-10-17T22:11:14Z","updated_at":"2026-10-17T22:11:14Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/HazyResearch/ncm/pulls/4","html_url":"https://github.com/HazyResearch/ncm/pull/4","diff_url":"https://github.com/HazyResearch/ncm/pull/4.diff","patch_url":"https://github.com/HazyResearch/ncm/pull/4.patch","merged_at":null},"body":"### Symptom\n\n`generate()` keeps all of its tensors alive after returning, until Python's cyclic garbage collector happens to run. That's effectively a memory leak between GC passes, and it roughly doubles peak memory. On an RTX 4090, peak memory of the eager path (1,024 sequences, fp32):\n\n| Task | Batch | Peak before | Peak after |\n|---|---|---|---|\n| XSum | 16 | 2.11 GB | 1.19 GB |\n| XSum | 64 | 5.82 GB | 2.52 GB |\n| WMT14 | 16 | 2.14 GB | 1.77 GB |\n| WMT14 | 64 | 5.04 GB | 3.66 GB |\n\nOutputs and wall-clock time are unchanged. With a KV cache (I'll send that in a separate PR), each leaked call also keeps the prefix K/V alive. That came to about 1.26 GB per XSum batch of 16, and XSum at batch 64 ran out of memory on the 24 GB card.\n\n### Cause\n\n`generate()` reads two optional flags from the model config on every call:\n\n```python\nif bool(getattr(self.config, 'raw_token_prefix', False)):\n    ...\n    if bool(getattr(self.config, 'contextual_prefix', False)) and \\\n```\n\nNone of the configs in `config/eval/` set `contextual_prefix`. For a missing key, `DictConfig.__getattr__` raises a `ConfigAttributeError`, and `getattr` catches it to return the default. Inside omegaconf, that exception and its traceback form a reference cycle that includes `generate()`'s frame. The frame therefore outlives the call, and so does every tensor it references, until the cyclic GC collects it. Minimal demo (omegaconf 2.3):\n\n```python\nimport gc, weakref\nfrom omegaconf import OmegaConf\nc = OmegaConf.create({'a': 1})\nclass T: pass\ndef f(key):\n    t = T(); r = weakref.ref(t)\n    getattr(c, key, None)\n    return r\ngc.disable()\nprint(f('a')() is None)  # True: freed on return\nprint(f('b')() is None)  # False: missing key, the local outlives the call\ngc.collect()             # now it is freed\n```\n\n### Fix\n\nRead both flags once in `__init__` and use the attributes in `generate()`. I checked the other `getattr(config, ..., default)` calls. All of them run once, in `__init__` or in the per-device cached flex block mask, so I left them alone.\n\n### Repro\n\nXSum checkpoint, batch 16, `top_k=1`, `gc.disable()`, memory allocated after each `generate()` call relative to before the first one. Apple M1 Max (MPS):\n\n| | call 1 | 2 | 3 | 4 | 5 | after `gc.collect()` |\n|---|---|---|---|---|---|---|\n| before | +95 MB | +190 MB | +285 MB | +380 MB | +476 MB | +0 MB |\n| after | +0 MB | +0 MB | +0 MB | +0 MB | +0 MB | +0 MB |\n\nOn CPU with the unmodified repo (batch 4, bytes held by live tensors): +27 MB per call before, flat after.\n\nWMT14 (`evaluate.py --n 256`, MPS) produces identical outputs before and after: BLEU 17.84 / 18.59 lowercased.\n\n<sub>Note: upstream doesn't run on MPS yet. For the MPS numbers I applied a small local patch (device selection and an MPS-safe replacement for area interpolation) that isn't part of this PR.</sub>\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/4/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/HazyResearch/ncm/issues/4/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/HazyResearch/ncm/issues/3","repository_url":"https://api.github.com/repos/HazyResearch/ncm","labels_url":"https://api.github.com/repos/HazyResearch/ncm/issues/3/labels{/name}","comments_url":"https://api.github.com/repos/HazyResearch/ncm/issues/3/comments","events_url":"https://api.github.com/repos/HazyResearch/ncm/issues/3/events","html_url":"https://github.com/HazyResearch/ncm/issues/3","id":5872927921,"node_id":"I_kwDOVEYivs8AAAABXg3EsQ","number":3,"title":"Verify evals on Papers with Code","user":{"login":"NielsRogge","id":48327001,"node_id":"MDQ6VXNlcjQ4MzI3MDAx","avatar_url":"https://avatars.githubusercontent.com/u/48327001?v=4","gravatar_id":"","url":"https://api.github.com/users/NielsRogge","html_url":"https://github.com/NielsRogge","followers_url":"https://api.github.com/users/NielsRogge/followers","following_url":"https://api.github.com/users/NielsRogge/following{/other_user}","gists_url":"https://api.github.com/users/NielsRogge/gists{/gist_id}","starred_url":"https://api.github.com/users/NielsRogge/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NielsRogge/subscriptions","organizations_url":"https://api.github.com/users/NielsRogge/orgs","repos_url":"https://api.github.com/users/NielsRogge/repos","events_url":"https://api.github.com/users/NielsRogge/events{/privacy}","received_events_url":"https://api.github.com/users/NielsRogge/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"mi