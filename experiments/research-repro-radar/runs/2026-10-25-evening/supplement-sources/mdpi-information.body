			<dc:creator>Nurlykhan Kalzhanov</dc:creator>
			<dc:creator>Arman Yeleussinov</dc:creator>
			<dc:creator>Maxatbek Satymbekov</dc:creator>
			<dc:creator>Zholdas Buribayev</dc:creator>
			<dc:creator>Yerbol Alimkulov</dc:creator>
			<dc:creator>Ualikhan Akhatov</dc:creator>
