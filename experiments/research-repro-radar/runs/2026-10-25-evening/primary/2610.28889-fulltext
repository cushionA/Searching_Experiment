<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_math_unparsed" alttext="\widetilde{G}_{\lambda,d,K}(x)=\mathcal{R}_{d}\!\left(A_{d}\!\left(\operatorname{LN}\left(H^{\rm img}_{\lambda,d}(x)\right)_{:,K}\right)\right),\qquad K\subseteq[D],\quad|K|=b," display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mrow><mi>λ</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>K</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>d</mi></msub><mrow><mo>(</mo><msub><mi>A</mi><mi>d</mi></msub><mrow><mo>(</mo><mi>LN</mi><msub><mrow><mo>(</mo><msubsup><mi>H</mi><mrow><mi>λ</mi><mo>,</mo><mi>d</mi></mrow><mi>img</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>K</mi></mrow></msub><mo>)</mo></mrow><mo>)</mo></mrow><mo rspace="2.167em">,</mo><mi>K</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow><mo rspace="1.167em">,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>K</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">=</mo><mi>b</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{G}_{\lambda,d,K}(x)=\mathcal{R}_{d}\!\left(A_{d}\!\left(\operatorname{LN}\left(H^{\rm img}_{\lambda,d}(x)\right)_{:,K}\right)\right),\qquad K\subseteq[D],\quad|K|=b,</annotation></semantics></math></td>
