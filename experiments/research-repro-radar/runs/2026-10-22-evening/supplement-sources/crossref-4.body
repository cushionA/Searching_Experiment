oi.org\/10.1109\/case69030.2026.11704196","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,6]],"date-time":"2026-10-06T19:06:43Z","timestamp":1791313603000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11703955\/11704113\/11704196.pdf?arnumber=11704196","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00736","title":["Bootstrap Your Own Classifier: Your Pretrained Vision Models are Secretly Strong Continual Learners"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00736","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:18:16Z","timestamp":1791487096000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698503.pdf?arnumber=11698503","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00075","title":["Finetune Like You Pretrain: Boosting Zero-Shot Adversarial Robustness in Vision-Language Models"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00075","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:29:15Z","timestamp":1791487755000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698038.pdf?arnumber=11698038","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00114","title":["PEARL: A Lightweight Prompt-Based Feature Interpreter Framework for Real-Time, Anonymous, and Heterogeneous Collaborative Perception"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00114","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:27:15Z","timestamp":1791487635000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698508.pdf?arnumber=11698508","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00922","title":["Ramen: Robust Test-Time Adaptation of Vision-Language Models with Active Sample Selection"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00922","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:19:31Z","timestamp":1791487171000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698381.pdf?arnumber=11698381","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.23919\/aaicvcps00050.2026.00023","title":["A Lightweight Video Anomaly Detection Model for Smart Elderly Care Scenarios"],"author":[{"given":"Zhang","family":"Qian","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Cai","family":"Jingjing","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shi","family":"Lei","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.23919\/aaicvcps00050.2026.00023","published":{"date-parts":[[2026,3]]},"created":{"date-parts":[[2026,10,5]],"date-time":"2026-10-05T19:14:21Z","timestamp":1791227661000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11719634\/11719635\/11719795.pdf?arnumber=11719795","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Desktop operation of humanoid robot needs to coordinate the relationship between visual scene, language instruction, robot state and action execution. This paper focuses on the lightweight VLA model to enable the generalization and optimization of desktop jobs, and constructs multimodal input, model distillation, low-rank adaptation, quantization compression and lightweight action head processes. In method, RGB-D images, language commands, joint states, and end poses are used to form a unified input, and the inference burden is reduced by parameter compression. The experiments are based on 3200 groups of task data and verified in Python, PyTorch, ROS and Isaac Sim environments. The results show that the task success rate of the proposed method is 91.7%, the inference delay is 38 ms, the video memory occupation is 5.1 GB, and the generalization success rate of unseen objects is 82.6%, which can support real-time deployment and generalization execution of desktop jobs.<\/jats:p>","DOI":"10.1117\/12.3134706","created":{"date-parts":[[2026,10,19]],"date-time":"2026-10-19T18:11:58Z","timestamp":1792433518000},"title":["A lightweight VLA model empowers a generalized optimization approach for desktop tasks in humanoid robots"],"author":[{"given":"Yuxin","family":"Shou","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14516\/3134706\/A-lightweight-VLA-model-empowers-a-generalized-optimization-approach-for\/10.1117\/12.3134706.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3134706","published":{"date-parts":[[2026,10,19]]}},{"DOI":"10.1109\/cvprf71909.2026.00323","title":["Circuit Tracing in Vision-Language Models: Understanding the Internal Mechanisms of Multimodal Thinking"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00323","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:38:19Z","timestamp":1791488299000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698490.pdf?arnumber=11698490","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.3844\/jcssp.2026.2736.2754","title":["An Edge Efficient and Lightweight Hybrid CNN Vision Transformer Network With CBAM for IoT Based Plant Disease Detection"],"author":[{"given":"Nyabeye Pangop","family":"Doris-Kh\u00f6ler","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Kengni Ngangmo","family":"Olga","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.3844\/jcssp.2026.2736.2754","published":{"date-parts":[[2026,9,1]]},"created":{"date-parts":[[2026,9,23]],"date-time":"2026-09-23T12:45:15Z","timestamp":1790167515000}},{"DOI":"10.1007\/s11263-026-03031-7","title":["GoClick: Lightweight Element Grounding Model for Autonomous GUI Interaction"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-1445-7357","authenticated-orcid":false,"given":"Hongxin","family":"Li","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuntao","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-2648-3875","authenticated-orcid":false,"given":"Zhaoxiang","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/s11263-026-03031-7","published":{"date-parts":[[2026,10,18]]},"created":{"date-parts":[[2026,10,18]],"date-time":"2026-10-18T12:14:38Z","timestamp":1792325678000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s11263-026-03031-7.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/article\/10.1007\/s11263-026-03031-7","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s11263-026-03031-7.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.54254\/2755-2721\/2026.36907","title":["Lightweight Vision Models for Galaxy Morphology Classification: A Comparative Study of ResNet, MobileNet, EfficientNet, and MobileViT on Galaxy10 DECaLS"],"author":[{"given":"Xiangyu","family":"Liao","sequence":"first","affiliation":[{"name":"Sorbonne Universit\u00e9"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Automated galaxy morphology classification now rests on parameter-heavy convolutional backbones, whose cost becomes a design constraint as survey volumes grow. This paper compares three lightweight architectures (MobileNetV2, EfficientNetB0, and MobileViT-Extra Small (XS)) against a ResNet50 baseline on the Galaxy10 Dark Energy Camera Legacy Survey (DECaLS) benchmark of 17,736 images in ten classes, holding data splits, augmentation, optimizer, loss, and stopping rule fixed so that the backbone is the only variable. The lightweight models give up between 2.07 and 2.55 percentage points of support-weighted accuracy while removing 82.9% to 91.8% of the parameters and 42% to 59% of the per-image inference latency, which makes them 5.7 to 11.8 times more efficient per parameter. Two results run against expectations. The hardest class is not the rarest one. In a redshift-stratified comparison, the only attention-based backbone falls furthest behind the baseline on exactly the smallest and faintest galaxies, so the advantage reported for Vision Transformers does not carry over to a lightweight hybrid. For survey-scale processing, the trade is worth making; for a catalogue of a few thousand galaxies, it is not.<\/jats:p>","URL":"https:\/\/doi.org\/10.54254\/2755-2721\/2026.36907","published":{"date-parts":[[2026,9,15]]},"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T07:11:31Z","timestamp":1789456291000}},{"DOI":"10.1007\/978-3-032-37369-4_18","title":["DiffusionVL: Translating Any Autoregressive Models into Diffusion Vision Language Models"],"author":[{"given":"Lunbin","family":"Zeng","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jingfeng","family":"Yao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Bencheng","family":"Liao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hongyuan","family":"Tao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Wenyu","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xinggang","family":"Wang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37369-4_18","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,9]],"date-time":"2026-09-09T05:46:39Z","timestamp":1788932799000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-032-37369-4_18","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1016\/j.cviu.2026.104966","title":["Copyright-aware adversarial perturbation for preventing unauthorized image generation in diffusion models"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0003-1781-764X","authenticated-orcid":false,"given":"Yunyu","family":"Kang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Minghuang","family":"Shen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Liqiang","family":"Lin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3621-9528","authenticated-orcid":false,"given":"Shyan-Ming","family":"Yuan","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0000-3427-9255","authenticated-orcid":false,"given":"Xiaolong","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.cviu.2026.104966","published":{"date-parts":[[2026,11]]},"created":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T15:58:39Z","timestamp":1790611119000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1077314226003334?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1077314226003334?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.1109\/cvprf71909.2026.00085","title":["Red-Teaming the Multimodal Reasoning: Jailbreaking Vision-Language Models via Cross-Modal Entanglement Attacks"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00085","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:25:18Z","timestamp":1791487518000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698477.pdf?arnumber=11698477","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00583","title":["HAIT: Hybrid Adversarial Iterative Training for Mitigating Object Hallucination in Large Vision-Language Models"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00583","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:19:51Z","timestamp":1791487191000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698402.pdf?arnumber=11698402","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00768","title":["RAZOR: Ratio-Aware Layer Editing for Targeted Unlearning in Vision Transformers and Diffusion Models"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00768","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:29:06Z","timestamp":1791487746000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698042.pdf?arnumber=11698042","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00824","title":["Beyond Static Artifacts: A Forensic Benchmark for Video Deepfake Reasoning in Vision Language Models"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00824","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:21:59Z","timestamp":1791487319000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697931.pdf?arnumber=11697931","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00859","title":["HiViS: Hiding Visual Tokens from the Drafter for Speculative Decoding in Vision-Language Models"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00859","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:21:32Z","timestamp":1791487292000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698340.pdf?arnumber=11698340","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00856","title":["Thinking With Blueprints: Assisting Vision-Language Models in Spatial Reasoning Via Structured Object Representation"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00856","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:17:16Z","timestamp":1791487036000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698430.pdf?arnumber=11698430","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Glaucoma is one of the major causes of permanent blindness in the world, and since the progressive nature of the disease leads to considerable damage of the optic nerve before diagnosis, there is a need to develop precise and effective automated screening tools. This paper suggests the implementation of a lightweight vision transformer network for glaucoma screening based on the DeiT-Small architecture. The images were downsized to 224 \u00d7 224 resolution and transformed into patches. Four transformer blocks were frozen while the other blocks were fine-tuned via layer-wise learning-rate decay (LLRD) along with data augmentation and Test-Time Augmentation (TTA). Testing was performed on a balanced dataset with 9,540 images: 8,000 for training, 770 for validation and 770 for testing. In the independent test dataset, the model achieved 91.65% accuracy, 91.55% F1-score, 91.56% sensitivity, 95.06% specificity, and 95.84% AUC-ROC. Test-time augmentation was applied to enhance the reliability of predictions without re-<\/jats:p>","DOI":"10.61710\/pxx89244","created":{"date-parts":[[2026,9,23]],"date-time":"2026-09-23T21:59:09Z","timestamp":1790200749000},"title":["Efficient Glaucoma Detection from Retinal Fundus Images Using a Lightweight DeiT-Small Vision Transformer and Test-Time Augmentation"],"author":[{"suffix":"Jahefer","given":"Mothefer","family":"Majeed","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/jkceas.iku.edu.iq\/index.php\/JACEAS\/en\/dashboard\/editorial?currentViewId=active&workflowSubmissionId=244&workflowMenuKey=workflow_5","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.61710\/pxx89244","published":{"date-parts":[[2026,9,30]]}},{"DOI":"10.1109\/aris70457.2026.11734394","title":["MirrorConv: A Parameter-Shared Staggered Topology Operator for Extreme Lightweight Vision Models and its Empirical Robustness Analysis"],"author":[{"given":"Jia-Shing","family":"Shih","sequence":"first","affiliation":[{"name":"Southern Taiwan University of Science and Technology","place":["Tainan, Taiwan"],"department":["Department of Electrical Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Chi-Hsun","family":"Chang","sequence":"additional","affiliation":[{"name":"Southern Taiwan University of Science and Technology","place":["Tainan, Taiwan"],"department":["Department of Electrical Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/aris70457.2026.11734394","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,20]],"date-time":"2026-10-20T19:18:29Z","timestamp":1792523909000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11734275\/11734297\/11734394.pdf?arnumber=11734394","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.21474\/jncs01\/149","title":["COMPUTER VISION FOR INTELLIGENT OBJECT DETECTION: MODELS, APPLICATIONS, AND CHALLENGES"],"author":[{"given":"Ayaan","family":"Malik","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Khan","family":"Ishrat","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Computer vision is an important field of artificial intelligence that enables computer systems to interpret and analyse visual information from images and videos. Among its major tasks, intelligent object detection focuses on identifying objects, assigning class labels, and determining their locations within a visual scene. Recent advances in deep learning have substantially improved object-detection capabilities, particularly through convolutional neural networks (CNNs), single-stage detectors, region-based detection frameworks, and transformer-based architectures. Models such as Faster R-CNN, Single Shot MultiBox Detector (SSD), You Only Look Once (YOLO), and Detection Transformer (DETR) represent different approaches to balancing detection accuracy, computational efficiency, and model complexity. These techniques support applications in autonomous transportation, healthcare, agriculture, industrial inspection, surveillance, robotics, and smart-city infrastructure. Nevertheless, object detection remains challenging because of variations in lighting, object scale, occlusion, background complexity, limited labelled data, computational constraints, and potential bias in training datasets. This paper reviews the fundamental principles of intelligent object detection, discusses major model architectures and their applications, and examines the technical and ethical challenges associated with real-world deployment. It also identifies research directions involving efficient models, improved small-object detection, domain adaptation, explainability, privacy protection, and responsible artificial intelligence. The review concludes that effective object-detection systems must balance accuracy, speed, reliability, resource consumption, and responsible use according to the requirements of the intended application.<\/jats:p>","URL":"https:\/\/doi.org\/10.21474\/jncs01\/149","published":{"date-parts":[[2026,8,31]]},"created":{"date-parts":[[2026,10,20]],"date-time":"2026-10-20T09:49:43Z","timestamp":1792489783000}},{"DOI":"10.1109\/cvprf71909.2026.00264","title":["Rethinking Compact (&lt;1M) Vision Models: Balancing Accuracy and Speed Through Multi-Path Atrous Convolutions"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00264","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:18:13Z","timestamp":1791487093000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698488.pdf?arnumber=11698488","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00940","title":["Euclid's Gift: Enhancing Spatial Perception and Reasoning in Vision-Language Models via Geometric Surrogate Tasks"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00940","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:33:27Z","timestamp":1791488007000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698015.pdf?arnumber=11698015","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00904","title":["MASS: Motion-Aware Spatial-Temporal Grounding for Physics Reasoning and Comprehension in Vision-Language Models"],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00904","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:29:14Z","timestamp":1791487754000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698122.pdf?arnumber=11698122","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/iccvdm71812.2026.11709113","title":["A Lightweight FPGA-Based Hardware for Infrared Small-Target Real-Time Detection Using CNN"],"author":[{"given":"Sergey V.","family":"Karamov","sequence":"first","affiliation":[{"name":"Novus Converged Aerospace Ltd","place":["London, United Kingdom"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Maksim O.","family":"Zhegulin","sequence":"additional","affiliation":[{"name":"Novus Converged Aerospace Ltd","place":["London, United Kingdom"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/iccvdm71812.2026.11709113","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,1]],"date-time":"2026-10-01T19:08:23Z","timestamp":1790881703000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11709023\/11709058\/11709113.pdf?arnumber=11709113","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Cataracts, Diabetic Retinopathy, and Glaucoma are the leading causes of vision loss worldwide. Traditionally, these diseases are diagnosed by experienced ophthalmologists who manually inspect the retinal images. Although effective, this approach faces some challenges. In fact, it can be time-consuming and, in some countries with low doctor-patient ratios, patients cannot access the necessary care. To solve this problem, researchers around the world are working on computer-aided diagnosis systems to assist healthcare professionals. In this study, the NASNetMobile architecture is leveraged to classify four eye conditions: Cataract, Diabetic Retinopathy, Glaucoma, and Normal. The proposed model was trained on the EDC dataset, containing 4 classes and 4217 images. Performance metrics used include accuracy, recall, f1-score and area under the curve (AUC). The experimental results were compared against published existing work and showed superior results.<\/jats:p>","DOI":"10.5565\/rev\/elcvia.2233","created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T13:10:24Z","timestamp":1789477824000},"title":["A  Lightweight Deep Neural Network for Multi-label Eye Diseases Classification"],"author":[{"given":"Nzanzu","family":"Romeo","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Megha","family":"Chhabra","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Saumya","family":"Chaturvedi","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/elcvia.cvc.uab.cat\/article\/download\/2233\/679","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/elcvia.cvc.uab.cat\/article\/download\/2233\/679","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.5565\/rev\/elcvia.2233","published":{"date-parts":[[2026,9,15]]}},{"abstract":"<jats:p>Aiming at the problems of large parameters and high computational complexity in deep learning-based image super-resolution networks, this paper proposes a lightweight super-resolution network that fuses multi-attention mechanism and Blueprint Separable Convolution (BSConv). BSConv is introduced to improve performance while reducing parameters. A Window-Shifted Spatial Self-Attention Module (WSSM) and a Blueprint Separable Channel-self-attention Module (BSCM) are designed to extract local features. A Coordinate Attention Module (CAM) is combined to capture global information. Extensive experiments on Set5, Set14, B100, and Urban100 datasets for \u00d72\/\u00d73\/\u00d74 reconstruction show that compared with the lightweight NGswin model, the proposed method improves PSNR by 0.09 dB on Set5 for \u00d72 reconstruction and reduces parameters by 453K, which can recover image textures and details more efficiently.<\/jats:p>","DOI":"10.1117\/12.3129285","created":{"date-parts":[[2026,9,25]],"date-time":"2026-09-25T15:23:41Z","timestamp":1790349821000},"title":["Lightweight image super-resolution network fusing multi-attention mechanism and blueprint separable convolution"],"author":[{"given":"Yiyan","family":"Huang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Lin","family":"Guo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14357\/3129285\/Lightweight-image-super-resolution-network-fusing-multi-attention-mechanism-and\/10.1117\/12.3129285.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3129285","published":{"date-parts":[[2026,9,25]]}},{"abstract":"<jats:p>To address the issues of severe parameter redundancy and high computational overhead in current weather intensity recognition algorithms, which make them difficult to deploy in real-time on edge devices, this paper proposes ACE-MV3Small, a lightweight multi-task network. Using MobileNetV3-Small as the backbone, the model decouples at the ninth inverted residual block to collaboratively model sky state bias index regression and rainfall intensity classification tasks. Coordinate Attention and Efficient Channel Attention are introduced to enhance spatial awareness and texture discrimination performance, respectively. Experimental results show that the model achieves an accuracy of 94.4% on the weather condition intensity dataset; the parameter count is only 1.83M, and the computational complexity is reduced by approximately 112 times compared to CMWRN. This scheme provides an efficient technical path for real-time meteorological recognition at the edge.<\/jats:p>","DOI":"10.1117\/12.3125792","created":{"date-parts":[[2026,10,6]],"date-time":"2026-10-06T16:56:56Z","timestamp":1791305816000},"title":["Improved MobileNetV3-based lightweight multitask network for weather intensity recognition on edge devices"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0008-3139-8601","authenticated-orcid":false,"given":"Yukang","family":"Deng","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xiangsheng","family":"Feng","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14353\/3125792\/Improved-MobileNetV3-based-lightweight-multitask-network-for-weather-intensity-recognition\/10.1117\/12.3125792.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3125792","published":{"date-parts":[[2026,10,6]]}},{"DOI":"10.1109\/cisat71030.2026.11682442","title":["Enhancing Lightweight Models for Edge-Device Mineral Classification through Multi-Strategy Knowledge Distillation"],"author":[{"given":"Yi","family":"Zhang","sequence":"first","affiliation":[{"name":"Xi'an Jiaotong University","place":["Xi'an, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cisat71030.2026.11682442","published":{"date-parts":[[2026,7]]},"created":{"date-parts":[[2026,9,10]],"date-time":"2026-09-10T19:06:31Z","timestamp":1789067191000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11682029\/11682043\/11682442.pdf?arnumber=11682442","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]}],"items-per-page":100,"query":{"start-index":0,"search-terms":null}}}