</figure>
<figure id="S0.F2" class="ltx_figure"><img src="2610.25519v1/figures/fig_overview_v6.png" id="S0.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:462/177;" width="462" height="177" alt="Refer to caption">
