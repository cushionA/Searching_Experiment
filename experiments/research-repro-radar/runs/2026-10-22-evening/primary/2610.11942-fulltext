<td id="S4.T2.2.3.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;">0.193</td>
<td id="S4.T2.2.3.5" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T2.m6" class="ltx_Math" alttext="\mathbf{-32\%}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>𝟑𝟐</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{-32\%}</annotation></semantics></math></td></tr>
