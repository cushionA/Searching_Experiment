<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E15Xa.m2" class="ltx_Math" alttext="\displaystyle\left.\mathrm{clip}\!\left(\rho_{t}(v),1-\varepsilon,1+\varepsilon\right)r_{t}(v)\right\}," display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.428em;" width="1.428em"><mi>clip</mi></mpadded><mo>(</mo><mi>ρ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo>,</mo><mn>1</mn><mo>−</mo><mi>ε</mi><mo>,</mo><mn>1</mn><mo>+</mo><mi>ε</mi><mo>)</mo><mi>r</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo>}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.\mathrm{clip}\!\left(\rho_{t}(v),1-\varepsilon,1+\varepsilon\right)r_{t}(v)\right\},</annotation></semantics></math></td>
