<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E13.m1" class="ltx_Math" alttext="r_{t}(v)=-\bar{p}_{S,\mathrm{old}}^{A}(v)\left[\log p_{S,\mathrm{old}}(v)-\log p_{T}(v)\right],\qquad v\in A_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>p</mi><mo>¯</mo></mover><mrow><mi>S</mi><mo>,</mo><mi>old</mi></mrow><mi>A</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mrow><mi>S</mi><mo>,</mo><mi>old</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>T</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>v</mi><mo>∈</mo><msub><mi>A</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r_{t}(v)=-\bar{p}_{S,\mathrm{old}}^{A}(v)\left[\log p_{S,\mathrm{old}}(v)-\log p_{T}(v)\right],\qquad v\in A_{t}.</annotation></semantics></math></td>
