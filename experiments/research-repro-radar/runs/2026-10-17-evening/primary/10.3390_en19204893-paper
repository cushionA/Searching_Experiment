e="citation_reference" content="citation_title=Energy Use of AI Inference, Efficiency Pathways, and Test-Time Scaling; citation_author=Oviedo, F., Kazhamiaka, F., Choukse, E., Kim, A., Luers, A., Nakagawa, M., Bianchini, R., Lavista Ferres, J.M.; citation_publication_date=2026; citation_journal_title=Joule; citation_volume=10; citation_firstpage=102430; citation_doi=10.1016/j.joule.2026.102430" data-hid="citation_reference-2069617-16"><meta name="dc.source" content="Energies 2026, Vol. 19, Page 4893" data-hid="dc.source-2069617"><meta name="dc.publisher" content="Multidisciplinary Digital Publishing Institute" data-hid="dc.publisher-2069617"><meta name="dc.title" content="Does Lower Precision Always Save Energy? Benchmarking Energy–Performance Trade-Offs in Weight-Quantized Large Language Model Inference on a GPU" data-hid="dc.title-2069617"><meta name="dc.type" content="Article" data-hid="dc.type-2069617"><meta name="dc.date" content="2026-10-16" data-hid="dc.date-2069617"><meta name="dc.identifier" content="10.3390/en19204893" data-hid="dc.identifier-2069617"><meta name="dc.rights" content="https://creativecommons.org/licenses/by/3.0/" data-hid="dc.rights-2069617"><meta name="dc.format" content="application/pdf" data-hid="dc.format-2069617"><meta name="dc.language" content="en" data-hid="dc.language-2069617"><meta name="dc.description" content="Large language model (LLM) inference is an increasing component of AI energy demand, while the energy effects of weight quantization depend on workload phase and implementation. We benchmarked four LLM families—Gemma 4 E4B IT, Qwen3.5 4B, Nemotron 3 Nano 4B, and Ministral 3 3B Instruct—across Q4_K_M, Q6_K, Q8_0, and BF16 weight representations on a single NVIDIA GeForce RTX 4090 using llama.cpp/CUDA. Five workloads separated prefill from autoregressive generation, and GPU energy was estimated from NVML telemetry. In PP-512, no statistically significant differences were detected under the employed measurement protocol; in PP-1024, precision affected total energy and mean GPU power. In all generation scenarios, model family, precision, and their interaction significantly affected the primary endpoints. Relative to BF16, Q4_K_M reduced dynamic energy per token by 63.6–85.7% and increased generation throughput by 85.2–160.2% across all four model families. Ministral 3 3B Instruct–Q4_K_M ranked first in TOPSIS, whereas Nemotron 3 Nano 4B–Q4_K_M required less GPU memory. Findings are limited to single-request execution on one RTX 4090/llama.cpp-CUDA stack; output quality was not assessed, and 50 ms NVML sampling limits interpretation of short prefill measurements." data-hid="dc.description-2069617"><meta name="title" content="Does Lower Precision Always Save Energy? Benchmarking Energy–Performance Trade-Offs in Weight-Quantized Large Language Model Inference on a GPU" data-hid="title-2069617"><meta name="msapplication-TileImage" content="https://mdpi-res.com/img/journals/energies-logo-sq.png?4acb609819f4b6c3" data-hid="msapplication-TileImage-2069617"><meta name="prism.issn" content="1996-1073" data-hid="prism.issn-2069617"><meta name="prism.publicationName" content="Energies" data-hid="prism.publicationName-2069617"><meta name="prism.publicationDate" content="2026-10-16" data-hid="prism.publicationDate-2069617"><meta name="prism.section" content="Article" data-hid="prism.section-2069617"><meta name="citation_issn" content="1996-1073" data-hid="citation_issn-2069617"><meta name="citation_journal_title" content="Energies" data-hid="citation_journal_title-2069617"><meta name="citation_publisher" content="Multidisciplinary Digital Publishing Institute" data-hid="citation_publisher-2069617"><meta name="citation_title" content="Does Lower Precision Always Save Energy? Benchmarking Energy–Performance Trade-Offs in Weight-Quantized Large Language Model Inference on a GPU" data-hid="citation_title-2069617"><meta name="citation_publication_date" content="2026/10" data-hid="citation_publication_date-