                                                                    <a href="/search?q=large+language+models" class="html-keywords-link">large language models</a>;                    <a href="/search?q=LLM+inference" class="html-keywords-link">LLM inference</a>;                    <a href="/search?q=weight+quantization" class="html-keywords-link">weight quantization</a>;                    <a href="/search?q=GPU+energy+consumption" class="html-keywords-link">GPU energy consumption</a>;                    <a href="/search?q=energy+efficiency" class="html-keywords-link">energy efficiency</a>;                    <a href="/search?q=inference+throughput" class="html-keywords-link">inference throughput</a>;                    <a href="/search?q=TOPSIS" class="html-keywords-link">TOPSIS</a>;                    <a href="/search?q=Pareto+optimization" class="html-keywords-link">Pareto optimization</a>        </div>

