<span id="A2.T4.4.1.1.1.1.1.5.2" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">27.5/199</span>
<span id="A2.T4.4.1.1.1.1.1.5.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">31/199</span>
<span id="A2.T4.4.1.1.1.1.1.5.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;">13</span>
