<span id="A2.T5.6.1.1.1.1.1.1.1.10" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">ratio</span></span>
<span id="A2.T5.6.1.1.1.1.1.1.2" class="ltx_tr">
<span id="A2.T5.6.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Uncompressed agent</span>
