<td id="S4.T4.fig1.5.1.7.5" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T4.fig1.5.1.7.5.1" class="ltx_text" style="font-size:90%;">73.3 </span><math id="S4.T4.m15" class="ltx_Math" alttext="\pm 2.4" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#81746F;" mathcolor="#81746F" mathsize="0.900em">±</mo><mn style="--ltx-fg-color:#81746F;" mathcolor="#81746F" mathsize="0.900em">2.4</mn></mrow><annotation encoding="application/x-tex">\pm 2.4</annotation></semantics></math></td></tr>
