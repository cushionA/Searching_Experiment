            <span id="alg2.l11.3" class="ltx_text" style="font-size:90%;"> Add </span><math id="alg2.l11.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math><span id="alg2.l11.4" class="ltx_text" style="font-size:90%;"> to </span><math id="alg2.l11.m2" class="ltx_Math" alttext="\mathrm{p}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">p</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{p}(\cdot)</annotation></semantics></math><span id="alg2.l11.5" class="ltx_text" style="font-size:90%;">’s prototypes store, internal to the local device </span><span id="alg2.l11.6" class="ltx_text" style="font-size:90%;float:right;"><span id="alg2.l11.6.1" class="ltx_text ltx_font_typewriter" style="font-size:89%;--ltx-fg-color:#A0512D;"># Prototype classifier training</span>
