            <span id="alg1.l0.3" class="ltx_text" style="font-size:90%;"> Pretrained detection model </span><math id="alg1.l0.m1" class="ltx_Math" alttext="\mathrm{m}_{S}=\mathrm{l}_{S}\circ\mathrm{g}_{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">S</mi></msub><mo mathsize="0.900em">=</mo><mrow><msub><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">S</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">∘</mo><msub><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">S</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathrm{m}_{S}=\mathrm{l}_{S}\circ\mathrm{g}_{S}</annotation></semantics></math><span id="alg1.l0.4" class="ltx_text" style="font-size:90%;">, visual encoder </span><math id="alg1.l0.m2" class="ltx_Math" alttext="\mathrm{g}_{T}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">T</mi></msub><annotation encoding="application/x-tex">\mathrm{g}_{T}</annotation></semantics></math><span id="alg1.l0.5" class="ltx_text" style="font-size:90%;">, language model </span><math id="alg1.l0.m3" class="ltx_Math" alttext="\mathrm{f}_{T}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">T</mi></msub><annotation encoding="application/x-tex">\mathrm{f}_{T}</annotation></semantics></math><span id="alg1.l0.6" class="ltx_text" style="font-size:90%;"> dataset </span><math id="alg1.l0.m4" class="ltx_Math" alttext="\mathcal{D}_{c}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">c</mi></msub><annotation encoding="application/x-tex">\mathcal{D}_{c}</annotation></semantics></math><span id="alg1.l0.7" class="ltx_text" style="font-size:90%;">, translation module </span><math id="alg1.l0.m5" class="ltx_Math" alttext="\mathrm{t}_{S}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">S</mi></msub><annotation encoding="application/x-tex">\mathrm{t}_{S}</annotation></semantics></math><span id="alg1.l0.8" class="ltx_text" style="font-size:90%;">, batch size </span><math id="alg1.l0.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="alg1.l0.9" class="ltx_text" style="font-size:90%;">, number of epochs </span><math id="alg1.l0.m7" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="alg1.l0.10" class="ltx_text" style="font-size:90%;">
</span>
