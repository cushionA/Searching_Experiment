<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:90%;"><span class="ltx_tag ltx_tag_float"><span id="alg3.5" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Pseudocode for MOCHA’s FSL inference.</figcaption>
<div id="alg3.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l0" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
              
              
            <span id="alg3.l0.3" class="ltx_text" style="font-size:90%;"> Frozen distilled model </span><math id="alg3.l0.m1" class="ltx_Math" alttext="\mathrm{m}_{S}=\mathrm{l}_{S}\circ\mathrm{g}_{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">S</mi></msub><mo mathsize="0.900em">=</mo><mrow><msub><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">S</mi></msub><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">∘</mo><msub><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">S</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathrm{m}_{S}=\mathrm{l}_{S}\circ\mathrm{g}_{S}</annotation></semantics></math><span id="alg3.l0.4" class="ltx_text" style="font-size:90%;">, frozen translator </span><math id="alg3.l0.m2" class="ltx_Math" alttext="\mathrm{t}_{S}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">S</mi></msub><annotation encoding="application/x-tex">\mathrm{t}_{S}</annotation></semantics></math><span id="alg3.l0.5" class="ltx_text" style="font-size:90%;">, trained prototype classifier </span><math id="alg3.l0.m3" class="ltx_Math" alttext="\mathrm{p}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">p</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{p}(\cdot)</annotation></semantics></math><span id="alg3.l0.6" class="ltx_text" style="font-size:90%;">, image </span><math id="alg3.l0.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="alg3.l0.7" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg3.l1.3" class="ltx_text" style="font-size:90%;"> </span><math id="alg3.l1.m1" class="ltx_Math" alttext="\{F_{j}\}\leftarrow\mathrm{g}_{S}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">j</mi></msub><mo stretchy="false">}</mo></mrow><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">X</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{F_{j}\}\leftarrow\mathrm{g}_{S}(X)</annotation></semantics></math><span id="alg3.l1.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg3.l1.5" class="ltx_text" style="font-size:90%;float:right;"><span id="alg3.l1.5.1" class="ltx_text ltx_font_typewriter" style="font-size:89%;--ltx-fg-color:#A0512D;"># Extract multiscale features</span>
</span>
</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg3.l2.3" class="ltx_text" style="font-size:90%;"> </span><math id="alg3.l2.m1" class="ltx_Math" alttext="\hat{\mathcal{Y}}\leftarrow\mathrm{l}_{S}(\{F_{j}\})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒴</mi><mo>^</mo></mover><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">l</mi><mi mathsize="0.900em">S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">j</mi></msub><mo stretchy="false">}</mo></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{Y}}\leftarrow\mathrm{l}_{S}(\{F_{j}\})</annotation></semantics></math><span id="alg3.l2.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg3.l2.5" class="ltx_text" style="font-size:90%;float:right;"><span id="alg3.l2.5.1" class="ltx_text ltx_font_typewriter" style="font-size:89%;--ltx-fg-color:#A0512D;"># Compute detection predictions for general classes</span>
</span>
</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg3.l3.3" class="ltx_text" style="font-size:90%;"> </span><span id="alg3.l3.4" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg3.l3.5" class="ltx_text" style="font-size:90%;"> </span><math id="alg3.l3.m1" class="ltx_Math" alttext="(\hat{b}_{i},\hat{c}_{i})\in\hat{\mathcal{Y}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mover accent="true"><mi mathsize="0.900em">b</mi><mo>^</mo></mover><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</mo><msub><mover accent="true"><mi mathsize="0.900em">c</mi><mo>^</mo></mover><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">∈</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒴</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">(\hat{b}_{i},\hat{c}_{i})\in\hat{\mathcal{Y}}</annotation></semantics></math><span id="alg3.l3.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg3.l3.7" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg3.l3.8" class="ltx_text" style="font-size:90%;">   # </span><math id="alg3.l3.m2" class="ltx_Math" alttext="\hat{\mathcal{Y}}\subset\mathcal{B}\times\mathcal{C}_{c}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒴</mi><mo>^</mo></mover><mo mathsize="0.900em">⊂</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℬ</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒞</mi><mi mathsize="0.900em">c</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{Y}}\subset\mathcal{B}\times\mathcal{C}_{c}</annotation></semantics></math><span id="alg3.l3.9" class="ltx_text" style="font-size:90%;">


</span>
</div>
