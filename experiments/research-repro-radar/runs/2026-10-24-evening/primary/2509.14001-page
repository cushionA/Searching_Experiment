            <span id="alg3.l4.3" class="ltx_text" style="font-size:90%;">   Use </span><math id="alg3.l4.m1" class="ltx_Math" alttext="\hat{b}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathsize="0.900em">b</mi><mo>^</mo></mover><mi mathsize="0.900em">i</mi></msub><annotation encoding="application/x-tex">\hat{b}_{i}</annotation></semantics></math><span id="alg3.l4.4" class="ltx_text" style="font-size:90%;"> to crop region </span><math id="alg3.l4.m2" class="ltx_Math" alttext="F_{A,j,i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">F</mi><mrow><mi mathsize="0.900em">A</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">j</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">i</mi></mrow></msub><annotation encoding="application/x-tex">F_{A,j,i}</annotation></semantics></math><span id="alg3.l4.5" class="ltx_text" style="font-size:90%;"> from </span><math id="alg3.l4.m3" class="ltx_Math" alttext="F_{j}\;\;\forall j" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">F</mi><mi mathsize="0.900em">j</mi></msub><mo lspace="0.727em" rspace="0em">​</mo><mrow><mo mathsize="0.900em" rspace="0.167em">∀</mo><mi mathsize="0.900em">j</mi></mrow></mrow><annotation encoding="application/x-tex">F_{j}\;\;\forall j</annotation></semantics></math><span id="alg3.l4.6" class="ltx_text" style="font-size:90%;">
