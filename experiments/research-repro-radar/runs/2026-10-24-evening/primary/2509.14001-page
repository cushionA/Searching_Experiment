<td id="S4.T1.10.1.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T1.10.1.3.10.1" class="ltx_text" style="font-size:90%;">59.9</span></td></tr>
<tr id="S4.T1.10.1.4" class="ltx_tr">
