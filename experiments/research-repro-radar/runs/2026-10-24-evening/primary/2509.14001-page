</span></th>
<td id="Pt0.A4.T9.6.1.13.3" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="Pt0.A4.T9.6.1.13.3.1" class="ltx_text" style="font-size:90%;">22.8 </span><math id="Pt0.A4.T9.m26" class="ltx_Math" alttext="\pm 2.9" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#81746F;" mathcolor="#81746F" mathsize="0.900em">±</mo><mn style="--ltx-fg-color:#81746F;" mathcolor="#81746F" mathsize="0.900em">2.9</mn></mrow><annotation encoding="application/x-tex">\pm 2.9</annotation></semantics></math></td>
<td id="Pt0.A4.T9.6.1.13.4" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="Pt0.A4.T9.6.1.13.4.1" class="ltx_text" style="font-size:90%;">9.6 </span><math id="Pt0.A4.T9.m27" class="ltx_Math" alttext="\pm 2.0" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#81746F;" mathcolor="#81746F" mathsize="0.900em">±</mo><mn style="--ltx-fg-color:#81746F;" mathcolor="#81746F" mathsize="0.900em">2.0</mn></mrow><annotation encoding="application/x-tex">\pm 2.0</annotation></semantics></math></td></tr>
