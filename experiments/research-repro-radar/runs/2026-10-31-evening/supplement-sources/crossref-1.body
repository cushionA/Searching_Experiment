component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4103","asserted-by":"object"}]}},{"DOI":"10.7717\/peerj-cs.4033\/supp-1","title":["Supplemental Information 1: Feature Extraction using BOW Method."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4033\/supp-1","created":{"date-parts":[[2026,10,23]],"date-time":"2026-10-23T08:00:23Z","timestamp":1792742423000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4033","asserted-by":"object"}]}},{"DOI":"10.1007\/s11128-026-05342-7","title":["Gate teleportation using noisy gates"],"author":[{"given":"Imama Tul Birrah","family":"Khan","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Muhammad","family":"Faryad","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/s11128-026-05342-7","published":{"date-parts":[[2026,9,24]]},"created":{"date-parts":[[2026,9,24]],"date-time":"2026-09-24T01:50:57Z","timestamp":1790214657000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s11128-026-05342-7.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/article\/10.1007\/s11128-026-05342-7","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s11128-026-05342-7.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.18653\/2026.wnut-1.18","title":["QueryDiagramEval: Evaluating and Benchmarking LLM Diagram Generation under Noisy Conditions"],"author":[{"given":"Ted","family":"Zhang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Souvik","family":"Das","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Kai","family":"Ni","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Aditya","family":"Agrawal","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xin","family":"Guo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Denis","family":"Kochedykov","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.18653\/2026.wnut-1.18","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T16:16:38Z","timestamp":1793290598000}},{"DOI":"10.1109\/iciss71466.2026.11715055","title":["Robustness of Sensitive Data Detection Against Indonesian Noisy Text in Shadow AI"],"author":[{"given":"Grace Esther","family":"Simanjuntak","sequence":"first","affiliation":[{"name":"School of Computer Science Bina Nusantara University","place":["Jakarta, Indonesia"],"department":["Computer Science Department"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Kuncahyo","family":"Setyo Nugroho","sequence":"additional","affiliation":[{"name":"Bina Nusantara University","place":["Jakarta, Indonesia"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mahmud","family":"Isnan","sequence":"additional","affiliation":[{"name":"School of Computer Science Bina Nusantara University","place":["Jakarta, Indonesia"],"department":["Computer Science Department"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Bens","family":"Pardamean","sequence":"additional","affiliation":[{"name":"BINUS Graduate Program \u2013 Master of Computer Science","place":["Jakarta, Indonesia"],"department":["Computer Science Department"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/iciss71466.2026.11715055","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,2]],"date-time":"2026-10-02T19:05:04Z","timestamp":1790967904000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11715014\/11715016\/11715055.pdf?arnumber=11715055","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.7717\/peerj-cs.4084\/supp-5","title":["Supplemental Information 5: Implements advanced player-interaction feature extraction."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4084\/supp-5","created":{"date-parts":[[2026,9,14]],"date-time":"2026-09-14T08:15:24Z","timestamp":1789373724000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4084","asserted-by":"object"}]}},{"DOI":"10.1016\/j.ipm.2026.105204","title":["Label-Corrected Weighted Multi-Similarity Loss for noisy cross-modal retrieval"],"author":[{"given":"Shuni","family":"Jiang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shiyuan","family":"Yang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5313-6134","authenticated-orcid":false,"given":"Zhixin","family":"Li","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.ipm.2026.105204","published":{"date-parts":[[2027,2]]},"created":{"date-parts":[[2026,10,1]],"date-time":"2026-10-01T07:37:16Z","timestamp":1790840236000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0306457326005947?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0306457326005947?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.7717\/peerj-cs.4141\/fig-1","title":["Figure 1: General flowchart of EdFitter, combining frozen text-embedding retrieval over the institutional course catalog with offline LLM-based skill extraction."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4141\/fig-1","created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T08:10:21Z","timestamp":1793261421000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4141","asserted-by":"object"}]}},{"DOI":"10.1109\/access.2026.3732383\/mm1","title":["Input-Data Information Preservation and Protocol-Specific Error Mitigation in Noisy Fixed-Parameter Quantum Front Ends: A Reproducible Simulation Study_supp1-3732383.pdf"],"author":[{"given":"Hongmin","family":"Jung","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3732383\/mm1","created":{"date-parts":[[2026,9,11]],"date-time":"2026-09-11T19:03:39Z","timestamp":1789153419000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.1109\/ACCESS.2026.3732383","asserted-by":"object"}]}},{"DOI":"10.7717\/peerj-cs.4033\/supp-2","title":["Supplemental Information 2: Feature Extraction using LDA Topic Modelling Method."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4033\/supp-2","created":{"date-parts":[[2026,10,23]],"date-time":"2026-10-23T08:00:23Z","timestamp":1792742423000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4033","asserted-by":"object"}]}},{"DOI":"10.1109\/icosdia70683.2026.11690457","title":["Evaluating the Robustness of Multilingual Transformer Models on Low-Resource Language Under Real-World Noisy Text Conditions"],"author":[{"given":"Kevin Maxwell","family":"Andreas","sequence":"first","affiliation":[{"name":"Bina Nusantara University","place":["Jakarta, Indonesia"],"department":["Computer Science Department"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Keane","family":"Clement","sequence":"additional","affiliation":[{"name":"Bina Nusantara University","place":["Jakarta, Indonesia"],"department":["Computer Science Department"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Rani","family":"Puspita","sequence":"additional","affiliation":[{"name":"Bina Nusantara University","place":["Jakarta, Indonesia"],"department":["Computer Science Department"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/icosdia70683.2026.11690457","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,9,18]],"date-time":"2026-09-18T19:29:06Z","timestamp":1789759746000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11690412\/11689899\/11690457.pdf?arnumber=11690457","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.23919\/fusion67272.2026.11726623","title":["Distant Object Localisation from Noisy Image Segmentation Sequences"],"author":[{"given":"Julius","family":"Pesonen","sequence":"first","affiliation":[{"name":"Aalto University","place":["Espoo, Finland"],"department":["Dept. of Remote Sensing and Photogrammetry"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Arno","family":"Solin","sequence":"additional","affiliation":[{"name":"Aalto University","place":["Espoo, Finland"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Eija","family":"Honkavaara","sequence":"additional","affiliation":[{"name":"Finnish Geospatial Research Institute","place":["Espoo, Finland"],"department":["Dept. of Remote Sensing and Photogrammetry"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.23919\/fusion67272.2026.11726623","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,27]],"date-time":"2026-10-27T19:09:53Z","timestamp":1793128193000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11726356\/11726375\/11726623.pdf?arnumber=11726623","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.18653\/2026.wnut-1.10","title":["How Noisy is Automatic Annotation? Characterizing Label Noise from Generative Models in Multi-Dimensional Spanish Subjectivity Annotation"],"author":[{"given":"Alba","family":"P\u00e9rez-Montero","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Elena","family":"Lloret","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Paloma","family":"Moreda Pozo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.18653\/2026.wnut-1.10","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T16:16:38Z","timestamp":1793290598000}},{"DOI":"10.1117\/12.3121516","title":["Machine learning based terbium fluorescence spectra extraction for noisy, resolution compromised document verification systems"],"author":[{"given":"Craig","family":"Stewart","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Asha","family":"Venkatesh","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Radhakrishna","family":"Prabhu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1117\/12.3121516","published":{"date-parts":[[2026,10,30]]},"created":{"date-parts":[[2026,9,11]],"date-time":"2026-09-11T16:24:51Z","timestamp":1789143891000}},{"DOI":"10.2139\/ssrn.7661825","title":["TCSR-GSL: Graph Structure Learning in Noisy Information Networksvia Triangular Relational Consistency and Spectral Regularization"],"author":[{"given":"Zhi","family":"Dong","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xinglin","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hongyu","family":"Sun","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3288-5195","authenticated-orcid":true,"given":"Ying","family":"Wang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Semi-supervised node classification in real-world information networks draws on graph topology, node attributes, and a small set of labels. Current Graph Structure Learning (GSL) methods tend to process these sources separately or allow them to interact only through node-level prediction losses. As a result, consistency among the pairwise relations induced by topology, representations, and labels is not directly constrained. The global spectral behavior of the learned graph also receives little explicit control. We present TCSR-GSL, a framework that couples relation-level structure learning with spectral regularization. The model first infers an attribute-based structural component and progressively blends it with the observed topology. It then casts topology, node representations, and label supervision as pairwise relations and aligns the three relation spaces with a triangular consistency objective. High-confidence pseudo-labels are gradually admitted to extend these constraints beyond labeled nodes, while confidence-based weighting limits the influence of uncertain predictions. Spectral regularization further preserves selected low-frequency propagation modes, controls irregular spacing outside the protected spectral region, and penalizes excessive upper-tail responses. During training, opposing weight schedules gradually reduce the emphasis on relational consistency while strengthening spectral regularization, shifting the optimization from early semantic alignment toward global frequency-response conditioning as the learned structure becomes more stable. Experiments on six benchmark datasets show that TCSR-GSL achieves the highest mean node-classification accuracy on every dataset, with an average absolute gain of $0.62$ percentage points over the strongest competing method, and remains robust under severe label scarcity and topology perturbations.<\/jats:p>","URL":"https:\/\/doi.org\/10.2139\/ssrn.7661825","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,23]],"date-time":"2026-10-23T14:40:14Z","timestamp":1792766414000}},{"abstract":"<jats:p>Arabic morphological analysis remains a central challenge for natural language processing (NLP). This challenge is embedded within the complex, rich, and multi-layered morphology of Arabic, where orthographic words encode enclitics, root-and-pattern derivations, and other morphosyntactic features. Another dimension of complexity is the coexistence of different varieties of Arabic, including Modern Standard Arabic (MSA), Classical Arabic (CA), and Dialectal Arabic (DA). In this four-phase empirical investigation of Arabic, a new, standardized CoNLL-U benchmark integrating the Arabella corpus (MSA) and the MASAQ corpus (CA) was evaluated across different settings. This paper aims to build a baseline morphological analyzer by evaluating a wider range of supervised systems, including lexicon-lookup, Conditional Random Fields (CRFs), full fine-tuning of Arabic PLMs, and AraT5 configurations. A parameter-efficient LoRA adaptation of QARiB was implemented, preserving most UPOS performance with minor differences. The results of the comparative evaluation of a variety of models across all settings were reported, and significant results were emphasized. The findings demonstrate severe limitations in current capabilities, particularly that cross-domain transfer for fine-grained language-specific tags (XPOS) remains difficult. Also, models struggle with the asymmetry of cross-register transfer, as moving from Classical to Modern Arabic exposes a lack of coverage for modern named entities and punctuation.<\/jats:p>","DOI":"10.3390\/info17100934","created":{"date-parts":[[2026,9,22]],"date-time":"2026-09-22T15:28:43Z","timestamp":1790090923000},"title":["A Supervised Morphosyntactic Analyzer for Modern and Classical Arabic Text"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0003-4975-6709","authenticated-orcid":false,"given":"Majdi","family":"Sawalha","sequence":"first","affiliation":[{"name":"Department of Artificial Intelligence, King Abdullah II School of Information Technology, The University of Jordan, Amman 11942, Jordan"},{"name":"College of Computing and Intelligent Systems, University of Khorfakkan, Khor Fakkan, Sharjah 18119, United Arab Emirates"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.mdpi.com\/2078-2489\/17\/10\/934\/pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.3390\/info17100934","published":{"date-parts":[[2026,9,22]]}},{"DOI":"10.30970\/eli.35.3","title":["COMPRESSION COEFFICIENT IN THE ANALYSIS OF NOISY TEXTS AND IMAGES"],"author":[{"given":"Oleksii","family":"Kravchuk","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Oleh","family":"Kushnir","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.30970\/eli.35.3","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,28]],"date-time":"2026-10-28T16:22:23Z","timestamp":1793204543000}},{"DOI":"10.7717\/peerj-cs.4065\/supp-2","title":["Supplemental Information 2: Example of the data extraction applied in the study."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4065\/supp-2","created":{"date-parts":[[2026,9,24]],"date-time":"2026-09-24T08:00:27Z","timestamp":1790236827000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4065","asserted-by":"object"}]}},{"DOI":"10.1016\/j.ic.2026.105537","title":["A general information extraction framework based on formal languages"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0001-5137-1504","authenticated-orcid":false,"given":"Markus L.","family":"Schmid","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.ic.2026.105537","published":{"date-parts":[[2026,12]]},"created":{"date-parts":[[2026,10,7]],"date-time":"2026-10-07T16:08:42Z","timestamp":1791389322000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0890540126001343?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0890540126001343?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.35377\/saucis...1818229","title":["A Text Scam Detection Model Using Text-To-Text Transfer Transformer Architecture"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0007-8528-6720","authenticated-orcid":false,"given":"Sani","family":"Sammani Sani","sequence":"first","affiliation":[{"name":"Federal University Wukari"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0009-5437-4431","authenticated-orcid":false,"given":"Aliyu","family":"Isah Agaie","sequence":"additional","affiliation":[{"name":"Bayero University Kano"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0001-4040-8209","authenticated-orcid":false,"given":"Kabir","family":"Umar","sequence":"additional","affiliation":[{"name":"Bayero University Kano"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">The increase in the complexity of text message fraud in online communication endangers privacy, financial stability and user confidence. The traditional approaches to detection, like rule-based systems, keyword matching, and statistical classifiers, have difficulties in adapting to new scam techniques: they tend to end up with high false positive and false negative rates. The proposed work is the development of an improved scam detector using the Text to Text Transfer Transformer (T5) architecture with the Sentence -T5 encoding for semantic data compression. The proposed model was optimized using data comprised of the Kaggle benchmark dataset and scam messages that were previously unseen (collected and directly fed to the model using crowd sourcing and web scraping). Experiments were conducted, and the results were compared with Na\u00a8\u0131ve Bayes, SVM, Decision Tree, Random Forest, LSTM, Logistic Regression and K Nearest Neighbor. The comparative experiments have shown that the proposed model achieved 98% in all aspects of accuracy, precision, recall, and F1 Score, performing better than all the other baseline models. The proposed model displayed good generalization across unseen scam variations and, therefore, can be applied in secure messaging infrastructures. This work presents a robust and scalable, context-aware method to address performance and adaptability problems associated with fraud detection.<\/jats:p>","URL":"https:\/\/doi.org\/10.35377\/saucis...1818229","published":{"date-parts":[[2026,10,27]]},"created":{"date-parts":[[2026,10,27]],"date-time":"2026-10-27T20:30:21Z","timestamp":1793133021000}},{"DOI":"10.4208\/jics.v4.n2.p115","title":["A Hilbert Transform N-Dimensional Noisy Phase Unwrapping Algorithm"],"author":[{"family":"Abbas Hasan Kattoush","sequence":"first","affiliation":[{"name":"Department of Communications and Computer Engineering, Tafila Technical University"},{"name":"Tafila, Jordan"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Phase  unwrapping  arises  as  a  key  step  in  several  imaging  technologies,  from  which  we \nemphasize  remote  sensing  applications  like  terrain  analysis  and  generation,  topographic  mapping, \ninterferometric synthetic aperture radar (ISAR). Due to various decorrelation factors, there is much noise in \nphase images. Phase noise degrades the visual quality of images and interferograms, increases the errors of \nresults  derived  from  the  ISAR  interferogram,  and  obstruct  phase  unwrapping.  Hilbert  transform  (HT)  as  a \nphase  unwrapping  techniques  was  recently  proposed,  and  its  behavior  in  presence  of  noise  is  unknown.  In \nthis paper, one-dimensional (1-D) HT phase unwrapping algorithm is proposed to detect and eliminate phase \ndiscontinuities  in  N-dimensional  (N-D)  noisy  phase  arrays.  The  behavior  of  this  method  in  presence  of \ndifferent noise levels is studied and compared with the other approach of phase jump detection. The phase \nnoise  filtration  problem  and  its  effect  on  proposed  algorithm  behavior  are  considered.  Tests  of  method \npresented illustrate the validity and effectiveness of proposed algorithm for difficult problems with noisy and \ndiscontinuous original phases.<\/jats:p>","URL":"https:\/\/doi.org\/10.4208\/jics.v4.n2.p115","published":{"date-parts":[[2009]]},"created":{"date-parts":[[2026,9,29]],"date-time":"2026-09-29T10:37:26Z","timestamp":1790678246000}},{"DOI":"10.70675\/82a04821za958z4c01z8819z430d27248518","title":["Information Extraction for Integrating Multidisciplinary Articles to Co-construct Coastal Knowledge"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0001-9247-5745","authenticated-orcid":false,"given":"Julien","family":"Delaunay","sequence":"first","affiliation":[{"id":[{"id":"https:\/\/ror.org\/04mv1z119","id-type":"ROR","asserted-by":"publisher"}],"name":"La Rochelle"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:title>Extraction d'informations pour l'int\u00e9gration d'articles multidisciplinaires en vue de la co-construction de connaissances sur les zones c\u00f4ti\u00e8res<\/jats:title>\n                <jats:p xml:lang=\"fr\">Les zones c\u00f4ti\u00e8res, parmi les syst\u00e8mes les plus dynamiques et complexes sur Terre, font face \u00e0 des pressions environnementales croissantes en raison des activit\u00e9s anthropiques et du changement global. La croissance des activit\u00e9s c\u00f4ti\u00e8res a g\u00e9n\u00e9r\u00e9 des int\u00e9r\u00eats concurrents et une fragmentation dans le d\u00e9veloppement c\u00f4tier, conduisant \u00e0 des conflits d'utilisation des terres et \u00e0 une comp\u00e9tition pour les ressources naturelles. Le d\u00e9veloppement rapide des r\u00e9gions c\u00f4ti\u00e8res a eu des cons\u00e9quences environnementales substantielles, incluant des perturbations \u00e9cologiques, de la pollution et une vuln\u00e9rabilit\u00e9 accrue aux al\u00e9as naturels. L'expansion du tourisme et de l'urbanisation a encore exacerb\u00e9 ces d\u00e9fis, affectant de mani\u00e8re disproportionn\u00e9e les communaut\u00e9s pauvres et vuln\u00e9rables. Atteindre une compr\u00e9hension compl\u00e8te du fonctionnement g\u00e9n\u00e9ral du syst\u00e8me n\u00e9cessite une int\u00e9gration approfondie des connaissances interdisciplinaires. Cependant, les connexions interdisciplinaires sont complexes en raison de l'incompatibilit\u00e9 des entr\u00e9es et des sorties \u00e0 travers diff\u00e9rentes disciplines. Cette th\u00e8se pose les bases d'un syst\u00e8me con\u00e7u pour construire automatiquement une base de connaissances interdisciplinaire (KB) ax\u00e9e sur les r\u00f4les de diverses entit\u00e9s au sein des syst\u00e8mes littoraux en utilisant le Deep Learning. Les contributions cl\u00e9s incluent l'analyse de l'\u00e9volution de la recherche c\u00f4ti\u00e8re de 1970 \u00e0 2023, l'\u00e9tude de l'application du cadre ARDI (Acteur, Ressource, Dynamique, Interaction) pour guider la strat\u00e9gie d'annotation, l'emploi de l'extraction automatique de termes (ATE) et de l'extraction de relations au niveau du document (DocRE) pour identifier les termes cl\u00e9s et extraire simultan\u00e9ment les entit\u00e9s et leurs relations \u00e0 partir du jeu de donn\u00e9es. Le manuscrit est organis\u00e9 en sept chapitres, \u00e9tablissant le cadre contextuel et les motivations sous-jacentes \u00e0 la th\u00e8se, fournissant une revue compl\u00e8te de l'\u00e9tat de l'art, pr\u00e9sentant une analyse scientom\u00e9trique de la production de recherche c\u00f4ti\u00e8re, d\u00e9limitant le processus d'annotation du jeu de donn\u00e9es, d\u00e9crivant la m\u00e9thodologie et les r\u00e9sultats de l'ATE, et introduisant le mod\u00e8le pour l'extraction simultan\u00e9e des entit\u00e9s et de leurs relations. La th\u00e8se conclut avec une discussion des r\u00e9sultats et de leurs implications pour la recherche future et la gestion c\u00f4ti\u00e8re.<\/jats:p>","URL":"https:\/\/doi.org\/10.70675\/82a04821za958z4c01z8819z430d27248518","created":{"date-parts":[[2026,9,2]],"date-time":"2026-09-02T15:40:08Z","timestamp":1788363608000}},{"DOI":"10.7717\/peerj-cs.4114\/supp-3","title":["Supplemental Information 3: Summary of the full-text eligibility assessment stage and coded exclusion reasons."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4114\/supp-3","created":{"date-parts":[[2026,10,12]],"date-time":"2026-10-12T08:45:22Z","timestamp":1791794722000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4114","asserted-by":"object"}]}},{"abstract":"<jats:p>Stylometric features and frozen sentence-transformer embeddings are widely used as low-cost inputs for misinformation-related text classification, but heterogeneous benchmark tasks are rarely compared under a common protocol. We evaluated term frequency\u2013inverse document frequency (TF-IDF), a 22-feature stylometric battery, frozen sentence-BERT, and fine-tuned RoBERTa on 15 English-language benchmarks (n = 24,906), including five human\u2013AI provenance corpora. A descriptive partition of the raw area under the receiver operating characteristic curve (AUC) values attributed 71.8% of the total sum of squares to task category means and 13.7% to benchmarks within categories; an exact benchmark label permutation yielded p = 0.000161, but category remained confounded with benchmark construction, source, domain, label mapping, and sampling. After correcting three label orientations, the mean off-diagonal transfer AUC was 0.492 for stylometry and 0.507 for sentence-BERT. Retained-character matching reduced the length-only AUC to approximately 0.50, while low-cost methods retained AUCs of 0.779\u20130.999 in four estimable human\u2013AI benchmarks; AITextPile lacked common support. Alternative LIAR\/LIAR2 mappings changed individual estimates and method ordering. Random intake sensitivity was method-dependent: the MAGE length-only AUC fell from 0.936 to a median of 0.476 and AITextPile from 1.000 to 0.560. The results support benchmark- and target-domain-specific validation, not a universal misinformation or AI-text detector.<\/jats:p>","DOI":"10.3390\/info17090866","created":{"date-parts":[[2026,9,8]],"date-time":"2026-09-08T09:02:24Z","timestamp":1788858144000},"title":["Benchmark-Task Heterogeneity in Misinformation-Related and Human\u2013AI Text Classification"],"author":[{"given":"Grzegorz","family":"\u015awierk","sequence":"first","affiliation":[{"name":"Faculty of Humanities, AGH University of Krakow, ul. Czarnowiejska 36, 30-054 Krak\u00f3w, Poland"}],"role":[{"vocabulary":"crossref","role":"author"},{"role":"software","vocabulary":"credit"},{"role":"conceptualization","vocabulary":"credit"},{"role":"visualization","vocabulary":"credit"},{"role":"formal-analysis","vocabulary":"credit"},{"role":"writing-original-draft","vocabulary":"credit"},{"role":"validation","vocabulary":"credit"},{"role":"methodology","vocabulary":"credit"},{"role":"investigation","vocabulary":"credit"},{"role":"data-curation","vocabulary":"credit"},{"role":"writing-review-editing","vocabulary":"credit"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-4494-3890","authenticated-orcid":false,"given":"Rafa\u0142","family":"Olszowski","sequence":"additional","affiliation":[{"name":"Faculty of Humanities, AGH University of Krakow, ul. Czarnowiejska 36, 30-054 Krak\u00f3w, Poland"}],"role":[{"vocabulary":"crossref","role":"author"},{"role":"supervision","vocabulary":"credit"},{"role":"writing-review-editing","vocabulary":"credit"},{"role":"conceptualization","vocabulary":"credit"}]}],"link":[{"URL":"https:\/\/www.mdpi.com\/2078-2489\/17\/9\/866\/pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.3390\/info17090866","published":{"date-parts":[[2026,9,8]]}},{"DOI":"10.1109\/tit.2026.3741662","title":["The Fixed-\n                    <i>k<\/i>\n                    Quantization Problem for Noisy Binary Sources"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0001-7305-9968","authenticated-orcid":false,"given":"Taleb","family":"Moazzeni","sequence":"first","affiliation":[{"name":"Global College of Engineering and Technology","place":["Muscat, Oman"],"department":["Department of Electrical and Electronics Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/tit.2026.3741662","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:07:40Z","timestamp":1791486460000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/18\/4667673\/11727094.pdf?arnumber=11727094","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1007\/978-3-031-87993-7_675-1","title":["Environmental Law and Terminology: Knowledge Extraction and Representation"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-7264-4580","authenticated-orcid":false,"given":"Arianne","family":"Reimerink","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-031-87993-7_675-1","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,17]],"date-time":"2026-09-17T02:12:57Z","timestamp":1789611177000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-031-87993-7_675-1","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.7717\/peerj-cs.4114\/supp-8","title":["Supplemental Information 8: Consolidated extraction matrix for the studies included in the final review."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4114\/supp-8","created":{"date-parts":[[2026,10,12]],"date-time":"2026-10-12T08:45:22Z","timestamp":1791794722000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4114","asserted-by":"object"}]}},{"DOI":"10.70675\/b446e74fz158dz4bb3z88f7z71c5cf708e55","title":["From Document to Decision : Neurosymbolic Approaches for Information Extraction from Transactional Documents"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0006-7550-2568","authenticated-orcid":false,"given":"Arthur","family":"Hemmer","sequence":"first","affiliation":[{"id":[{"id":"https:\/\/ror.org\/04mv1z119","id-type":"ROR","asserted-by":"publisher"}],"name":"La Rochelle"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:title>Du document \u00e0 la d\u00e9cision : approches neurosymboliques pour l\u2019extraction d\u2019informations \u00e0 partir de documents transactionnels<\/jats:title>\n                <jats:p xml:lang=\"fr\">Cette th\u00e8se porte sur l\u2019am\u00e9lioration de l\u2019extraction d\u2019informations \u00e0 partir de documents en corrigeant les erreurs gr\u00e2ce \u00e0 l\u2019utilisation de connaissances pr\u00e9alables sp\u00e9cifiques au domaine. Elle se concentre sur les documents transactionnels tels que les factures, re\u00e7us et devis, pour lesquels nous formulons des contraintes symboliques permettant de v\u00e9rifier l\u2019exactitude des extractions. Ce m\u00e9canisme de validation sert alors de signal pour explorer des hypoth\u00e8ses d\u2019extraction alternatives jusqu\u2019\u00e0 en identifier une valide. Les hypoth\u00e8ses alternatives proviennent \u00e0 la fois de la reconnaissance optique de caract\u00e8res et de l\u2019\u00e9tape d\u2019extraction d\u2019informations dans la cha\u00eene de traitement documentaire. La validation est \u00e9galement appliqu\u00e9e aux mod\u00e8les de bout en bout via la g\u00e9n\u00e9ration de donn\u00e9es synth\u00e9tiques, o\u00f9 les exemples invalides sont filtr\u00e9s et les exemples restants, de haute qualit\u00e9, sont utilis\u00e9s pour affiner les mod\u00e8les. Les r\u00e9sultats montrent que les approches neurosymboliques permettent d\u2019obtenir une meilleure pr\u00e9cision, en particulier dans des contextes frugaux, la qualit\u00e9 des contraintes jouant alors un r\u00f4le d\u00e9terminant.<\/jats:p>","URL":"https:\/\/doi.org\/10.70675\/b446e74fz158dz4bb3z88f7z71c5cf708e55","created":{"date-parts":[[2026,9,4]],"date-time":"2026-09-04T12:57:46Z","timestamp":1788526666000}},{"DOI":"10.7717\/peerj-cs.4103\/supp-19","title":["Supplemental Information 19: Training and validation curves of the YOLOv8-small model for text region detection."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4103\/supp-19","created":{"date-parts":[[2026,10,13]],"date-time":"2026-10-13T08:12:34Z","timestamp":1791879154000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4103","asserted-by":"object"}]}},{"abstract":"<jats:p>The object of the study is the process of lossy compression of noisy grayscale images by modern coders based on discrete cosine transform using several quality metrics. The subject of the study is the method to determine parameters that control compression to provide the highest quality of compressed images or the best compression ratio for the considered type of images.The goal of the study is to analyze performance characteristics for test images of different complexity and produce recommendations concerning the coder selection and its parameters setting. Methods used: numerical simulation, verification for a set of test images. Results obtained: 1) optimal operation point exists in many cases where its existence is more probable for a larger noise intensity, simpler structure images, and more efficient coders; 2) the better portable graphics coder usually provides the best compromise between image quality and compression ratio; 3) a rather high correlation of performance characteristics of compression techniques based on discrete cosine transform is observed. Conclusions: 1) it is often possible to provide a rather large compression ratio without losing valuable information or even with improving the image quality; 2) performance characteristics of lossy compression considerably depends on image complexity and, thus, the parameter that controls compression has to be adapted to image and noise characteristics.\u00a0<\/jats:p>","DOI":"10.20998\/2522-9052.2026.4.05","created":{"date-parts":[[2026,10,2]],"date-time":"2026-10-02T11:39:52Z","timestamp":1790941192000},"title":["PERFORMANCE COMPARISON OF MODERN LOSSY COMPRESSION TECHNIQUES WITH APPLICATION TO GRAYSCALE NOISY IMAGES"],"author":[{"given":"Sergii","family":"Kryvenko","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Vladimir","family":"Lukin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Benoit","family":"Vozel","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/ais.khpi.edu.ua\/article\/download\/372714\/356274","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/ais.khpi.edu.ua\/article\/download\/372714\/356274","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.20998\/2522-9052.2026.4.05","published":{"date-parts":[[2026,10,2]]}},{"DOI":"10.7717\/peerj-cs.4103\/fig-6","title":["Figure 6: End-to-end pipeline from the input image through component, text detection, OCR, node extraction, and component-to-node mapping to netlist generation and circuit solutions."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4103\/fig-6","created":{"date-parts":[[2026,10,13]],"date-time":"2026-10-13T08:12:34Z","timestamp":1791879154000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4103","asserted-by":"object"}]}},{"DOI":"10.26512\/2022.05.d.44406","title":["Neural information extraction pipeline for cyber forensics with pre-trained language models"],"author":[{"given":"Fillipe Barros","family":"Rodrigues","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.26512\/2022.05.d.44406","created":{"date-parts":[[2026,9,20]],"date-time":"2026-09-20T20:03:22Z","timestamp":1789934602000}},{"DOI":"10.20944\/preprints202610.2704.v1","title":["Cheap First, Ask the LLM Later? Cost and Accuracy of Rule-Based, Native-PDF, and Text-Based LLM Extraction of Syllabus Deadlines"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0004-1129-1349","authenticated-orcid":false,"given":"Soumya","family":"Patel","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Students receive assessment deadlines inside course syllabi, usually as PDFs, and a growing number of tools use large language models (LLMs) to turn these documents into calendars. A common cost-saving design runs cheap rules first and calls the LLM only when the rules appear to fail. We test whether this saves money without losing accuracy. We compare five strategies on 16 public syllabi from eight institutions (151 hand-verified deadlines): regular-expression rules, a general-purpose date library, an LLM given the native PDF, an LLM given text extracted from the PDF, and a rule-first hybrid that calls the LLM only when the rules find fewer than three events. Each LLM strategy was run three times with gemini-3.1-flash-lite. The LLM strategies reached F1 scores of 0.708 (native PDF) and 0.657 (extracted text); the difference was not significant (p = 0.13), and the native-PDF input used fewer tokens with this model. The rule-first hybrid used 57.8% fewer tokens than the text-based LLM but lowered F1 to 0.370, a significant loss (p = 0.002). Rules alone scored 0.186, and 58% of their correctly placed month-day matches carried the wrong year. A sweep of the hybrid's routing threshold shows that every token saved cost accuracy. We release the code, labels, and all predictions.<\/jats:p>","URL":"https:\/\/doi.org\/10.20944\/preprints202610.2704.v1","published":{"date-parts":[[2026,10,27]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T06:08:12Z","timestamp":1793254092000}},{"DOI":"10.1016\/j.inffus.2026.104775","title":["Robust hybrid graph fusion for multi-modal relation extraction via information bottleneck denoising"],"author":[{"given":"Qihui","family":"Zhao","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Haoran","family":"Zhao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tianhan","family":"Gao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.inffus.2026.104775","published":{"date-parts":[[2027,3]]},"created":{"date-parts":[[2026,9,11]],"date-time":"2026-09-11T09:51:40Z","timestamp":1789120300000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1566253526006512?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1566253526006512?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.67599\/anr-23-ce46-0006","URL":"https:\/\/doi.org\/10.67599\/anr-23-ce46-0006","created":{"date-parts":[[2026,9,2]],"date-time":"2026-09-02T15:11:00Z","timestamp":1788361860000}},{"DOI":"10.61686\/gxapp47132","URL":"https:\/\/doi.org\/10.61686\/gxapp47132","created":{"date-parts":[[2026,9,4]],"date-time":"2026-09-04T15:37:15Z","timestamp":1788536235000}},{"DOI":"10.67599\/anr-20-iadj-0005","URL":"https:\/\/doi.org\/10.67599\/anr-20-iadj-0005","created":{"date-parts":[[2026,9,3]],"date-time":"2026-09-03T10:16:48Z","timestamp":1788430608000}},{"DOI":"10.37391\/ijeer.140318","title":["Error Signal Based Method for Real Time Pitch Extraction from Noisy Speech"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0006-3305-6627","authenticated-orcid":false,"given":"Mohammad Forhad","family":"Hossain","sequence":"first","affiliation":[{"name":"Department of ICT, Comilla University, Bangladesh"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0002-7469-2057","authenticated-orcid":false,"given":"Nargis","family":"Parvin","sequence":"additional","affiliation":[{"name":"Associate Professor, Department of CSE, Bangladesh Army International University of Science and Technology, Bangladesh"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0008-0629-486X","authenticated-orcid":false,"given":"Md. Saifur","family":"Rahman","sequence":"additional","affiliation":[{"name":"Professor, Department of ICT, Comilla University, Bangladesh"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0001-6748-2038","authenticated-orcid":false,"given":"Pintu Chandra","family":"Paul","sequence":"additional","affiliation":[{"name":"Assistant Professor, Department of ICT, Comilla University, Bangladesh"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0000-0077-6093","authenticated-orcid":false,"given":"Moinur","family":"Rahman","sequence":"additional","affiliation":[{"name":"Lecturer, Department of ICT, Comilla University, Bangladesh"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0007-9066-7720","authenticated-orcid":false,"given":"Md. Ohidul","family":"Islam","sequence":"additional","affiliation":[{"name":"Assistant Professor, Department of Computer Science & Engineering, Atish Dipankar University of Science and Technology(ADUST), Bangladesh"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Pitch estimation efficiency always gets affected by two major phenomena. The first one is additive noise which by nature are not correlated with the source speech signal. The second one is the vocal tract effect which creates unnecessary peaks within the signal waveform, resulting inaccurate detection of the pitch value. This paper proposes a Modified Weighted Autocorrelation Function (MWAF) executed in the Linear Predictive Coding (LPC) residual domain, instead of directly executing over the noisy source speech signal. Converting the noisy source speech signal to LP residual helps eliminating the vocal tract effects and emphasizing the necessary effects of glottal excitation. The Autocorrelation Function (ACF) and the Circular Average Magnitude Difference Function (CAMDF) are directly applied on this residual. The proposed MWAF is then calculated by multiplying the ACF with the reciprocal of the CAMDF, which enhances the periodic components as well as reduces the noise induced false peaks. Experimental results were evaluated on the KEELE and NTT databases across White, Babble, Train and HF Channel noise conditions. The result shows that our proposed algorithm reduces the Gross Pitch Error (GPE) by an average of 40.34% compared to baseline methods such as BaNa, PEFAC and WAF. Furthermore, the algorithm achieves an overall computational gain of 53.44% compared to BaNa, PEFAC and WAF, offering a stable solution for pitch tracking in degraded acoustic conditions.<\/jats:p>","URL":"https:\/\/doi.org\/10.37391\/ijeer.140318","published":{"date-parts":[[2026,9,30]]},"created":{"date-parts":[[2026,10,9]],"date-time":"2026-10-09T11:52:31Z","timestamp":1791546751000}},{"DOI":"10.1109\/access.2026.3732383","title":["Input-Data Information Preservation and Protocol-Specific Error Mitigation in Noisy Fixed-Parameter Quantum Front Ends: A Reproducible Simulation Study"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0002-0596-3933","authenticated-orcid":false,"given":"Hongmin","family":"Jung","sequence":"first","affiliation":[{"name":"Laurel Springs School","place":["Ojai, CA, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3732383","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,10]],"date-time":"2026-09-10T19:03:01Z","timestamp":1789066981000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/6287639\/11323511\/11685949.pdf?arnumber=11685949","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>The work is devoted to the development of the hardware-software prototype of a voice navigation subsystem intended for assistive navigation under acoustic interference. The relevance of the topic is explained by the need to improve the accuracy of generating voice or haptic prompts regarding the recommended route for visually impaired users based on their voice-based destination requests. The accuracy of the recommended route depends on the accuracy of voice command recognition in noisy and crowded environments. The goal of this paper is to develop a hardware-software module for voice navigation within an assistive system that enables user positioning and command recognition in the presence of acoustic interference, with the goal of enhancing the independence and mobility of individuals with visual and\/or musculoskeletal impairments. The subject of this study is the processes and methods for improving the accuracy and robustness of voice command recognition in a hardware-software navigation subsystem in the presence of stationary and non-stationary noise and a multi-voice acoustic environment. The task of this work is to develop a functional model of the voice navigation hardware-software module, to develop a comprehensive sound processing algorithm that accounts for various types of acoustic interference and voice overlap; to analyze the impact of various types of acoustic interference and voice overlap on the performance of the software-hardware system. Methods such as comparative analysis, experimental models, acoustic signal recognition were applied. The results demonstrate that the proposed preprocessing and speaker-oriented filtering improve speech command recognition quality in all considered cases. WER decreased from 15.4% to 13.2% in reference conditions, from 48.6% to 30.9% under non-stationary noise, from 68.7% to 15.4% under 50 dB stationary noise, and from 73.0% to 35.3% for overlapping speech of equal loudness. The obtained results confirm the practical suitability of the proposed subsystem for assistive navigation systems operating in acoustically challenging real-world environments. Further research will focus on integrating intelligent personalization techniques into navigation feedback.<\/jats:p>","DOI":"10.20998\/2522-9052.2026.4.03","created":{"date-parts":[[2026,10,2]],"date-time":"2026-10-02T11:39:52Z","timestamp":1790941192000},"title":["HARDWARE-SOFTWARE PROTOTYPE OF A VOICE NAVIGATION SUBSYSTEM IN NOISY ENVIRONMENTS"],"author":[{"given":"Olesia","family":"Barkovska","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Denys","family":"Storchai","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Andriy","family":"Kovalenko","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuri","family":"Romanenkov","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Vadym","family":"Trunov","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/ais.khpi.edu.ua\/article\/download\/372684\/356185","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/ais.khpi.edu.ua\/article\/download\/372684\/356185","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.20998\/2522-9052.2026.4.03","published":{"date-parts":[[2026,10,2]]}},{"abstract":"<jats:p>Reliable attribution of artificial intelligence (AI)-generated text to a specific large language model (LLM) matters increasingly as LLMs proliferate, yet where quantum machine learning actually stands on this task has, to our knowledge, never been measured systematically. We benchmark the quantum support vector machine (QSVM) for binary attribution between Gemma 3 and Qwen 2.5 on a 5800-sample corpus from paired prompts: 83 configurations sweeping qubit count, regularization, training-set size, feature-map family, and circuit depth under exact, noiseless classical statevector simulation. QSVM validation accuracy plateaus at approximately 88%, whereas a classical support vector machine with a radial basis function kernel reaches approximately 97.8% on the identical fourteen-dimensional inputs: the ceiling belongs to the quantum (fidelity) kernel, not to the input representation. We measure the mechanism: off-diagonal quantum kernel values shrink exponentially with qubit count, the signature of exponential kernel concentration. The same classical model recovers the stylometric attribution fingerprint, showing it belongs to the shared feature pipeline rather than to the quantum kernel. All large-scale headline results generalize to an independent 1000-text test set produced after every design decision was frozen. The study provides a cautionary, reproducible benchmark for quantum kernel natural language processing and outlines an open-set extension as future work.<\/jats:p>","DOI":"10.3390\/info17090883","created":{"date-parts":[[2026,9,11]],"date-time":"2026-09-11T12:24:33Z","timestamp":1789129473000},"title":["A Systematic Benchmark of Quantum Support Vector Machines for Interpretable Attribution of AI-Generated Text"],"author":[{"given":"Kalin","family":"Kopanov","sequence":"first","affiliation":[{"name":"Institute of Information and Communication Technologies, Bulgarian Academy of Sciences, Acad. G. Bonchev St., Bl. 2, 1113 Sofia, Bulgaria"}],"role":[{"vocabulary":"crossref","role":"author"},{"role":"conceptualization","vocabulary":"credit"},{"role":"methodology","vocabulary":"credit"},{"role":"software","vocabulary":"credit"},{"role":"validation","vocabulary":"credit"},{"role":"formal-analysis","vocabulary":"credit"},{"role":"investigation","vocabulary":"credit"},{"role":"data-curation","vocabulary":"credit"},{"role":"writing-original-draft","vocabulary":"credit"},{"role":"writing-review-editing","vocabulary":"credit"},{"role":"visualization","vocabulary":"credit"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-6084-3179","authenticated-orcid":false,"given":"Tatiana","family":"Atanasova","sequence":"additional","affiliation":[{"name":"Institute of Information and Communication Technologies, Bulgarian Academy of Sciences, Acad. G. Bonchev St., Bl. 2, 1113 Sofia, Bulgaria"}],"role":[{"vocabulary":"crossref","role":"author"},{"role":"conceptualization","vocabulary":"credit"},{"role":"validation","vocabulary":"credit"},{"role":"writing-review-editing","vocabulary":"credit"},{"role":"supervision","vocabulary":"credit"},{"role":"project-administration","vocabulary":"credit"},{"role":"funding-acquisition","vocabulary":"credit"}]}],"link":[{"URL":"https:\/\/www.mdpi.com\/2078-2489\/17\/9\/883\/pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.3390\/info17090883","published":{"date-parts":[[2026,9,11]]}},{"DOI":"10.7717\/peerj-cs.4103\/supp-18","title":["Supplemental Information 18: YOLOv8 nano, small, and medium models\u2019 best parameter evaluation for the text-region localization task."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4103\/supp-18","created":{"date-parts":[[2026,10,13]],"date-time":"2026-10-13T08:12:34Z","timestamp":1791879154000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4103","asserted-by":"object"}]}},{"DOI":"10.1109\/re68928.2026.00048","title":["Evaluating the Impact of Input Text Properties on LLM-Based Requirements Extraction"],"author":[{"given":"Konstantin","family":"Valeev","sequence":"first","affiliation":[{"name":"Utrecht University","place":["Utrecht, The Netherlands"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Fabiano","family":"Dalpiaz","sequence":"additional","affiliation":[{"name":"Utrecht University","place":["Utrecht, The Netherlands"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Fatma Ba\u015fak","family":"Aydemir","sequence":"additional","affiliation":[{"name":"Utrecht University","place":["Utrecht, The Netherlands"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/re68928.2026.00048","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,9,9]],"date-time":"2026-09-09T19:10:24Z","timestamp":1788981024000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11676474\/11676607\/11676732.pdf?arnumber=11676732","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.69894\/20050130","title":["Open Text Livelink for Vintage Petroleum"],"author":[{"given":"Neil","family":"McNaughton","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">Livelink deployed as business process improvement platform. Open Text holds  energy user meet.<\/jats:p>","URL":"https:\/\/doi.org\/10.69894\/20050130","published":{"date-parts":[[2005,1,28]]},"created":{"date-parts":[[2026,9,3]],"date-time":"2026-09-03T12:20:56Z","timestamp":1788438056000}},{"DOI":"10.47788\/lrbu5139","title":["6. More-Than-Human Reader, Text, and Stone in Samuel Beckett\u2019s Ill Seen Ill Said"],"author":[{"given":"Nilanjana","family":"Bhattacharya","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.47788\/lrbu5139","published":{"date-parts":[[2026,11,19]]},"created":{"date-parts":[[2026,9,24]],"date-time":"2026-09-24T06:45:00Z","timestamp":1790232300000}},{"DOI":"10.69894\/20141107","title":["Beyond Recognition offers terabyte text trial"],"author":[{"given":"Neil","family":"McNaughton","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">Guided \u2018visual classification\u2019 methodology for document collection rationalization.<\/jats:p>","URL":"https:\/\/doi.org\/10.69894\/20141107","published":{"date-parts":[[2014,12,28]]},"created":{"date-parts":[[2026,9,3]],"date-time":"2026-09-03T12:14:39Z","timestamp":1788437679000}},{"DOI":"10.2139\/ssrn.7493274","title":["Decomposing the schema: reliable structured information extraction with large language models"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-8105-4101","authenticated-orcid":true,"given":"Abdalrhman","family":"Alquaary","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-7489-9053","authenticated-orcid":true,"given":"Numan","family":"\u00c7elebi","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Information extraction, converting unstructured text into structured data, has been reshaped by large language models: instead of labelling spans with a fixed type inventory, a single model now populates an entire predefined schema. We study this modern form, structured information extraction, among the most heavily deployed uses of these models. The default one-shot method puts the whole schema and document in one prompt and requests the entire object at once; it is fundamentally fragile, degrading silently or catastrophically as the schema grows denser, the document longer, or the model weaker. We instead decompose the schema itself into independently extractable units, query each unit separately against the document, and reassemble the outputs with a deterministic, schema-validated composer. A unit is a single field when fields are independent; when a list\u2019s records are interdependent and unbounded in number, the entire list is one unit. Reliability matters most where it is hardest to achieve: privacy rules forbid sending the most sensitive documents to hosted frontier models, forcing extraction onto local open-weight models, precisely the weaker models on which one-shot most often fails. We evaluate on a purpose-built, fully released benchmark (800 documents across legal and medical schemas in English and Arabic, constructed ground-truth-first) over 30 open-weight models spanning four families (Qwen, Llama, Gemma, gpt-oss) and three architecture types (dense, Mixture-of-Experts, Matformer). Decomposition lifts value-accuracy macro-F1 over one-shot on every model and recovers cases where one-shot collapses entirely, including models that produce no usable output on most documents.<\/jats:p>","URL":"https:\/\/doi.org\/10.2139\/ssrn.7493274","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,20]],"date-time":"2026-09-20T13:39:38Z","timestamp":1789911578000}},{"DOI":"10.69894\/20070115","title":["MetaCarta geo-text search engine for SPE"],"author":[{"given":"Neil","family":"McNaughton","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">The Society of Petroleum Engineers is to offer geographical, taxonomy-based search of e-Library.<\/jats:p>","URL":"https:\/\/doi.org\/10.69894\/20070115","published":{"date-parts":[[2007,1,28]]},"created":{"date-parts":[[2026,9,3]],"date-time":"2026-09-03T12:20:21Z","timestamp":1788438021000}},{"DOI":"10.18653\/2026.akbc-1.23","title":["LMKG: a flexible method for ontology-aware Knowledge Graph Extraction from text"],"author":[{"given":"Gianmarco","family":"Pappacoda","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Paolo","family":"Torroni","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.18653\/2026.akbc-1.23","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T16:16:22Z","timestamp":1793290582000}},{"DOI":"10.1109\/cisat71030.2026.11682402","title":["Robustness Evaluation and Denoising Optimization of Deep Learning Models for Brain Tumor MRI Classification Under Noisy Conditions"],"author":[{"given":"Haowen","family":"Xu","sequence":"first","affiliation":[{"name":"Hainan University","place":["Haikou, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cisat71030.2026.11682402","published":{"date-parts":[[2026,7]]},"created":{"date-parts":[[2026,9,10]],"date-time":"2026-09-10T19:10:46Z","timestamp":1789067446000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11682029\/11682043\/11682402.pdf?arnumber=11682402","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1145\/3805696.3846498","title":["Robust Cross-Modal Alignment for Reliable Multimodal Video Information Access under Noisy Textual Descriptions"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0003-2940-0043","authenticated-orcid":false,"given":"Chengxi","family":"Chu","sequence":"first","affiliation":[{"name":"Universiti Malaya, Kuala Lumpur, Malaysia"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0002-4878-4134","authenticated-orcid":false,"given":"Yi-Shuai","family":"Xu","sequence":"additional","affiliation":[{"name":"Universiti Malaya, Kuala Lumpur, Malaysia"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1145\/3805696.3846498","published":{"date-parts":[[2026,10,13]]},"created":{"date-parts":[[2026,10,12]],"date-time":"2026-10-12T07:02:51Z","timestamp":1791788571000},"link":[{"URL":"https:\/\/dl.acm.org\/doi\/pdf\/10.1145\/3805696.3846498","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/tcsvt.2026.3732018","title":["Progressive Robust Decoupling of Noisy-Hard Sample for Text-to-Image Person Retrieval"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0007-9049-1833","authenticated-orcid":false,"given":"Runqing","family":"Zhang","sequence":"first","affiliation":[{"name":"University of Electronic Science and Technology of China (UESTC)","place":["Chengdu, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jin","family":"Ding","sequence":"additional","affiliation":[{"name":"University of Electronic Science and Technology of China (UESTC)","place":["Chengdu, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-1654-2157","authenticated-orcid":false,"given":"Xue","family":"Zhou","sequence":"additional","affiliation":[{"name":"UESTC","place":["Shenzhen, China"],"department":["Shenzhen Institute for Advanced Study"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mingzhu","family":"Cai","sequence":"additional","affiliation":[{"name":"University of Electronic Science and Technology of China (UESTC)","place":["Chengdu, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0000-4962-8905","authenticated-orcid":false,"given":"Li","family":"Yu","sequence":"additional","affiliation":[{"name":"University of Electronic Science and Technology of China (UESTC)","place":["Chengdu, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-8676-8322","authenticated-orcid":false,"given":"Jianxiao","family":"Zou","sequence":"additional","affiliation":[{"name":"UESTC","place":["Shenzhen, China"],"department":["Shenzhen Institute for Advanced Study"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3023-1662","authenticated-orcid":false,"given":"Xi","family":"Li","sequence":"additional","affiliation":[{"name":"Zhejiang University (ZJU)","place":["Hangzhou, China"],"department":["College of Computer Science and Technology"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/tcsvt.2026.3732018","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,9]],"date-time":"2026-09-09T19:02:54Z","timestamp":1788980574000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/76\/4358651\/11684849.pdf?arnumber=11684849","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.32890\/jict2013.12.8","title":["Normalization of Noisy Texts in Malaysian Online Reviews"],"author":[{"given":"Norlela","family":"Samsudin","sequence":"first","affiliation":[{"name":"Faculty of Computer and Mathematical Science, Universiti Teknologi MARA Terengganu, Dungun, 23000, Terengganu"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mazidah","family":"Puteh","sequence":"additional","affiliation":[{"name":"Faculty of Computer and Mathematical Science, Universiti Teknologi MARA Terengganu, Dungun, 23000, Terengganu"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Abdul Razak","family":"Hamdan","sequence":"additional","affiliation":[{"name":"Faculty of Information Science and Technology, Universiti Kebangsaan Malaysia 43600, Bangi, Selangor"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mohd Zakree","family":"Ahmad Nazri","sequence":"additional","affiliation":[{"name":"Faculty of Information Science and Technology, Universiti Kebangsaan Malaysia 43600, Bangi, Selangor"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>The process of gathering useful information from online messages has increased as more and more people use the Internet and other online applications such as Facebook and Twitter to communicate with each other. One of the problems in processing online messages is the high number of noisy texts that exist in these messages. Few studies have shown that the noisy texts decreased the result of text mining activities. On the other hand, very few works have investigated on the patterns of noisy texts that are created by Malaysians. In this study, a common noisy terms list and an artificial abbreviations list were created using specific rules and were utilized to select candidates of correct words for a noisy term. Later, the correct term was selected based on a bi-gram words index. The experiments used online messages that were created by the Malaysians. The result shows that normalization of noisy texts using artificial abbreviations list compliments the use of common noisy texts list.\r\n\u00a0<\/jats:p>","URL":"https:\/\/doi.org\/10.32890\/jict2013.12.8","published":{"date-parts":[[2013,4,23]]},"created":{"date-parts":[[2026,9,4]],"date-time":"2026-09-04T05:39:07Z","timestamp":1788500347000}},{"DOI":"10.1016\/j.inffus.2026.104894","title":["Semantic fidelity challenges in diffusion-based text-to-image models: A survey"],"author":[{"given":"Saket","family":"Pandey","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Pranav","family":"Singh Chib","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-1001-2219","authenticated-orcid":false,"given":"Pravendra","family":"Singh","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.inffus.2026.104894","published":{"date-parts":[[2027,3]]},"created":{"date-parts":[[2026,10,26]],"date-time":"2026-10-26T08:09:29Z","timestamp":1793002169000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1566253526007700?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1566253526007700?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.7717\/peerj-cs.4114\/table-11","title":["Table D1: Structured data extraction framework used to code bibliographic, methodological, and empirical information from the included studies."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4114\/table-11","created":{"date-parts":[[2026,10,12]],"date-time":"2026-10-12T08:45:22Z","timestamp":1791794722000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4114","asserted-by":"object"}]}},{"DOI":"10.69894\/20051120","title":["Sasol to deploy Open Text for SOX compliance"],"author":[{"given":"Neil","family":"McNaughton","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">Internal Controls Solution targets Sarb-Ox reporting, integrates with LiveLink  content management.<\/jats:p>","URL":"https:\/\/doi.org\/10.69894\/20051120","published":{"date-parts":[[2005,12,28]]},"created":{"date-parts":[[2026,9,3]],"date-time":"2026-09-03T12:20:56Z","timestamp":1788438056000}},{"DOI":"10.48009\/2_iis_2026_115","title":["ANALYZING EMERGING TRENDS IN GEOSPATIAL ARTIFICIAL INTELLIGENCE THROUGH INTERPRETABLE TEXT MINING"],"URL":"https:\/\/doi.org\/10.48009\/2_iis_2026_115","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,6]],"date-time":"2026-10-06T02:29:02Z","timestamp":1791253742000}},{"DOI":"10.69894\/20101104","title":["Open Text Semantic Network\u2014an exclusive test drive"],"author":[{"given":"Neil","family":"McNaughton","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">New cloud-based smart search engine trial leverages www.oilit.com information  resource.<\/jats:p>","URL":"https:\/\/doi.org\/10.69894\/20101104","published":{"date-parts":[[2010,12,28]]},"created":{"date-parts":[[2026,9,3]],"date-time":"2026-09-03T12:19:20Z","timestamp":1788437960000}},{"DOI":"10.7717\/peerj-cs.4103\/supp-6","title":["Supplemental Information 6: Dataset preparation workflow showing preprocessing, component annotation (six classes), text region annotation, and cropped OCR dataset creation."],"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.4103\/supp-6","created":{"date-parts":[[2026,10,13]],"date-time":"2026-10-13T08:12:34Z","timestamp":1791879154000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.4103","asserted-by":"object"}]}},{"DOI":"10.61686\/ipwyn51725","URL":"https:\/\/doi.org\/10.61686\/ipwyn51725","created":{"date-parts":[[2026,9,7]],"date-time":"2026-09-07T13:00:01Z","timestamp":1788786001000}},{"DOI":"10.18653\/2026.nllp-1.50","title":["From Legal Text to Executable Process: LLM-Based Extraction of DCR Determinations from Danish Administrative Law"],"author":[{"given":"Ali","family":"Al-Laith","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Manex","family":"Agirrezabal","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.18653\/2026.nllp-1.50","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T16:16:38Z","timestamp":1793290598000}},{"DOI":"10.1016\/j.ipm.2026.105176","title":["CORE-DG: Community role-aware contrastive learning on text-attributed dynamic graphs"],"author":[{"given":"Long","family":"Xu","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Honghui","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.ipm.2026.105176","published":{"date-parts":[[2027,2]]},"created":{"date-parts":[[2026,9,25]],"date-time":"2026-09-25T11:20:59Z","timestamp":1790335259000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0306457326005662?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0306457326005662?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.1109\/access.2026.3745988\/mm1","title":["Enhanced Neighborhood Information Extraction for Local Climate Zone Classification by Coupling a Global Attention Mechanism_supp1-3745988.docx"],"author":[{"given":"XUEHE","family":"LU","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3745988\/mm1","created":{"date-parts":[[2026,10,26]],"date-time":"2026-10-26T19:11:43Z","timestamp":1793041903000},"relation":{"is-component-of":[{"id-type":"doi","id":"10.1109\/ACCESS.2026.3745988","asserted-by":"object"}]}},{"abstract":"<jats:p>Text-guided segmentation combines visual information with semantic descriptions, but semantic conditioning alone does not explicitly supervise the separation of foreground and background representations. We combine a VGG16-based encoder\u2013decoder and the established cross-position attention pathway with a two-layer CLIP text adapter and mask-guided foreground\u2013background contrastive supervision at three encoder levels. Reference masks guide contrastive sampling during training but are not inference inputs. On the fixed QaTa-COV19 chest X-ray benchmark, three independent runs yielded a Dice of 0.8589\u00b10.0037 and a mean foreground intersection over union (mIoU) of 0.7583\u00b10.0045; on the MosMedData+ two-dimensional CT-slice benchmark, the corresponding results were 0.8023\u00b10.0038 and 0.6745\u00b10.0044 (mean \u00b1 standard deviation). A two-factor ablation assessed the text adapter and contrastive term separately and jointly. Individual-negative InfoNCE yielded lower mean overlap scores than the proposed average-negative objective under the matched training settings. Inference-time left\/right exchanges in unilateral-description subsets revealed substantial sensitivity to incorrect laterality. These findings describe fixed image\/slice-level benchmarks and do not establish external clinical generalization.<\/jats:p>","DOI":"10.3390\/info17111058","created":{"date-parts":[[2026,10,23]],"date-time":"2026-10-23T01:42:23Z","timestamp":1792719743000},"title":["Mask-Guided Foreground\u2013Background Contrastive Learning for Text-Guided COVID-19 Segmentation in Chest X-Ray and CT Images"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0003-9400-428X","authenticated-orcid":false,"given":"Baoyang","family":"Han","sequence":"first","affiliation":[{"name":"West China School of Medicine, Sichuan University, Chengdu 610041, China"}],"role":[{"vocabulary":"crossref","role":"author"},{"role":"methodology","vocabulary":"credit"},{"role":"software","vocabulary":"credit"},{"role":"validation","vocabulary":"credit"},{"role":"formal-analysis","vocabulary":"credit"},{"role":"investigation","vocabulary":"credit"},{"role":"data-curation","vocabulary":"credit"},{"role":"writing-original-draft","vocabulary":"credit"},{"role":"writing-review-editing","vocabulary":"credit"},{"role":"visualization","vocabulary":"credit"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5794-1712","authenticated-orcid":false,"given":"Jia","family":"Wei","sequence":"additional","affiliation":[{"name":"School of Computer Science and Engineering, South China University of Technology, Guangzhou 510006, China"}],"role":[{"vocabulary":"crossref","role":"author"},{"role":"conceptualization","vocabulary":"credit"},{"role":"methodology","vocabulary":"credit"},{"role":"validation","vocabulary":"credit"},{"role":"resources","vocabulary":"credit"},{"role":"writing-review-editing","vocabulary":"credit"},{"role":"supervision","vocabulary":"credit"},{"role":"project-administration","vocabulary":"credit"}]}],"link":[{"URL":"https:\/\/www.mdpi.com\/2078-2489\/17\/11\/1058\/pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.3390\/info17111058","published":{"date-parts":[[2026,10,22]]}},{"DOI":"10.1145\/3805696.3846042","title":["Context Selection for Hypothesis and Statistical Evidence Extraction from Full-Text Scientific Articles"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0001-8582-5914","authenticated-orcid":false,"given":"Sai","family":"Koneru","sequence":"first","affiliation":[{"name":"Pennsylvania State University, University Park, Pennsylvania, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0173-4463","authenticated-orcid":false,"given":"Jian","family":"Wu","sequence":"additional","affiliation":[{"name":"Old Dominion University, Norfolk, Virginia, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-1464-0848","authenticated-orcid":false,"given":"Sarah","family":"Rajtmajer","sequence":"additional","affiliation":[{"name":"Pennsylvania State University, University Park, Pennsylvania, USA"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1145\/3805696.3846042","published":{"date-parts":[[2026,10,13]]},"created":{"date-parts":[[2026,10,12]],"date-time":"2026-10-12T07:02:51Z","timestamp":1791788571000},"link":[{"URL":"https:\/\/dl.acm.org\/doi\/pdf\/10.1145\/3805696.3846042","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.18653\/2026.wnut-1.8","title":["From Errors to Precision: A Taxonomy-Guided Approach for LLM Flood Cause Extraction"],"author":[{"given":"Jane Arleth","family":"dela Cruz","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Iris","family":"Hendrickx","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Martha","family":"Larson","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.18653\/2026.wnut-1.8","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T16:16:38Z","timestamp":1793290598000}},{"DOI":"10.1109\/conecct68978.2026.11700668","title":["Selective Extraction: A Hallucination-Free Approach to LLM-Based Document Information Extraction"],"author":[{"given":"Vineeth","family":"Rao","sequence":"first","affiliation":[{"name":"R.V. College of Engineering","place":["Bengaluru, India"],"department":["Department of Computer Science and Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yash","family":"Saraogi","sequence":"additional","affiliation":[{"name":"R.V. College of Engineering","place":["Bengaluru, India"],"department":["Department of Computer Science and Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tulya","family":"Reddy","sequence":"additional","affiliation":[{"name":"R.V. College of Engineering","place":["Bengaluru, India"],"department":["Department of Computer Science and Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mekhala Vinod","family":"Purohit","sequence":"additional","affiliation":[{"name":"R.V. College of Engineering","place":["Bengaluru, India"],"department":["Department of Computer Science and Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/conecct68978.2026.11700668","published":{"date-parts":[[2026,7]]},"created":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T19:37:28Z","timestamp":1790624248000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11700512\/11700570\/11700668.pdf?arnumber=11700668","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.33889\/ijmems.2026.11.5.088","title":["Deep Learning Based Cosine Text Feature Extraction from Fuzzy Filter Quality Improved Compressed Image Documents"],"author":[{"given":"Sharmila","family":"Chidaravalli","sequence":"first","affiliation":[{"name":"Global Academy of Technology, VTU, Bangalore, Karnataka, India."}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Vimuktha E","family":"Salis","sequence":"additional","affiliation":[{"name":"Global Academy of Technology, VTU, Bangalore, Karnataka, India."}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>With the surge of process modernization and enhanced data management, the world is advancing towards digitization and automation more than was presumed. The Internet is becoming one of the most favored means of communication and multimedia, coupled with data compression methods, plays a crucial role in controlling the huge volume of data that is being produced on a regular basis. Modeling novel methods for the automatic analysis of compressed data without decompression is pressing requirement of the hour. In this work a deep learning method called Linear Activated Cosine Deep Neural Network based text feature extraction from Fuzzy Filter (LACDNN-FF) quality improved compressed image documents is proposed. The LACDNN-FF method is modeled using an agent AI model. To be more specific, three different agent AIs, namely the Image Enhancement Agent (IEA), Layout Analysis Agent (LAA) and Text Feature Extraction Agent (TFEA) are employed in the design of the LACDNN-FF method. Initially, with the scanned image dataset of compressed image documents as input, two dimensional flexible fuzzy filter-based pre-processing is applied by the IEA with the intent of eliminating noise, thereby generating quality-enhanced compressed documents. Next, Linear Activated Discriminant Analysis with Deep Neural Network-based Segmentation is applied by the LAA to perform document segmentation and classify the contents using pixel-precise semantic segmentation. Finally, Cosine CNN-BiLSTM (Convolutional Neural Network - Bidirectional Long Short-Term Memory) neural network based Text Feature Extraction is applied by TFEA for accurate text extraction and text feature processing. The proposed deep learning method LACDNN-FF outperforms existing methods and shows a promising solution for accurate text feature extraction with minimal error rate.<\/jats:p>","URL":"https:\/\/doi.org\/10.33889\/ijmems.2026.11.5.088","published":{"date-parts":[[2026,9,29]]},"created":{"date-parts":[[2026,9,29]],"date-time":"2026-09-29T08:44:58Z","timestamp":1790671498000}},{"DOI":"10.32469\/10355\/113082","title":["Text-to-speech technologies in undergraduate students of Medell\u00edn : acceptance of modern synthetic voices for conveying academic information"],"author":[{"given":"Wilson","family":"Casta\u00f1o","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p xml:lang=\"en\">University libraries have long served as mediators between emerging information formats and the diverse needs of their users, from the print book to the e-book and now to text-to-speech (TTS). Modern TTS, which uses neural voices generated by artificial intelligence (AI) that are nearly indistinguishable from human narration, raises the same questions once posed by the e-book: whether it is an effective medium for delivering academic content to the general student population, whether students will accept it, and what role academic libraries should play in evaluating and promoting it. Although TTS has been studied extensively as an assistive technology for users with disabilities, there is little research on its use by non-disabled undergraduates, particularly in developing countries. This is an exploratory research study using a mixed-methods qualitative-quantitative approach. I examined the effectiveness, the students' acceptance and the students' adoption of TTS technology by 20 students from three different disciplines at the University of Antioquia, in Medell\u00edn, Colombia. These 20 students completed three sessions of tests for comprehension and retention and they filled in a survey in order to evaluate their acceptance of TTS technology, using the extended version of the Technology Acceptance Model 2 (TAM2) (Venkatesh &amp; Davis, 2000). Finally, 10 of them participated in semi-structured interviews in order to gather qualitative data. The effectiveness of TTS technology was evaluated in terms of the degree of the students' comprehension of the material they read, using Schneider and Shiffrin's (1977) model of controlled and automatic processing. A repeated-measures ANOVA, using the between-subjects factor of gender, discipline and age, revealed significant differences in comprehension scores for the three sessions (F(2, 38) = 72.15, p &lt; .001, \u03b7\u00b2\u209a = .79). Most of the gains in comprehension were between Session 2 and Session 3. The differences in the beginning of the three sessions for the variables of gender, discipline and age of the participants were reduced during the three sessions, although this is not conclusive due to the low number of participants. These results could be interpreted as evidence of an auditory learning effect or auditory habituation. In terms of retention, the results followed a non-linear pattern. Scores for retention were very high at the beginning of the study, declined in the intermediate session and returned to high scores in the final session. The TAM2 results were positive in general terms, with scores for the variable of Attitude Toward Use (M = 4.50) being the highest, while scores for the variable of Subjective Norm (M = 2.33) were below the scale's middle point. Thus, the positive views that the participants had regarding the use of TTS in academic settings were based on their personal experience and not on institutional or social perceptions. These quantitative results are in line with the five interview themes that were identified, such as (1) cognitive efficiency and information retention; (2) the friction of habituation and output quality; (3) contextual use and academic multi-tasking; (4) social influence and institutional gaps and (5) future adoption and sustainability of use This study seeks to shed light on the use of the newest iteration of reading technology by the non-disabled undergraduate student at a public university in Colombia. This research establishes evidence, which will be useful for academic libraries, information providers, who license databases of e-books that incorporate reading technologies, as well as teaching staff and faculty, on a tool which could support the academic study of non-disabled undergraduate students in a number of countries. More importantly this study provides a pathway for further research with greater participant numbers, from a variety of countries, speaking a number of languages and studying in a number of different academic contexts.<\/jats:p>","URL":"https:\/\/doi.org\/10.32469\/10355\/113082","created":{"date-parts":[[2026,10,28]],"date-time":"2026-10-28T20:52:34Z","timestamp":1793220754000}},{"DOI":"10.1016\/j.iopt.2026.100055","title":["Robust extraction of vehicle trajectories in noisy urban DAS via frequency-decoupled deep learning"],"author":[{"given":"Yuanhang","family":"Zhuo","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jingming","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shanfan","family":"Lu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Chaoxian","family":"Qiu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Nong","family":"Tian","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xingjie","family":"Lai","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jiayao","family":"Sun","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xiaobing","family":"Shi","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Peide","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jinjun","family":"Wang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jia","family":"Li","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Wenjiang","family":"Gao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hongliang","family":"Chang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuhan","family":"Shao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Liyang","family":"Shao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.iopt.2026.100055","published":{"date-parts":[[2026,10]]},"created":{"date-parts":[[2026,10,10]],"date-time":"2026-10-10T22:56:46Z","timestamp":1791673006000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S3051177126000268?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S3051177126000268?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.18653\/2026.akbc-1.19","title":["Schema-Guided Extraction of Interaction Knowledge Bases from Narrative Text: A Folktale Case Study"],"author":[{"given":"Sergey","family":"Kovalchuk","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Anastasia","family":"Ugleva","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Oleg","family":"Kubryak","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.18653\/2026.akbc-1.19","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,29]],"date-time":"2026-10-29T16:16:22Z","timestamp":1793290582000}},{"DOI":"10.1016\/j.ins.2026.124202","title":["Decoupled identity learning with prototype alignment for text-image person retrieval"],"author":[{"given":"Jia","family":"Sun","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Zekai","family":"Li","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yanfeng","family":"Li","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Houjin","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Luyifu","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Minjun","family":"Wang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.ins.2026.124202","published":{"date-parts":[[2027,2]]},"created":{"date-parts":[[2026,9,23]],"date-time":"2026-09-23T14:53:24Z","timestamp":1790175204000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0020025526011333?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S0020025526011333?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.1109\/tmm.2026.3734731","title":["Dual-Balanced Information Bottleneck for Multi-Modal Information Extraction"],"author":[{"given":"Youwei","family":"Wang","sequence":"first","affiliation":[{"name":"Zhengzhou University","place":["Zhengzhou, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Linpu","family":"Lv","sequence":"additional","affiliation":[{"name":"Zhengzhou University","place":["Zhengzhou, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Haichuan","family":"Fang","sequence":"additional","affiliation":[{"name":"Zhengzhou University","place":["Zhengzhou, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shizhe","family":"Hu","sequence":"additional","affiliation":[{"name":"Zhengzhou University","place":["Zhengzhou, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/tmm.2026.3734731","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,24]],"date-time":"2026-09-24T14:22:04Z","timestamp":1790259724000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/6046\/4456689\/11692986.pdf?arnumber=11692986","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Aiming at the challenge of signal detection and feature extraction in complex electromagnetic environment, this paper proposes an adaptive joint optimization method of signal detection and feature. Faced with the problems of traditional methods relying on prior knowledge, insufficient deep learning generalization ability, and poor adaptability to non-stationary noise, a cascaded framework was constructed that includes variable step size LMS (VSS-LMS) interference suppression, multi head self-attention (MHSA) feature extraction, and dynamic threshold decision-making. VSS-LMS achieves fast convergence and steady-state error balance by improving the tongue line function. MHSA uses multi-scale attention mechanism to focus on the characteristics of target signal adaptively. Adaptive threshold dynamically adjusts the threshold based on local noise power estimation. Experiments show that the detection probability of this method is 96% in the signal-to-noise ratio range of -15 dB to 5 dB, which is more than 15% higher than that of the traditional method. The accuracy of feature classification is over 94.3%, and the false alarm probability is stable below 0.01. The three modules cooperate to improve the detection sensitivity and feature discrimination in dynamic electromagnetic environment, and provide a new scheme for intelligent perception of complex electronic information systems.<\/jats:p>","DOI":"10.54097\/04jw9933","created":{"date-parts":[[2026,10,1]],"date-time":"2026-10-01T00:02:40Z","timestamp":1790812960000},"title":["Research on adaptive signal detection and feature extraction method of complex electronic information system"],"author":[{"given":"Cheng","family":"Yang","sequence":"first","affiliation":[{"name":"Southwest Minzu University, Chengdu, China"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/jceim.org\/index.php\/ojs\/article\/download\/245\/241","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jceim.org\/index.php\/ojs\/article\/download\/245\/241","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.54097\/04jw9933","published":{"date-parts":[[2026,9,29]]}}],"items-per-page":100,"query":{"start-index":0,"search-terms":null}}}