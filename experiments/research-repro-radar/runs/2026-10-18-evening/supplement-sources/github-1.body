":30,"stargazers_count":3,"watchers_count":3,"language":null,"has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":{"key":"gpl-3.0","name":"GNU General Public License v3.0","spdx_id":"GPL-3.0","url":"https://api.github.com/licenses/gpl-3.0","node_id":"MDc6TGljZW5zZTk="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":0,"watchers":3,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true},"score":1.0},{"id":292582224,"node_id":"MDEwOlJlcG9zaXRvcnkyOTI1ODIyMjQ=","name":"TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES","full_name":"kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES","private":false,"owner":{"login":"kavyakumaraguru","id":44930422,"node_id":"MDQ6VXNlcjQ0OTMwNDIy","avatar_url":"https://avatars.githubusercontent.com/u/44930422?v=4","gravatar_id":"","url":"https://api.github.com/users/kavyakumaraguru","html_url":"https://github.com/kavyakumaraguru","followers_url":"https://api.github.com/users/kavyakumaraguru/followers","following_url":"https://api.github.com/users/kavyakumaraguru/following{/other_user}","gists_url":"https://api.github.com/users/kavyakumaraguru/gists{/gist_id}","starred_url":"https://api.github.com/users/kavyakumaraguru/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kavyakumaraguru/subscriptions","organizations_url":"https://api.github.com/users/kavyakumaraguru/orgs","repos_url":"https://api.github.com/users/kavyakumaraguru/repos","events_url":"https://api.github.com/users/kavyakumaraguru/events{/privacy}","received_events_url":"https://api.github.com/users/kavyakumaraguru/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES","description":"The objective of text recognition is to recognize the text from printed hardcopy document to preferred format. recognizing a text is a very easiest job for humans, but in a machine or electric device that does text recognition is a challenging task. the major steps involved in text recognition is pre-processing, segmentation, feature extraction, classification. to attain high speed in data processing it is essential to convert the analog data into digital data. The process of Text Recognition involves several steps including preprocessing, segmentation, feature extraction, classification, post processing. Preprocessing is for done the basic operation on input image like binarization which convert gray Scale image into Binary Image, noise reduction which remove the noisy  nature from image. Segmentation stage for segment the given image into line by line and segment each character from segmented line. Future extraction calculates the characteristics of character. A classification contains the database and does the comparison. storage of hard copy of any document occupies large space and retrieving of information from that document is time consuming.  ","fork":false,"url":"https://api.github.com/repos/kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES","forks_url":"https://api.github.com/repos/kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES/forks","keys_url":"https://api.github.com/repos/kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES/keys{/key_id}","collaborators_url":"https://api.github.com/repos/kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECHNIQUES/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/kavyakumaraguru/TEXT-RECOGNITION-OCR-USING-DIGITAL-IMAGE-PROCESSING-TECH