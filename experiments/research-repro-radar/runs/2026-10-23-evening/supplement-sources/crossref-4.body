\/content\/pdf\/10.1007\/978-3-032-37362-5_8","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1007\/978-3-032-37592-6_19","title":["Improving Reasoning in\u00a0Vision-Language Models via\u00a0Perception Verified Self-training"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0008-1263-5368","authenticated-orcid":false,"given":"Sourabh","family":"Sharma","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0562-8887","authenticated-orcid":false,"given":"Sonam","family":"Gupta","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-3992-6153","authenticated-orcid":false,"family":"Sadbhawna","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37592-6_19","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,13]],"date-time":"2026-09-13T16:45:22Z","timestamp":1789317922000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-032-37592-6_19","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1007\/978-3-032-37520-9_15","title":["UltraViT: Latency-Optimized On-Device Vision Encoder for\u00a0Large Vision-Language Models"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0000-9588-6913","authenticated-orcid":false,"given":"Ioannis","family":"Maniadis Metaxas","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3185-4979","authenticated-orcid":false,"given":"Adrian","family":"Bulat","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5012-5800","authenticated-orcid":false,"given":"Alberto","family":"Baldrati","sequence":"additi