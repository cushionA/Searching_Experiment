"role":"author"}]},{"given":"Ilmira","family":"Jumaniyazova","sequence":"additional","affiliation":[{"name":"Mamun University","place":["Khiva, Uzbekistan"],"department":["Department of Pedagogy and Psychology"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/icnpcv69434.2026.11708963","published":{"date-parts":[[2026,7]]},"created":{"date-parts":[[2026,10,7]],"date-time":"2026-10-07T19:17:17Z","timestamp":1791400637000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11707819\/11708741\/11708963.pdf?arnumber=11708963","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/access.2026.3738005","title":["Clean Accuracy Is Not Enough: A Deployment-Aware Benchmark of Lightweight Vision Models for On-Edge Traffic-Incident Recognition"],"author":[{"given":"Ashik Shah","family":"Jahangeer","sequence":"first","affiliation":[{"name":"The Gandhigram Rural Institute (Deemed to be University)","place":["Dindigul, Tamil Nadu, India"],"department":["Department of Computer Science and Applications"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-2032-6115","authenticated-orcid":false,"given":"P.","family":"Shanmugavadivu","sequence":"additional","affiliation":[{"name":"The Gandhigram Rural Institute (Deemed to be University)","place":["Dindigul, Tamil Nadu, India"],"department":["Department of Computer Science and Applications"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/access.2026.3738005","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T19:06:39Z","timestamp":1790622399000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/6287639\/11323511\/11713433.pdf?arnumber=11713433","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/case69030.2026.11704196","title":["Action ControlNet: A Lightweight Delay-Aware Adapter for Smooth Asynchronous Control in Vision-Language-Action Models"],"author":[{"given":"Tiecheng","family":"Guo","sequence":"first","affiliation":[{"name":"School of Advanced Manufacturing and Robotics, Peking University","place":["Beijing, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Meng","family":"Guo","sequence":"additional","affiliation":[{"name":"School of Advanced Manufacturing and Robotics, Peking University","place":["Beijing, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/case69030.2026.11704196","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,6]],"date-time":"2026-10-06T19:06:43Z","timestamp":1791313603000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11703955\/11704113\/11704196.pdf?arnumber=11704196","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00676","title":["Object-Centric Vision Token Pruning for Vision Language Models"],"author":[{"given":"Guangyuan","family":"Li","sequence":"first","affiliation":[{"name":"Aalto University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Rongzhen","family":"Zhao","sequence":"additional","affiliation":[{"name":"Aalto University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jinhong","family":"Deng","sequence":"additional","affiliation":[{"name":"University of Electronic Science and Technology of China"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yanbo","family":"Wang","sequence":"additional","affiliation":[{"name":"Delft University of Technology"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Joni","family":"Pajarinen","sequence":"additional","affiliation":[{"name":"Aalto University"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00676","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:17:07Z","timestamp":1791487027000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698146.pdf?arnumber=11698146","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.23919\/aaicvcps00050.2026.00023","title":["A Lightweight Video Anomaly Detection Model for Smart Elderly Care Scenarios"],"author":[{"given":"Zhang","family":"Qian","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Cai","family":"Jingjing","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shi","family":"Lei","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.23919\/aaicvcps00050.2026.00023","published":{"date-parts":[[2026,3]]},"created":{"date-parts":[[2026,10,5]],"date-time":"2026-10-05T19:14:21Z","timestamp":1791227661000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11719634\/11719635\/11719795.pdf?arnumber=11719795","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Desktop operation of humanoid robot needs to coordinate the relationship between visual scene, language instruction, robot state and action execution. This paper focuses on the lightweight VLA model to enable the generalization and optimization of desktop jobs, and constructs multimodal input, model distillation, low-rank adaptation, quantization compression and lightweight action head processes. In method, RGB-D images, language commands, joint states, and end poses are used to form a unified input, and the inference burden is reduced by parameter compression. The experiments are based on 3200 groups of task data and verified in Python, PyTorch, ROS and Isaac Sim environments. The results show that the task success rate of the proposed method is 91.7%, the inference delay is 38 ms, the video memory occupation is 5.1 GB, and the generalization success rate of unseen objects is 82.6%, which can support real-time deployment and generalization execution of desktop jobs.<\/jats:p>","DOI":"10.1117\/12.3134706","created":{"date-parts":[[2026,10,19]],"date-time":"2026-10-19T18:11:58Z","timestamp":1792433518000},"title":["A lightweight VLA model empowers a generalized optimization approach for desktop tasks in humanoid robots"],"author":[{"given":"Yuxin","family":"Shou","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14516\/3134706\/A-lightweight-VLA-model-empowers-a-generalized-optimization-approach-for\/10.1117\/12.3134706.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3134706","published":{"date-parts":[[2026,10,19]]}},{"DOI":"10.3844\/jcssp.2026.2736.2754","title":["An Edge Efficient and Lightweight Hybrid CNN Vision Transformer Network With CBAM for IoT Based Plant Disease Detection"],"author":[{"given":"Nyabeye Pangop","family":"Doris-Kh\u00f6ler","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Kengni Ngangmo","family":"Olga","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.3844\/jcssp.2026.2736.2754","published":{"date-parts":[[2026,9,1]]},"created":{"date-parts":[[2026,9,23]],"date-time":"2026-09-23T12:45:15Z","timestamp":1790167515000}},{"DOI":"10.1007\/s11263-026-03031-7","title":["GoClick: Lightweight Element Grounding Model for Autonomous GUI Interaction"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-1445-7357","authenticated-orcid":false,"given":"Hongxin","family":"Li","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuntao","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-2648-3875","authenticated-orcid":false,"given":"Zhaoxiang","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/s11263-026-03031-7","published":{"date-parts":[[2026,10,18]]},"created":{"date-parts":[[2026,10,18]],"date-time":"2026-10-18T12:14:38Z","timestamp":1792325678000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s11263-026-03031-7.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/article\/10.1007\/s11263-026-03031-7","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/s11263-026-03031-7.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.54254\/2755-2721\/2026.36907","title":["Lightweight Vision Models for Galaxy Morphology Classification: A Comparative Study of ResNet, MobileNet, EfficientNet, and MobileViT on Galaxy10 DECaLS"],"author":[{"given":"Xiangyu","family":"Liao","sequence":"first","affiliation":[{"name":"Sorbonne Universit\u00e9"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Automated galaxy morphology classification now rests on parameter-heavy convolutional backbones, whose cost becomes a design constraint as survey volumes grow. This paper compares three lightweight architectures (MobileNetV2, EfficientNetB0, and MobileViT-Extra Small (XS)) against a ResNet50 baseline on the Galaxy10 Dark Energy Camera Legacy Survey (DECaLS) benchmark of 17,736 images in ten classes, holding data splits, augmentation, optimizer, loss, and stopping rule fixed so that the backbone is the only variable. The lightweight models give up between 2.07 and 2.55 percentage points of support-weighted accuracy while removing 82.9% to 91.8% of the parameters and 42% to 59% of the per-image inference latency, which makes them 5.7 to 11.8 times more efficient per parameter. Two results run against expectations. The hardest class is not the rarest one. In a redshift-stratified comparison, the only attention-based backbone falls furthest behind the baseline on exactly the smallest and faintest galaxies, so the advantage reported for Vision Transformers does not carry over to a lightweight hybrid. For survey-scale processing, the trade is worth making; for a catalogue of a few thousand galaxies, it is not.<\/jats:p>","URL":"https:\/\/doi.org\/10.54254\/2755-2721\/2026.36907","published":{"date-parts":[[2026,9,15]]},"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T07:11:31Z","timestamp":1789456291000}},{"DOI":"10.1007\/978-3-032-37369-4_18","title":["DiffusionVL: Translating Any Autoregressive Models into Diffusion Vision Language Models"],"author":[{"given":"Lunbin","family":"Zeng","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jingfeng","family":"Yao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Bencheng","family":"Liao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hongyuan","family":"Tao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Wenyu","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xinggang","family":"Wang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37369-4_18","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,9]],"date-time":"2026-09-09T05:46:39Z","timestamp":1788932799000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-032-37369-4_18","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1016\/j.cviu.2026.104966","title":["Copyright-aware adversarial perturbation for preventing unauthorized image generation in diffusion models"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0003-1781-764X","authenticated-orcid":false,"given":"Yunyu","family":"Kang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Minghuang","family":"Shen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Liqiang","family":"Lin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3621-9528","authenticated-orcid":false,"given":"Shyan-Ming","family":"Yuan","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0000-3427-9255","authenticated-orcid":false,"given":"Xiaolong","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1016\/j.cviu.2026.104966","published":{"date-parts":[[2026,11]]},"created":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T15:58:39Z","timestamp":1790611119000},"link":[{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1077314226003334?httpAccept=text\/xml","content-type":"text\/xml","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/api.elsevier.com\/content\/article\/PII:S1077314226003334?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}]},{"DOI":"10.1109\/cvprf71909.2026.00071","title":["Phantasia: Context-Adaptive Backdoors in Vision Language Models"],"author":[{"given":"Nam Duong","family":"Tran","sequence":"first","affiliation":[{"name":"Institute for AI Innovation and Societal Impact, Hanoi University of Science and Technology"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Phi","family":"Le Nguyen","sequence":"additional","affiliation":[{"name":"Institute for AI Innovation and Societal Impact, Hanoi University of Science and Technology"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00071","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:29:10Z","timestamp":1791487750000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697937.pdf?arnumber=11697937","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Glaucoma is one of the major causes of permanent blindness in the world, and since the progressive nature of the disease leads to considerable damage of the optic nerve before diagnosis, there is a need to develop precise and effective automated screening tools. This paper suggests the implementation of a lightweight vision transformer network for glaucoma screening based on the DeiT-Small architecture. The images were downsized to 224 \u00d7 224 resolution and transformed into patches. Four transformer blocks were frozen while the other blocks were fine-tuned via layer-wise learning-rate decay (LLRD) along with data augmentation and Test-Time Augmentation (TTA). Testing was performed on a balanced dataset with 9,540 images: 8,000 for training, 770 for validation and 770 for testing. In the independent test dataset, the model achieved 91.65% accuracy, 91.55% F1-score, 91.56% sensitivity, 95.06% specificity, and 95.84% AUC-ROC. Test-time augmentation was applied to enhance the reliability of predictions without re-<\/jats:p>","DOI":"10.61710\/pxx89244","created":{"date-parts":[[2026,9,23]],"date-time":"2026-09-23T21:59:09Z","timestamp":1790200749000},"title":["Efficient Glaucoma Detection from Retinal Fundus Images Using a Lightweight DeiT-Small Vision Transformer and Test-Time Augmentation"],"author":[{"suffix":"Jahefer","given":"Mothefer","family":"Majeed","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/jkceas.iku.edu.iq\/index.php\/JACEAS\/en\/dashboard\/editorial?currentViewId=active&workflowSubmissionId=244&workflowMenuKey=workflow_5","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.61710\/pxx89244","published":{"date-parts":[[2026,9,30]]}},{"DOI":"10.1109\/aris70457.2026.11734394","title":["MirrorConv: A Parameter-Shared Staggered Topology Operator for Extreme Lightweight Vision Models and its Empirical Robustness Analysis"],"author":[{"given":"Jia-Shing","family":"Shih","sequence":"first","affiliation":[{"name":"Southern Taiwan University of Science and Technology","place":["Tainan, Taiwan"],"department":["Department of Electrical Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Chi-Hsun","family":"Chang","sequence":"additional","affiliation":[{"name":"Southern Taiwan University of Science and Technology","place":["Tainan, Taiwan"],"department":["Department of Electrical Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/aris70457.2026.11734394","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,20]],"date-time":"2026-10-20T19:18:29Z","timestamp":1792523909000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11734275\/11734297\/11734394.pdf?arnumber=11734394","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.21474\/jncs01\/149","title":["COMPUTER VISION FOR INTELLIGENT OBJECT DETECTION: MODELS, APPLICATIONS, AND CHALLENGES"],"author":[{"given":"Ayaan","family":"Malik","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Khan","family":"Ishrat","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Computer vision is an important field of artificial intelligence that enables computer systems to interpret and analyse visual information from images and videos. Among its major tasks, intelligent object detection focuses on identifying objects, assigning class labels, and determining their locations within a visual scene. Recent advances in deep learning have substantially improved object-detection capabilities, particularly through convolutional neural networks (CNNs), single-stage detectors, region-based detection frameworks, and transformer-based architectures. Models such as Faster R-CNN, Single Shot MultiBox Detector (SSD), You Only Look Once (YOLO), and Detection Transformer (DETR) represent different approaches to balancing detection accuracy, computational efficiency, and model complexity. These techniques support applications in autonomous transportation, healthcare, agriculture, industrial inspection, surveillance, robotics, and smart-city infrastructure. Nevertheless, object detection remains challenging because of variations in lighting, object scale, occlusion, background complexity, limited labelled data, computational constraints, and potential bias in training datasets. This paper reviews the fundamental principles of intelligent object detection, discusses major model architectures and their applications, and examines the technical and ethical challenges associated with real-world deployment. It also identifies research directions involving efficient models, improved small-object detection, domain adaptation, explainability, privacy protection, and responsible artificial intelligence. The review concludes that effective object-detection systems must balance accuracy, speed, reliability, resource consumption, and responsible use according to the requirements of the intended application.<\/jats:p>","URL":"https:\/\/doi.org\/10.21474\/jncs01\/149","published":{"date-parts":[[2026,8,31]]},"created":{"date-parts":[[2026,10,20]],"date-time":"2026-10-20T09:49:43Z","timestamp":1792489783000}},{"DOI":"10.1109\/cvprf71909.2026.00235","title":["HAMSA: Scanning-Free Vision State Space Models via SpectralPulseNet"],"author":[{"given":"Badri N.","family":"Patro","sequence":"first","affiliation":[{"name":"Microsoft"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Vijay S.","family":"Agneeswaran","sequence":"additional","affiliation":[{"name":"Microsoft"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00235","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:23:16Z","timestamp":1791487396000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698530.pdf?arnumber=11698530","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00534","title":["When Models Learn to Ask Why: Adaptive Causal Reasoning for Trustworthy Medical Vision-Language Models"],"author":[{"given":"Jianxin","family":"Lin","sequence":"first","affiliation":[{"name":"The Ohio State University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Chunzheng","family":"Zhu","sequence":"additional","affiliation":[{"name":"Hunan University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Peter J.","family":"Kneuertz","sequence":"additional","affiliation":[{"name":"The Ohio State University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yunfei","family":"Bai","sequence":"additional","affiliation":[{"name":"Amazon"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuan","family":"Xue","sequence":"additional","affiliation":[{"name":"The Ohio State University"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00534","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:17:19Z","timestamp":1791487039000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697696.pdf?arnumber=11697696","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00181","title":["Shape and Texture Recognition in Large Vision-Language Models"],"author":[{"given":"Sagi","family":"Eppel","sequence":"first","affiliation":[{"name":"Weizmann Institute"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mor","family":"Bismut","sequence":"additional","affiliation":[{"name":"Open University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Alona","family":"Strugatski","sequence":"additional","affiliation":[{"name":"Weizmann Institute"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00181","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:23:17Z","timestamp":1791487397000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698240.pdf?arnumber=11698240","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/iccvdm71812.2026.11709113","title":["A Lightweight FPGA-Based Hardware for Infrared Small-Target Real-Time Detection Using CNN"],"author":[{"given":"Sergey V.","family":"Karamov","sequence":"first","affiliation":[{"name":"Novus Converged Aerospace Ltd","place":["London, United Kingdom"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Maksim O.","family":"Zhegulin","sequence":"additional","affiliation":[{"name":"Novus Converged Aerospace Ltd","place":["London, United Kingdom"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/iccvdm71812.2026.11709113","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,1]],"date-time":"2026-10-01T19:08:23Z","timestamp":1790881703000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11709023\/11709058\/11709113.pdf?arnumber=11709113","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Cataracts, Diabetic Retinopathy, and Glaucoma are the leading causes of vision loss worldwide. Traditionally, these diseases are diagnosed by experienced ophthalmologists who manually inspect the retinal images. Although effective, this approach faces some challenges. In fact, it can be time-consuming and, in some countries with low doctor-patient ratios, patients cannot access the necessary care. To solve this problem, researchers around the world are working on computer-aided diagnosis systems to assist healthcare professionals. In this study, the NASNetMobile architecture is leveraged to classify four eye conditions: Cataract, Diabetic Retinopathy, Glaucoma, and Normal. The proposed model was trained on the EDC dataset, containing 4 classes and 4217 images. Performance metrics used include accuracy, recall, f1-score and area under the curve (AUC). The experimental results were compared against published existing work and showed superior results.<\/jats:p>","DOI":"10.5565\/rev\/elcvia.2233","created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T13:10:24Z","timestamp":1789477824000},"title":["A  Lightweight Deep Neural Network for Multi-label Eye Diseases Classification"],"author":[{"given":"Nzanzu","family":"Romeo","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Megha","family":"Chhabra","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Saumya","family":"Chaturvedi","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/elcvia.cvc.uab.cat\/article\/download\/2233\/679","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/elcvia.cvc.uab.cat\/article\/download\/2233\/679","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.5565\/rev\/elcvia.2233","published":{"date-parts":[[2026,9,15]]}},{"abstract":"<jats:p>Aiming at the problems of large parameters and high computational complexity in deep learning-based image super-resolution networks, this paper proposes a lightweight super-resolution network that fuses multi-attention mechanism and Blueprint Separable Convolution (BSConv). BSConv is introduced to improve performance while reducing parameters. A Window-Shifted Spatial Self-Attention Module (WSSM) and a Blueprint Separable Channel-self-attention Module (BSCM) are designed to extract local features. A Coordinate Attention Module (CAM) is combined to capture global information. Extensive experiments on Set5, Set14, B100, and Urban100 datasets for \u00d72\/\u00d73\/\u00d74 reconstruction show that compared with the lightweight NGswin model, the proposed method improves PSNR by 0.09 dB on Set5 for \u00d72 reconstruction and reduces parameters by 453K, which can recover image textures and details more efficiently.<\/jats:p>","DOI":"10.1117\/12.3129285","created":{"date-parts":[[2026,9,25]],"date-time":"2026-09-25T15:23:41Z","timestamp":1790349821000},"title":["Lightweight image super-resolution network fusing multi-attention mechanism and blueprint separable convolution"],"author":[{"given":"Yiyan","family":"Huang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Lin","family":"Guo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14357\/3129285\/Lightweight-image-super-resolution-network-fusing-multi-attention-mechanism-and\/10.1117\/12.3129285.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3129285","published":{"date-parts":[[2026,9,25]]}},{"DOI":"10.1109\/cvprf71909.2026.00643","title":["SA-Matching DETR: A Lightweight Transformer Detector with Enhanced Scale Adaptive Matching"],"author":[{"given":"Chengshan","family":"Yang","sequence":"first","affiliation":[{"name":"Harbin Institute of Technology"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Pengnian","family":"Zhang","sequence":"additional","affiliation":[{"name":"Dalian University of Technology"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jinjing","family":"Zhao","sequence":"additional","affiliation":[{"name":"The University of Sydney"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00643","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:17:34Z","timestamp":1791487054000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697623.pdf?arnumber=11697623","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00483","title":["FALCON: Fast Adaptive Lightweight Computation of Intensities and Events for Depth Estimation"],"author":[{"given":"Sankarshana","family":"Venugopal","sequence":"first","affiliation":[{"name":"Seoul National University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Mohammad","family":"Mostafavi","sequence":"additional","affiliation":[{"name":"Seoul National University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jonghyun","family":"Choi","sequence":"additional","affiliation":[{"name":"Seoul National University"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00483","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:37:28Z","timestamp":1791488248000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697928.pdf?arnumber=11697928","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cisat71030.2026.11682442","title":["Enhancing Lightweight Models for Edge-Device Mineral Classification through Multi-Strategy Knowledge Distillation"],"author":[{"given":"Yi","family":"Zhang","sequence":"first","affiliation":[{"name":"Xi'an Jiaotong University","place":["Xi'an, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cisat71030.2026.11682442","published":{"date-parts":[[2026,7]]},"created":{"date-parts":[[2026,9,10]],"date-time":"2026-09-10T19:06:31Z","timestamp":1789067191000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11682029\/11682043\/11682442.pdf?arnumber=11682442","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>To address the issues of severe parameter redundancy and high computational overhead in current weather intensity recognition algorithms, which make them difficult to deploy in real-time on edge devices, this paper proposes ACE-MV3Small, a lightweight multi-task network. Using MobileNetV3-Small as the backbone, the model decouples at the ninth inverted residual block to collaboratively model sky state bias index regression and rainfall intensity classification tasks. Coordinate Attention and Efficient Channel Attention are introduced to enhance spatial awareness and texture discrimination performance, respectively. Experimental results show that the model achieves an accuracy of 94.4% on the weather condition intensity dataset; the parameter count is only 1.83M, and the computational complexity is reduced by approximately 112 times compared to CMWRN. This scheme provides an efficient technical path for real-time meteorological recognition at the edge.<\/jats:p>","DOI":"10.1117\/12.3125792","created":{"date-parts":[[2026,10,6]],"date-time":"2026-10-06T16:56:56Z","timestamp":1791305816000},"title":["Improved MobileNetV3-based lightweight multitask network for weather intensity recognition on edge devices"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0008-3139-8601","authenticated-orcid":false,"given":"Yukang","family":"Deng","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xiangsheng","family":"Feng","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14353\/3125792\/Improved-MobileNetV3-based-lightweight-multitask-network-for-weather-intensity-recognition\/10.1117\/12.3125792.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3125792","published":{"date-parts":[[2026,10,6]]}},{"DOI":"10.1109\/cvprf71909.2026.00869","title":["VEGAS: Mitigating Hallucinations in Large Vision-Language Models Via Vision-Encoder Attention Guided Adaptive Steering"],"author":[{"given":"Zihu","family":"Wang","sequence":"first","affiliation":[{"name":"University of California","place":["Santa Barbara, CA, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Boxun","family":"Xu","sequence":"additional","affiliation":[{"name":"University of California","place":["Santa Barbara, CA, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuxuan","family":"Xia","sequence":"additional","affiliation":[{"name":"University of California","place":["Santa Barbara, CA, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Peng","family":"Li","sequence":"additional","affiliation":[{"name":"University of California","place":["Santa Barbara, CA, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00869","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:23:42Z","timestamp":1791487422000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697644.pdf?arnumber=11697644","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1007\/978-3-032-37271-0_2","title":["Understanding the\u00a0Impact of\u00a0Geometric Foundation Models on\u00a0Vision-Language-Action Models"],"author":[{"given":"Yurou","family":"Yang","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Muyuan","family":"Lin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Roberto","family":"Martin-Martin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Martin","family":"Labrie","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shreekant","family":"Gayaka","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Cheng-Hao","family":"Kuo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Luca","family":"Carlone","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37271-0_2","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,10]],"date-time":"2026-09-10T10:44:07Z","timestamp":1789037047000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-032-37271-0_2","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/iccvdm71812.2026.11709369","title":["AgriFill: A Lightweight GAN-Based Image Inpainting Framework for Dynamic Object Removal in Agricultural Environments"],"author":[{"given":"Calvin","family":"John","sequence":"first","affiliation":[{"name":"University of East Anglia","place":["Norwich, UK"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sean","family":"Chow","sequence":"additional","affiliation":[{"name":"University of East Anglia","place":["Norwich, UK"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yingliang","family":"Ma","sequence":"additional","affiliation":[{"name":"University of East Anglia","place":["Norwich, UK"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/iccvdm71812.2026.11709369","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,1]],"date-time":"2026-10-01T19:21:11Z","timestamp":1790882471000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11709023\/11709058\/11709369.pdf?arnumber=11709369","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00337","title":["BitTP: The Lightweight Trajectory Prediction Model with BitLLM for Edge-Devices"],"author":[{"given":"Mincheol","family":"Kang","sequence":"first","affiliation":[{"name":"KAIST"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hyunjin","family":"Lim","sequence":"additional","affiliation":[{"name":"DGIST"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Bomin","family":"Kang","sequence":"additional","affiliation":[{"name":"DGIST"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Daehee","family":"Park","sequence":"additional","affiliation":[{"name":"DGIST"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00337","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:21:08Z","timestamp":1791487268000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698345.pdf?arnumber=11698345","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/iccvdm71812.2026.11709269","title":["A Lightweight Model for Real-time Detection of Small Objects in UAV Aerial Imagery on Embedded Platforms"],"author":[{"given":"Shihao","family":"Zhang","sequence":"first","affiliation":[{"name":"University of South China","place":["Hengyang, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yaping","family":"Wan","sequence":"additional","affiliation":[{"name":"University of South China","place":["Hengyang, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/iccvdm71812.2026.11709269","published":{"date-parts":[[2026,8]]},"created":{"date-parts":[[2026,10,1]],"date-time":"2026-10-01T19:18:30Z","timestamp":1790882310000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11709023\/11709058\/11709269.pdf?arnumber=11709269","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00700","title":["Gazemo: Mimicking Human Saccades via Foveal-Peripheral Feature Modeling for Lightweight Semantic Segmentation"],"author":[{"given":"Mian Muhammad Naeem","family":"Abid","sequence":"first","affiliation":[{"name":"University of W\u00fcrzburg"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Radu","family":"Timofte","sequence":"additional","affiliation":[{"name":"University of W\u00fcrzburg"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00700","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:26:04Z","timestamp":1791487564000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698231.pdf?arnumber=11698231","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Street scene text detection is challenging because urban text is often small, blurred, occluded, arbitrarily oriented and embedded in complex backgrounds. This paper proposes a lightweight Text-Aware Attention Fusion (TALAF) module for DBNet-style detection. TALAF is inserted after feature-pyramid fusion and introduces horizontal and vertical depthwise context filters between channel recalibration and spatial reweighting. On ICDAR2015, TALAF improves a DB-MobileNetV3 baseline from 0.5166 to 0.5676 Hmean under the default evaluation setting, while a post-processing sensitivity analysis reaches 0.5720 Hmean. In this PaddleOCR-based implementation, TALAF outperforms ECA, SE, CBAM and Coordinate Attention under the same lightweight setting, with moderate overhead. The results indicate that directional text-context modeling can improve compact scene text detectors.<\/jats:p>","DOI":"10.1117\/12.3127865","created":{"date-parts":[[2026,9,25]],"date-time":"2026-09-25T15:23:47Z","timestamp":1790349827000},"title":["A lightweight text-aware attention fusion module for street scene text detection in complex urban environments"],"author":[{"given":"Jinghui","family":"Ma","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14357\/3127865\/A-lightweight-text-aware-attention-fusion-module-for-street-scene\/10.1117\/12.3127865.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3127865","published":{"date-parts":[[2026,9,25]]}},{"DOI":"10.1109\/cvprf71909.2026.00264","title":["Rethinking Compact (&lt;1M) Vision Models: Balancing Accuracy and Speed Through Multi-Path Atrous Convolutions"],"author":[{"given":"Christos","family":"Kyrkou","sequence":"first","affiliation":[{"name":"University of Cyprus","place":["Nicosia, Cyprus"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00264","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:18:13Z","timestamp":1791487093000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698488.pdf?arnumber=11698488","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00865","title":["ProGAL-VLA: Grounded Alignment through Prospective Reasoning in Vision-Language-Action Models"],"author":[{"given":"Nastaran","family":"Darabi","sequence":"first","affiliation":[{"name":"University of Illinois","place":["Chicago, IL, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Amit Ranjan","family":"Trivedi","sequence":"additional","affiliation":[{"name":"University of Illinois","place":["Chicago, IL, USA"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00865","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:26:49Z","timestamp":1791487609000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697635.pdf?arnumber=11697635","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1007\/978-3-032-37624-4_26","title":["CUST: Clustered Unit-Level Similarity Transformer for\u00a0Lightweight Image Super-Resolution"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0009-9864-9601","authenticated-orcid":false,"given":"Jeongsoo","family":"Kim","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37624-4_26","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,16]],"date-time":"2026-09-16T05:46:42Z","timestamp":1789537602000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-032-37624-4_26","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00557","title":["Parallel In-Context Learning for Large Vision Language Models"],"author":[{"given":"Shin'ya","family":"Yamaguchi","sequence":"first","affiliation":[{"name":"NTT"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Daiki","family":"Chijiwa","sequence":"additional","affiliation":[{"name":"NTT"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tamao","family":"Sakao","sequence":"additional","affiliation":[{"name":"NTT"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Taku","family":"Hasegawa","sequence":"additional","affiliation":[{"name":"NTT"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00557","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:22:09Z","timestamp":1791487329000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11697700.pdf?arnumber=11697700","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.2139\/ssrn.7611536","title":["Frequency-Aware Masked Vision Distillation for Training Lightweight Vision Transformers"],"author":[{"given":"Zhanao","family":"Xue","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Rong","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sihai","family":"Qiao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shifei","family":"Chen","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yi","family":"Zhao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Fushen","family":"Xie","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"abstract":"<jats:p>Masked Image Modeling has emerged as a dominant pre-training paradigm for Vision Transformers. However, its success has not naturally cascaded to lightweight architectures, where standard methods such as the Masked Autoencoder (MAE) suffer from severe training inefficiency and notable performance degradation. In this paper, we systematically analyze this limitation and identify two fundamental causes: a pronounced frequency distribution mismatch in pre-trained representations and a critical optimization imbalance between reconstruction and distillation objectives. To address these issues, we propose Masked Vision Distillation (MViD), a streamlined framework specifically tailored for efficient pre-training of lightweight Vision Transformers. MViD introduces a frequency\u2013spatial dual-path mechanism consisting of an Adaptive Feature Projector (AFP) for dynamic teacher\u2013student feature alignment and a novel Frequency\u2013Spatial Distillation (FSD) module. By leveraging the Discrete Cosine Transform to explicitly suppress dominant low-frequency components in teacher features, FSD encourages the student model to focus on learning fine-grained high-frequency structural representations that are essential for visual understanding. Extensive experiments validate the effectiveness of the proposed approach: MViD-Ti achieves 75.8% Top-1 accuracy on ImageNet-1K with only 100 pre-training epochs. Compared with the MAE baseline (71.6% at 1600 epochs), our method delivers substantial performance gains while reducing the number of pre-training epochs from 1600 to 100, demonstrating a new level of efficiency for visual representation learning in lightweight models.<\/jats:p>","URL":"https:\/\/doi.org\/10.2139\/ssrn.7611536","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,14]],"date-time":"2026-10-14T16:53:01Z","timestamp":1791996781000}},{"DOI":"10.1109\/cvprf71909.2026.00558","title":["Vision-R1: Evolving Human-Free Alignment in Large Vision-Language Models via Vision-Guided Reinforcement Learning"],"author":[{"given":"Yufei","family":"Zhan","sequence":"first","affiliation":[{"name":"Foundation Model Research Center, Institute of Automation, Chinese Academy of Sciences"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yousong","family":"Zhu","sequence":"additional","affiliation":[{"name":"School of Artificial Intelligence, China University of Mining and Technology","place":["Beijing, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hongyin","family":"Zhao","sequence":"additional","affiliation":[{"name":"Foundation Model Research Center, Institute of Automation, Chinese Academy of Sciences"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Fan","family":"Yang","sequence":"additional","affiliation":[{"name":"Foundation Model Research Center, Institute of Automation, Chinese Academy of Sciences"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Shurong","family":"Zheng","sequence":"additional","affiliation":[{"name":"Foundation Model Research Center, Institute of Automation, Chinese Academy of Sciences"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Ming","family":"Tang","sequence":"additional","affiliation":[{"name":"Foundation Model Research Center, Institute of Automation, Chinese Academy of Sciences"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jinqiao","family":"Wang","sequence":"additional","affiliation":[{"name":"Foundation Model Research Center, Institute of Automation, Chinese Academy of Sciences"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00558","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:38:40Z","timestamp":1791488320000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698298.pdf?arnumber=11698298","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00114","title":["PEARL: A Lightweight Prompt-Based Feature Interpreter Framework for Real-Time, Anonymous, and Heterogeneous Collaborative Perception"],"author":[{"given":"Armin","family":"Maleki","sequence":"first","affiliation":[{"name":"Michigan State University","department":["Department of Electrical and Computer Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Hayder","family":"Radha","sequence":"additional","affiliation":[{"name":"Michigan State University","department":["Department of Electrical and Computer Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00114","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:27:15Z","timestamp":1791487635000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698508.pdf?arnumber=11698508","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Small-object detection in UAV aerial images is difficult for two practical reasons: the targets are small, dense, and easily blended into complex backgrounds, and the detector still has to run with limited computation at the edge. We propose SOP-DETR, a lightweight end-to-end detector built on RT-DETR-R18. The model uses a Dynamic Multi-Scale Context Mixing Module (DMSCM) to improve weak-texture representation, a Small-Object Enhanced Feature Pyramid (SIP-OmniFPN) to inject P2 details into P3 fusion through SPDConv and CSPOmniKernel, and a Multi-scale Cross-scale Feature Modulation Module (MCFM) to replace fixed concatenation with adaptive feature selection. On VisDrone2019, SOP-DETR reaches 38.8% mAP@0.5, 22.1% mAP@0.5:0.95, and 13.8% APs, which is 3.7, 2.1, and 2.7 percentage points higher than RT-DETR-R18. It also reduces parameters from 19.9M to 14.8M and GFLOPs from 57.0 to 53.1. On TinyPerson, SOP-DETR obtains 22.5%, 7.9%, and 6.3% on the same metrics, improving the baseline by 2.2, 3.9, and 1.3 percentage points. Ablation studies and visual results show that the three modules improve small-object representation while keeping a practical balance between accuracy and efficiency.<\/jats:p>","DOI":"10.1117\/12.3125950","created":{"date-parts":[[2026,10,6]],"date-time":"2026-10-06T16:57:06Z","timestamp":1791305826000},"title":["SOP-DETR: a lightweight end-to-end detection model for small object detection in UAV aerial images"],"author":[{"given":"Jiawei","family":"Dong","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.spiedigitallibrary.org\/conference-proceedings-of-spie\/14353\/3125950\/SOP-DETR--a-lightweight-end-to-end-detection-model\/10.1117\/12.3125950.full","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.1117\/12.3125950","published":{"date-parts":[[2026,10,6]]}},{"DOI":"10.1109\/cvprf71909.2026.00305","title":["Plug-and-Think: Structured Reasoning for Vision-Language-Action Models"],"author":[{"given":"Kaikai","family":"Wei","sequence":"first","affiliation":[{"name":"Hangzhou International Innovation Institute of Beihang University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Di","family":"Wen","sequence":"additional","affiliation":[{"name":"Beijing Jiaotong University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xinhai","family":"Li","sequence":"additional","affiliation":[{"name":"Hangzhou International Innovation Institute of Beihang University"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Senwei","family":"Xiang","sequence":"additional","affiliation":[{"name":"Hangzhou International Innovation Institute of Beihang University"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00305","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:25:04Z","timestamp":1791487504000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698031.pdf?arnumber=11698031","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1109\/cvprf71909.2026.00678","title":["BiomedHELIX: HiErarchical-Local Interaction eXploration for Biomedical Vision-Language Models"],"author":[{"given":"Ziheng","family":"Zhu","sequence":"first","affiliation":[{"name":"College of Future Information Technology, Fudan University","place":["Shanghai, China"],"department":["Department of Electronic Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yuncheng","family":"Guo","sequence":"additional","affiliation":[{"name":"College of Future Information Technology, Fudan University","place":["Shanghai, China"],"department":["Department of Electronic Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jie","family":"Xu","sequence":"additional","affiliation":[{"name":"College of Biomedical Engineering, Fudan University","place":["Shanghai, China"]}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xiaodong","family":"Gu","sequence":"additional","affiliation":[{"name":"College of Future Information Technology, Fudan University","place":["Shanghai, China"],"department":["Department of Electronic Engineering"]}],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1109\/cvprf71909.2026.00678","published":{"date-parts":[[2026,6]]},"created":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T19:17:14Z","timestamp":1791487034000},"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx8\/11697600\/11697601\/11698083.pdf?arnumber=11698083","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"abstract":"<jats:p>Timely estrus detection determines reproductive efficiency in Hanwoo cattle, yet visual observation is increasingly difficult as herd sizes grow and standing behavior becomes less consistently expressed. Fixed farm cameras offer a non-invasive alternative, but mounting, chin-resting and sniffing involve two overlapping animals and occur rarely, complicating automated detection. This study evaluated how annotation strategy, augmentation policy and detector choice affect detection of these cues. A surveillance dataset of 846 red\u2013green\u2013blue (RGB) frames, containing 200 estrus-interaction instances against 2180 posture instances, was recorded at a commercial farm. Three annotation strategies, partial bounding-box label (PBL), full single bounding-box label (FSBL) and full dual bounding-box label (FDBL), were combined with three augmentation stages and three lightweight detectors (YOLOv5n, YOLOv8n, YOLO11n), giving 27 configurations. Rare-class performance varied approximately twice as widely as overall performance and depended more on annotation and augmentation than on detector family. PBL maximized sensitivity (recall 0.718), FSBL maximized localization quality (average precision, AP50 0.798) and overall accuracy (mean average precision, mAP50 0.864), and FDBL preserved relational context (recall 0.700, AP50 0.775). Annotation and augmentation should be selected according to whether the purpose is screening candidate interactions or supporting expert confirmation. Detections represent a behavioral proxy, not physiological confirmation of estrus.<\/jats:p>","DOI":"10.3390\/ani16193054","created":{"date-parts":[[2026,9,28]],"date-time":"2026-09-28T15:57:57Z","timestamp":1790611077000},"title":["Vision-Based Detection of Estrus-Related Interaction Behavior in Hanwoo Cattle Using Lightweight YOLO Models"],"author":[{"ORCID":"https:\/\/orcid.org\/0009-0009-5050-7284","authenticated-orcid":false,"given":"Usama","family":"Hanif","sequence":"first","affiliation":[{"name":"Department of Bio-Systems Engineering, Gyeongsang National University, Jinju 52828, Republic of Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-7481-9276","authenticated-orcid":false,"given":"Dae-Yeong","family":"Kang","sequence":"additional","affiliation":[{"name":"Department of Smart Farm, Gyeongsang National University, Jinju 52828, Republic of Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0000-8031-7240","authenticated-orcid":false,"given":"Mohammad","family":"Ismail","sequence":"additional","affiliation":[{"name":"Department of Bio-Systems Engineering, Gyeongsang National University, Jinju 52828, Republic of Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0003-0328-4934","authenticated-orcid":false,"given":"Pirlepesov Daniyar","family":"Maratovich","sequence":"additional","affiliation":[{"name":"Department of Smart Farm, Gyeongsang National University, Jinju 52828, Republic of Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0001-2771-7170","authenticated-orcid":false,"given":"Seong-hun","family":"Kim","sequence":"additional","affiliation":[{"name":"Department of Smart Farm, Gyeongsang National University, Jinju 52828, Republic of Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0788-1536","authenticated-orcid":false,"given":"Hyeon-Tae","family":"Kim","sequence":"additional","affiliation":[{"name":"Department of Bio-Industrial Machinery Engineering, Institute of Smart Space Agriculture (ISSA), Gyeongsang National University, Jinju 52828, Republic of Korea"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"link":[{"URL":"https:\/\/www.mdpi.com\/2076-2615\/16\/19\/3054\/pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"URL":"https:\/\/doi.org\/10.3390\/ani16193054","published":{"date-parts":[[2026,9,28]]}},{"DOI":"10.1007\/978-3-032-37086-0_27","title":["VISOR++ : Visual Input Based Steering for\u00a0Large Vision Language Models"],"author":[{"ORCID":"https:\/\/orcid.org\/0000-0001-8490-8486","authenticated-orcid":false,"given":"Ravi","family":"Balakrishnan","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-4682-6281","authenticated-orcid":false,"given":"Mansi","family":"Phute","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37086-0_27","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,10,4]],"date-time":"2026-10-04T15:18:46Z","timestamp":1791127126000},"link":[{"URL":"https:\/\/link.springer.com\/content\/pdf\/10.1007\/978-3-032-37086-0_27","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}]},{"DOI":"10.1007\/978-3-032-37271-0_10","title":["On Test-Time Scaling for\u00a0Vision-Language Models"],"author":[{"given":"Fawaz","family":"Sammani","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tzoulio","family":"Chamiti","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Nikos","family":"Deligiannis","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"URL":"https:\/\/doi.org\/10.1007\/978-3-032-37271-0_10","published":{"date-parts":[[2026]]},"created":{"date-parts":[[2026,9,10]],"date-tim