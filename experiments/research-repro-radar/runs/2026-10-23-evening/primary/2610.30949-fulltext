<td id="S3.T1.5.1.12.2" class="ltx_td ltx_align_right" style="padding:1pt 10.0pt;"><span id="S3.T1.5.1.12.2.1" class="ltx_text"></span><span id="S3.T1.5.1.12.2.2" class="ltx_text" style="font-size:90%;"> </span><span id="S3.T1.5.1.12.2.3" class="ltx_text" style="font-size:90%;">
<span id="S3.T1.5.1.12.2.3.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.5.1.12.2.3.1.1" class="ltx_tr">
