<span id="S3.T1.5.1.12.2.3.1.2" class="ltx_tr">
<span id="S3.T1.5.1.12.2.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1pt 10.0pt;"><math id="S3.T1.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> Recursive <math id="S3.T1.m14" class="ltx_Math" alttext="\times 8" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\times 8</annotation></semantics></math> (Inference)</span></span>
